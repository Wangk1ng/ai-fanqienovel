  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：毒体初现与修罗共生\",\n      \"chapterRange\": \"第1-20章\",\n      \"summary\": \"苏锦瑟穿越成毒体弃妃，被皇帝赐婚给修罗将军穆寒川，意图借刀杀人。大婚之夜，两人意外发现生理互补：男主体温压制女主毒性，女主血液安抚男主狂躁。两人从互相试探到达成共生契约，在将军府内斗智斗勇，初步站稳脚跟。\",\n      \"plotPoints\": [\"穿越赐婚\", \"生理互补发现\", \"将军府立威\", \"初次进宫交锋\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：瘟疫风云与蛊术显威\",\n      \"chapterRange\": \"第21-40章\",\n      \"summary\": \"京城突发诡异瘟疫，皇帝借机陷害苏锦瑟是祸源。苏锦瑟利用现代病毒学结合苗疆蛊术，不仅找出瘟疫真相，更以毒攻毒控制疫情。穆寒川在暗处配合镇压暴乱，两人名声大噪，感情在生死与共中升温。\",\n      \"plotPoints\": [\"瘟疫爆发\", \"查清真相\", \"以毒攻毒\", \"名声逆转\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：边关战火与身苗疆之谜\",\n      \"chapterRange\": \"第41-60章\",\n      \"summary\": \"皇帝忌惮两人势力，故意派穆寒川出征必死之地，苏锦瑟随行。途中遭遇苗疆旧部袭击，揭开苏锦瑟身世与“毒体”的真正秘密。在边关，苏锦瑟用蛊术破敌军毒阵，穆寒川修罗战力全开，两人联手大破敌军。\",\n      \"plotPoints\": [\"被迫出征\", \"苗疆身世\", \"破除毒阵\", \"边关大捷\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：朝堂博弈与绝地反击\",\n      \"chapterRange\": \"第61-80章\",\n      \"summary\": \"凯旋回京后，皇帝撕破脸，以谋反罪围困将军府。苏锦瑟利用早已布下的“蛊网”控制京城关键人物，穆寒川率亲卫杀出重围。两人揭露皇帝勾结敌国、残害忠良的罪证，引发朝堂震动，起兵清君侧。\",\n      \"plotPoints\": [\"皇帝逼宫\", \"蛊网发动\", \"揭露罪证\", \"起兵造反\"]\n    },\n    {\n      \"actNumber\": 5,\n      \"actName\": \"第五幕：天下归心与盛世长歌\",\n      \"chapterRange\": \"第81-100章\",\n      \"summary\": \"最终决战，穆寒川对决皇家禁军，苏锦瑟破解皇帝最后的生化毒计。推翻暴政后，两人拒绝称帝，扶持新君。苏锦瑟彻底净化毒体，穆寒川治愈狂躁症。两人携手归隐或共治天下，迎来圆满结局。\",\n      \"plotPoints\": [\"京城决战\", \"推翻暴政\", \"治愈顽疾\", \"盛世大结局\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"病毒学家变毒体弃妃\",\n      \"summary\": \"顶级病毒学家苏锦瑟在实验室爆炸后穿越，醒来发现自己是大燕王朝传闻中触之即死的毒体弃妃，正被皇帝赐婚给杀人如麻的修罗将军。\",\n      \"keyEvents\": [\"穿越苏醒\", \"得知赐婚\"],\n      \"characters\": [\"苏锦瑟\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"修罗将军的迎亲队\",\n      \"summary\": \"穆寒川的迎亲队伍充满煞气，全京城都在看笑话。苏锦瑟冷静分析身体状况，发现体内的剧毒似乎在某种条件下会自我抑制。\",\n      \"keyEvents\": [\"迎亲\", \"分析身体\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"大婚之夜的杀机\",\n      \"summary\": \"洞房花烛夜，穆寒川带着一身血气归来，本想杀了这个皇帝安插的“毒药”，却在触碰苏锦瑟肌肤时，发现体内的狂躁竟奇迹般平复。\",\n      \"keyEvents\": [\"洞房对峙\", \"狂躁平复\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"致命的体温\",\n      \"summary\": \"苏锦瑟毒发痛苦，穆寒川因不想失去“解药”而抱住她，意外发现他极高的体温能压制她体内的毒性。两人达成了临时的生理共生契约。\",\n      \"keyEvents\": [\"毒发\", \"体温压制毒性\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"将军府的刁难\",\n      \"summary\": \"次日清晨，将军府的下人因苏锦瑟是弃妃而轻慢，甚至送来馊饭。苏锦瑟不动声色，利用随身携带的简易材料制作了轻微致幻剂。\",\n      \"keyEvents\": [\"下人刁难\", \"制作致幻剂\"],\n      \"characters\": [\"苏锦瑟\", \"青黛\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"立威：以蛊服人\",\n      \"summary\": \"苏锦瑟在饭桌上施展手段，让欺辱她的下人当众出丑，甚至吐露真言。穆寒川冷眼旁观，对这位“毒妃”产生了兴趣。\",\n      \"keyEvents\": [\"惩戒下人\", \"穆寒川旁观\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\", \"青黛\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"回门宴的鸿门\",\n      \"summary\": \"皇帝设下回门宴，意图在宫中动手脚。穆寒川察觉杀意，警告苏锦瑟不要乱跑，苏锦瑟却表示要去看看这所谓的“皇权”。\",\n      \"keyEvents\": [\"回门宴\", \"穆寒川警告\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"御花园的试探\",\n      \"summary\": \"御花园中，贵妃故意挑衅，推苏锦瑟入水池。苏锦瑟落水后并未呼救，反而利用水中的微生物短暂麻痹了贵妃的侍卫。\",\n      \"keyEvents\": [\"贵妃挑衅\", \"落水反击\"],\n      \"characters\": [\"苏锦瑟\", \"萧贵妃\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"修罗的护短\",\n      \"summary\": \"穆寒川见苏锦瑟未归，大闹御花园将其抱出。面对皇帝的质问，他冷言回击，第一次在外人面前维护了苏锦瑟。\",\n      \"keyEvents\": [\"穆寒川寻人\", \"维护苏锦瑟\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"共生的秘密\",\n      \"summary\": \"回府途中，苏锦瑟因受寒毒发，穆寒川不得不再次与她亲密接触。两人深入交谈，确认了“体温压制毒性，血液安抚狂躁”的互补机制。\",\n      \"keyEvents\": [\"毒发\", \"确认机制\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"深夜的刺杀\",\n      \"summary\": \"皇帝派出的刺客夜袭将军府。苏锦瑟利用现代知识设置陷阱，穆寒川则大开杀戒，两人配合默契，全歼刺客。\",\n      \"keyEvents\": [\"刺客夜袭\", \"配合杀敌\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"血液的诱惑\",\n      \"summary\": \"战斗后穆寒川杀意难平，即将走火入魔。苏锦瑟划破手指，让他吸食微量血液。穆寒川瞬间冷静，眼神变得深邃而危险。\",\n      \"keyEvents\": [\"走火入魔\", \"血液安抚\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"建立信任\",\n      \"summary\": \"经过一夜的生死与共，两人决定结成正式同盟。苏锦瑟负责医治他的狂躁，他负责提供体温保护。苏锦瑟开始在府中建立简易实验室。\",\n      \"keyEvents\": [\"结盟\", \"建立实验室\"],\n      \"characters\": [ \"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"京城怪病初现\",\n      \"summary\": \"京城西市出现一种怪病，病人高烧不退且皮肤溃烂。太医束手无策，流言四起，说是天降神罚。\",\n      \"keyEvents\": [\"怪病爆发\", \"流言四起\"],\n      \"characters\": [\"苏锦瑟\", \"太医院院长\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"皇帝的污蔑\",\n      \"summary\": \"皇帝借机发难，声称苏锦瑟是“天降毒星”，带来了灾难，下令将她抓捕祭天。穆寒川当场抗旨，将苏锦瑟护在身后。\",\n      \"keyEvents\": [\"皇帝污蔑\", \"穆寒川抗旨\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"深入疫区\",\n      \"summary\": \"苏锦瑟主动请缨去疫区查探，条件是穆寒川护法。两人深入西市贫民窟，苏锦瑟采集样本，分析出这是一种变异的鼠疫。\",\n      \"keyEvents\": [\"请缨查探\", \"分析病毒\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"苗疆蛊术显威\",\n      \"summary\": \"常规药物无效，苏锦瑟放出驯化的“探病蛊”，寻找病源。同时利用银针和草药，结合现代抗病毒原理，研制出抑制剂。\",\n      \"keyEvents\": [\"探病蛊\", \"研制抑制剂\"],\n      \"characters\": [\"苏锦瑟\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"以毒攻毒\",\n      \"summary\": \"疫情失控，苏锦瑟大胆提出“以毒攻毒”，利用微量的另一种毒素来激发病人免疫力。穆寒川镇压因恐惧而暴动的民众。\",\n      \"keyEvents\": [\"以毒攻毒\", \"镇压暴动\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"第一例痊愈\",\n      \"summary\": \"在苏锦瑟的施针下，第一例重症病人奇迹般好转。民众从恐惧转为敬畏，称苏锦瑟为“活菩萨”。皇帝的脸被打得生疼。\",\n      \"keyEvents\": [\"病人好转\", \"名声逆转\"],\n      \"characters\": [\"苏锦瑟\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"瘟疫背后的黑手\",\n      \"summary\": \"苏锦瑟在病源处发现了一种特殊的蛊粉，这并非天灾，而是人为投放。线索指向了皇宫中的某位神秘术士。\",\n      \"keyEvents\": [\"发现蛊粉\", \"锁定人为\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"萧贵妃的恐慌\",\n      \"summary\": \"萧贵妃得知瘟疫被控制，且苏锦瑟发现了蛊粉，惊慌失措。她决定铤而走险，在庆功宴上对苏锦瑟下最后通牒。\",\n      \"keyEvents\": [\"萧贵妃恐慌\", \"庆功宴阴谋\"],\n      \"characters\": [\"萧贵妃\", \"神秘术士\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"庆功宴上的交锋\",\n      \"summary\": \"庆功宴上，苏锦瑟当众拿出证据，直指有人投放瘟疫。皇帝大怒，下令彻查。萧贵妃反咬一口，说证据是苏锦瑟伪造的。\",\n      \"keyEvents\": [\"当众对质\", \"反咬一口\"],\n      \"characters\": [\"苏锦瑟\", \"萧贵妃\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"蛊虫反噬\",\n      \"summary\": \"苏锦瑟早已在证据上动了手脚，一种特殊的气味蛊让神秘术士在紧张时发出恶臭。术士当众失禁，心理防线崩溃，供出萧贵妃。\",\n      \"keyEvents\": [\"气味蛊\", \"术士招供\"],\n      \"characters\": [\"苏锦瑟\", \"神秘术士\", \"萧贵妃\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"皇帝的权衡\",\n      \"summary\": \"证据确凿，但皇帝为了皇颜，只将萧贵妃禁足，并未重罚。苏锦瑟看透了皇帝的凉薄，更加坚定了与穆寒川共进退的决心。\",\n      \"keyEvents\": [\"从轻发落\", \"看清皇帝\"],\n      \"characters\": [\"苏锦瑟\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"苗疆来客\",\n      \"summary\": \"一位身着苗疆服饰的神秘女子潜入将军府，见到苏锦瑟后泪流满面，称她为“圣女”。苏锦瑟记忆深处闪过模糊画面。\",\n      \"keyEvents\": [\"苗疆女子\", \"圣女称呼\"],\n      \"characters\": [\"苏锦瑟\", \"苗疆女子(阿朵)\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"毒体的真相\",\n      \"summary\": \"阿朵道出真相：苏锦瑟并非原主，而是真正的苗疆圣女转世，她的血是解开“万毒之王”封印的钥匙，也是唯一能彻底净化世间剧毒的存在。\",\n      \"keyEvents\": [\"身世揭秘\", \"万毒之王\"],\n      \"characters\": [\"苏锦瑟\", \"阿朵\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"穆寒川的异样\",\n      \"summary\": \"穆寒川得知苏锦瑟身世后，担心她被苗疆势力带走，情绪变得焦躁。苏锦瑟察觉后，主动安抚，两人的感情迅速升温。\",\n      \"keyEvents\": [\"穆寒川焦躁\", \"感情升温\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"边疆急报\",\n      \"summary\": \"北方边境告急，敌国大举入侵，且使用了极其残忍的毒雾战术。边关守军死伤惨重，朝中无人敢挂帅。\",\n      \"keyEvents\": [\"边境告急\", \"毒雾战术\"],\n      \"characters\": [\"皇帝\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"必死的出征\",\n      \"summary\": \"皇帝心生毒计，任命穆寒川为帅，却不给一兵一粮，意图让他死在敌国毒雾之下。苏锦瑟看穿计谋，却鼓励穆寒川接下帅印，借机离京发展势力。\",\n      \"keyEvents\": [\"空帅印\", \"将计就计\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"招募私兵\",\n      \"summary\": \"穆寒川动用暗卫力量，苏锦瑟则变卖嫁妆筹集军资。两人招募了一批江湖游侠和被瘟疫治愈的壮丁，组成了一支特殊的“毒军”。\",\n      \"keyEvents\": [\"筹集军资\", \"招募毒军\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"离京前夕\",\n      \"summary\": \"离京前夜，苏锦瑟在京城各处水源布下预防蛊。穆寒川向死去的战友祭拜，发誓要清君侧，换一个朗朗乾坤。\",\n      \"keyEvents\": [\"布下预防蛊\", \"祭拜发誓\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"艰难的行军\",\n      \"summary\": \"大军开拔，路途艰辛。苏锦瑟虽是女子，但不输男儿，用医术救治伤兵，赢得了军心。穆寒川看着她的背影，目光温柔。\",\n      \"keyEvents\": [\"行军\", \"救治伤兵\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"抵达边关\",\n      \"summary\": \"抵达边关驻地，景象惨不忍睹。苏锦瑟立即投入工作，分析敌国毒雾成分。穆寒川整顿军纪，准备迎战。\",\n      \"keyEvents\": [\"抵达驻地\", \"分析毒雾\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"解毒药剂\",\n      \"summary\": \"苏锦瑟研制出抗毒雾的药剂，并给士兵们注射。穆寒川亲自试药，确认无副作用后全军分发。\",\n      \"keyEvents\": [\"研制药剂\", \"全军分发\"],\n      \"characters\": [\"苏锦瑟\", \"穆寒川\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"初次交锋\",\n      \"summary\": \"敌军再次放毒，以为燕军会溃败，没想到燕军戴着特制面罩冲入阵中。穆寒川修罗战力爆发，大败敌军先锋。\",\n      \""
