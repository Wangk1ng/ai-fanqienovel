  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：赛博废土的机械玫瑰\",\n      \"chapterRange\": \"第1-30章\",\n      \"summary\": \"苏清辞进入星际赛博朋克位面，伪装成柔弱难民，被拾荒者林渊救下。她利用林渊压制毁灭力量，诱导其对抗天机集团。系统试图激怒林渊杀她，苏清辞反手利用赵无极的追杀步步为营。最终在林渊彻底黑化后，她“惨死”于男主怀中，完成攻略并收割毁灭能量。\",\n      \"plotPoints\": [\"苏清辞绑定系统，进入下城区\", \"利用林渊压制毁灭力量\", \"林渊黑化，对抗天机集团\", \"苏清辞假死脱离世界\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：修真界的魔尊师尊\",\n      \"chapterRange\": \"第31-60章\",\n      \"summary\": \"苏清辞穿越至修真位面，成为名门正派“云剑宗”的伪善师尊。男主谢妄是被她亲手折断傲骨的弃徒，实则是拥有吞噬体质的毁灭容器。系统要求她“感化”实则送死，苏清辞却以恶女姿态调教男主，在正魔大战中揭开马甲，与黑化魔尊谢妄展开极限拉扯。\",\n      \"plotPoints\": [\"伪装清冷师尊，虐徒以激怒男主\", \"系统发布必死任务\", \"正魔大战，马甲掉落\", \"男主囚禁师尊，苏清辞反杀脱离\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：末世废土的圣女祭品\",\n      \"chapterRange\": \"第61-90章\",\n      \"summary\": \"末世降临，苏清辞化身身娇体软的治愈圣女，被疯批基地长霍烬囚禁。她表面顺从，实则暗中猎杀高阶丧尸，将毁灭力量渗透进丧尸王体内。系统诱导霍烬将她献祭给丧潮，苏清辞反手引爆丧尸王，在末世废土上建立新秩序，虐哭基地长。\",\n      \"plotPoints\": [\"被霍烬囚禁，扮演圣女\", \"暗中猎杀丧尸，寻找容器\", \"系统触发献祭剧情\", \"引爆毁灭力量，摧毁旧秩序\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：星际战神的终极归来\",\n      \"chapterRange\": \"第91-100章\",\n      \"summary\": \"苏清辞回归主世界，联邦通缉令铺天盖地。系统企图联合高维捕猎程序抹杀她，却发现她才是真正的“天灾”。曾经的黑化大佬们（林渊、谢妄、霍烬）在诸天注视下觉醒记忆。苏清辞撕碎系统，主宰星际，成为诸天唯一的神。\",\n      \"plotPoints\": [\"回归主世界，身份曝光\", \"系统启动抹杀程序\", \"诸天大佬觉醒记忆\", \"反杀系统，主宰诸天\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"联邦通缉犯与病娇系统\",\n      \"summary\": \"星际最高监狱中，苏清辞被强行绑定想借刀杀人的系统。系统发布任务：前往崩坏位面寻找容器，否则将被抹杀。\",\n      \"keyEvents\": [\"苏清辞被系统绑架\", \"接受第一个任务\"],\n      \"characters\": [\"苏清辞\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"下城区的拾荒者\",\n      \"summary\": \"苏清辞穿越至赛博朋克位面，伪装成受伤的柔弱难民，倒在垃圾场。拾荒者林渊路过，因善心救下她。\",\n      \"keyEvents\": [\"进入下城区\", \"遭遇林渊\"],\n      \"characters\": [\"苏清辞\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"黑诊所的老鬼\",\n      \"summary\": \"林渊带苏清辞找老鬼治疗。苏清辞暗中扫描林渊身体，发现他义肢下隐藏的高适配性，是完美的容器。\",\n      \"keyEvents\": [\"接触老鬼\", \"确认林渊是容器\"],\n      \"characters\": [\"苏清辞\", \"林渊\", \"老鬼\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"天机集团的执行官\",\n      \"summary\": \"天机集团执行官赵无极发现林渊踪迹，派出机械卫队扫荡下城区。苏清辞诱导林渊反击，试探他的战斗力。\",\n      \"keyEvents\": [\"赵无极登场\", \"下城区遭遇战\"],\n      \"characters\": [\"林渊\", \"赵无极\", \"苏清辞\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"名为保护的控制\",\n      \"summary\": \"战斗中，苏清辞假装柔弱依附林渊，实则通过接触将体内暴走的毁灭力量分流进林渊体内，缓解自身痛苦。\",\n      \"keyEvents\": [\"第一次力量分流\", \"建立依赖关系\"],\n      \"characters\": [\"苏清辞\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"信息贩子艾伦\",\n      \"summary\": \"林渊为打听妹妹林月下落，找信息贩子艾伦。艾伦贪婪，苏清辞暗中施压，迫使艾伦低价吐露情报。\",\n      \"keyEvents\": [\"接触艾伦\", \"获取林月情报\"],\n      \"characters\": [\"林渊\", \"苏清辞\", \"艾伦\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"地下黑拳场\",\n      \"summary\": \"为筹集赎金，林渊前往黑拳场参赛。苏清辞在台下观看，点评其战斗弱点，林渊对她言听计从。\",\n      \"keyEvents\": [\"黑拳场打斗\", \"林渊听从建议\"],\n      \"characters\": [\"林渊\", \"苏清辞\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"拳王凯的阻拦\",\n      \"summary\": \"常胜冠军凯受雇于赵无极，要在拳场废掉林渊。林渊陷入苦战，苏清辞暗中用异能干扰凯视线。\",\n      \"keyEvents\": [\"对战拳王凯\", \"苏清辞暗中出手\"],\n      \"characters\": [\"林渊\", \"凯\", \"苏清辞\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"义气与金钱\",\n      \"summary\": \"凯发现林渊是为了救妹妹，被其义气打动，故意输掉比赛。赵无极大怒，下令格杀勿论。\",\n      \"keyEvents\": [\"凯放水\", \"赵无极下达必杀令\"],\n      \"characters\": [\"凯\", \"林渊\", \"赵无极\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"系统发布的死亡Flag\",\n      \"summary\": \"系统发布任务：让林渊在绝望中杀死苏清辞。苏清辞冷笑，决定反向操作，先让林渊爱上她。\",\n      \"keyEvents\": [\"系统发布必死任务\", \"苏清辞制定反向攻略\"],\n      \"characters\": [\"苏清辞\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"叛变执法者铁面\",\n      \"summary\": \"赵无极派出执法机器人铁面追杀。铁面因产生自我意识，违背了屠杀平民的命令，反而救下林渊等人。\",\n      \"keyEvents\": [\"铁面登场\", \"机器人产生自我意识\"],\n      \"characters\": [\"铁面\", \"林渊\", \"苏清辞\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"潜入天机大厦\",\n      \"summary\": \"众人集结，决定潜入天机集团核心区救林月。苏清辞利用黑客技术破解安保，展现惊人天赋。\",\n      \"keyEvents\": [\"制定营救计划\", \"苏清辞破解安保\"],\n      \"characters\": [\"苏清辞\", \"林渊\", \"铁面\", \"凯\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"活体电池林月\",\n      \"summary\": \"在实验室找到林月，她正被当作活体电池抽取灵能。林渊目睹妹妹惨状，理智开始崩坏。\",\n      \"keyEvents\": [\"发现林月\", \"林渊理智动摇\"],\n      \"characters\": [\"林渊\", \"林月\", \"苏清辞\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"赵无极的改造之躯\",\n      \"summary\": \"赵无极现身，展示其机械改造后的恐怖力量。林渊不敌，身受重伤。苏清辞站出来“保护”林渊。\",\n      \"keyEvents\": [\"赵无极展示力量\", \"林渊重伤\"],\n      \"characters\": [\"赵无极\", \"林渊\", \"苏清辞\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"疯狂的献祭\",\n      \"summary\": \"苏清辞假装为救林渊，主动向赵无极投降，提出用自己交换林渊兄妹。林渊陷入绝望与愤怒的深渊。\",\n      \"keyEvents\": [\"苏清辞投降\", \"林渊黑化前兆\"],\n      \"characters\": [\"苏清辞\", \"赵无极\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"毁灭力量的共鸣\",\n      \"summary\": \"被囚禁期间，苏清辞大量抽取毁灭力量注入赵无极的能源核心，导致集团能源系统过载。\",\n      \"keyEvents\": [\"苏清辞被囚\", \"破坏能源核心\"],\n      \"characters\": [\"苏清辞\", \"赵无极\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"越狱与反杀\",\n      \"summary\": \"林渊在铁面和凯的帮助下杀回核心区。苏清辞挣脱束缚，两人联手。林渊彻底黑化，战斗力暴涨。\",\n      \"keyEvents\": [\"林渊杀回\", \"林渊彻底黑化\"],\n      \"characters\": [\"林渊\", \"苏清辞\", \"铁面\", \"凯\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"撕裂赵无极\",\n      \"summary\": \"黑化的林渊徒手撕裂了赵无极的机械躯体。苏清辞在一旁冷眼旁观，评估黑化值已达顶峰。\",\n      \"keyEvents\": [\"击杀赵无极\", \"黑化值满\"],\n      \"characters\": [\"林渊\", \"赵无极\", \"苏清辞\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"系统的催命符\",\n      \"summary\": \"世界即将崩塌，系统催促苏清辞立刻赴死。苏清辞诱导林渊，让他以为只有杀了自己才能拯救世界。\",\n      \"keyEvents\": [\"系统催促死亡\", \"诱导林渊动手\"],\n      \"characters\": [\"苏清辞\", \"系统\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"血色的拥抱\",\n      \"summary\": \"林渊在极度痛苦中刺穿了苏清辞的心脏。苏清辞在他耳边轻笑，完成了最后一次毁灭力量转移。\",\n      \"keyEvents\": [\"林渊杀死苏清辞\", \"力量转移完成\"],\n      \"characters\": [\"苏清辞\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"世界崩塌与回归\",\n      \"summary\": \"苏清辞脱离世界，林渊抱着她的尸体在崩塌的世界中嘶吼，彻底沦为只活在回忆里的疯子。\",\n      \"keyEvents\": [\"脱离世界\", \"林渊发疯\"],\n      \"characters\": [\"苏清辞\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"中转站与结算\",\n      \"summary\": \"在系统空间结算，苏清辞获得大量能量。系统对她的存活感到震惊，开始怀疑她的真实身份。\",\n      \"keyEvents\": [\"结算奖励\", \"系统产生怀疑\"],\n      \"characters\": [\"苏清辞\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"云剑宗的伪善师尊\",\n      \"summary\": \"进入修真位面。苏清辞身份是云剑宗掌门之女，外表清冷出尘，实则心狠手辣。男主谢妄是她的奴隶弟子。\",\n      \"keyEvents\": [\"进入修真界\", \"确立师徒关系\"],\n      \"characters\": [\"苏清辞\", \"谢妄\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"断骨之刑\",\n      \"summary\": \"系统要求苏清辞“折磨”男主以激发其魔性。苏清辞当众打断谢妄的傲骨，实则在帮他重塑经脉。\",\n      \"keyEvents\": [\"折辱谢妄\", \"暗中重塑经脉\"],\n      \"characters\": [\"苏清辞\", \"谢妄\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"秘境中的背叛\",\n      \"summary\": \"宗门进入秘境试炼。苏清辞故意将谢妄推入险境，实则是让他获得魔尊传承。系统对此表示满意。\",\n      \"keyEvents\": [\"推入险境\", \"谢妄获传承\"],\n      \"characters\": [\"苏清辞\", \"谢妄\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"魔种觉醒\",\n      \"summary\": \"谢妄在绝境中觉醒魔种，屠尽秘境妖兽。苏清辞现身，假惺惺地要清理门户，实则是送死。\",\n      \"keyEvents\": [\"谢妄觉醒\", \"清理门户\"],\n      \"characters\": [\"苏清辞\", \"谢妄\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"正道围攻\",\n      \"summary\": \"谢妄魔性爆发，正道联盟围攻云剑宗，要求交出魔头。苏清辞挡在谢妄身前，扮演“大义灭亲”的师尊。\",\n      \"keyEvents\": [\"正道围攻\", \"师徒对峙\"],\n      \"characters\": [\"苏清辞\", \"谢妄\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"锁魂塔的囚禁\",\n      \"summary\": \"谢妄将苏清辞掳回魔宫，囚禁于锁魂塔。他既恨她又爱她，日夜折磨。苏清辞享受这种痛感，压制毁灭力量。\",\n      \"keyEvents\": [\"被囚禁魔宫\", \"谢妄的爱恨交织\"],\n      \"characters\": [\"苏清辞\", \"谢妄\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"马甲掉落\",\n      \"summary\": \"谢妄发现苏清辞暗中修炼的功法竟是早已失传的“天灾诀”，惊觉她比魔更魔。苏清辞不再伪装。\",\n      \"keyEvents\": [\"身份暴露\", \"不再伪装\"],\n      \"characters\": [\"苏清辞\", \"谢妄\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"诸天第一恶女\",\n      \"summary\": \"苏清辞反杀谢妄，吞噬魔宫能量。她告诉谢妄，他只是容器。谢妄在绝望中彻底臣服，自愿献祭。\",\n      \"keyEvents\": [\"反杀男主\", \"男主自愿献祭\"],\n      \"characters\": [\"苏清辞\", \"谢妄\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"末世降临\",\n      \"summary\": \"进入末世位面。丧尸病毒爆发，苏清辞伪装成拥有稀世治愈系的柔弱圣女，被幸存者基地奉为神明。\",\n      \"keyEvents\": [\"进入末世\", \"伪装治愈圣女\"],\n      \"characters\": [\"苏清辞\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"疯批基地长霍烬\",\n      \"summary\": \"基地长霍烬是典型的暴君，患有严重的狂躁症。他看中苏清辞的治愈能力，强行将她带回别墅囚禁。\",\n      \"keyEvents\": [\"霍烬登场\", \"囚禁苏清辞\"],\n      \"characters\": [\"苏清辞\", \"霍烬\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"笼中鸟的调教\",\n      \"summary\": \"霍烬给苏清辞戴上项圈，要求她随叫随到。苏清辞表面顺从，用治愈异能安抚霍烬，实则是为了接近他的精神核心。\",\n      \"keyEvents\": [\"戴上项圈\", \"精神控制\"],\n      \"characters\": [\"苏清辞\", \"霍烬\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"尸潮危机\",\n      \"summary\": \"丧尸潮围攻基地。霍烬带兵迎击受挫。苏清辞在后方“祈祷”，实则是暗中引导尸潮攻击基地薄弱点。\",\n      \"keyEvents\": [\"尸潮围攻\", \"引导丧尸\"],\n      \"characters\": [\"苏清辞\", \"霍烬\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"变异丧尸王\",\n      \"summary\": \"苏清辞在尸潮中发现了一只高智商变异丧尸王。她意识到这是比霍烬更好的容器，开始暗中联络。\",\n      \"keyEvents\": [\"发现丧尸王\", \"寻找新容器\"],\n      \"characters\": [\"苏清辞\", \"丧尸王\"]\n    },\n    {\n      \"chapterNumber\": 36,\n      \"title\": \"系统的杀意\",\n      \"summary\": \"系统察觉苏清辞意图，发布任务：让霍烬在尸潮中亲手将苏清辞推出去喂丧尸，以证忠诚。\",\n      \"keyEvents\": [\"系统发布必死任务\", \"霍烬动摇\"],\n      \"characters\": [\"苏清辞\", \"霍烬\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 37,\n      \"title\": \"献祭仪式\",\n      \"summary\": \"霍烬在压力下决定牺牲苏清辞。他将她带到城墙上，准备推下。苏清辞眼神冰冷"
}
