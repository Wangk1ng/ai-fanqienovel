  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：社恐的恋爱噩梦\",\n      \"chapterRange\": \"第1-18章\",\n      \"summary\": \"社恐黑客许默绑定“万物女友”系统，被迫对键盘、路灯等物品进行羞耻互动以续命。在完成初期任务解锁黑客神技的同时，因行为怪异被赏金猎人苏青盯上，并初次遭遇反派势力的试探。\",\n      \"plotPoints\": [\"许默绑定系统，被迫亲吻键盘\", \"解锁极速编程能力，解决黑市危机\", \"被苏青目击“调戏”路灯，引发误会\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：城市的恋爱回响\",\n      \"chapterRange\": \"第19-38章\",\n      \"summary\": \"任务升级，攻略目标转向载具与建筑。许默在“壁咚”大楼时引来了顾长风的注意。结识黑客王凯与拳手雷烈，通过物理黑入现实物体，多次化解薇薇安的追杀。\",\n      \"plotPoints\": [\"攻略跑车，获得自动驾驶权限\", \"王凯加入，解析系统背后的数据阴谋\", \"雷烈被折服，成为临时保镖\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：数据深渊的悸动\",\n      \"chapterRange\": \"第39-62章\",\n      \"summary\": \"许默发现“万物女友”系统是抵抗数据化的最后防线。结识神秘少女叶绯与病理学家陈默。顾长风加速“数据飞升”计划，许默被迫攻略城市地标以获取对抗权限。\",\n      \"plotPoints\": [\"叶绯现身，揭示系统真谛\", \"陈默提供药剂，稳定许默数据化左臂\", \"攻略市图书馆，获取绝密档案\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：全城热恋的反击\",\n      \"chapterRange\": \"第63-82章\",\n      \"summary\": \"不再躲避，许默主动出击。通过攻略城市核心设施，建立“恋爱防御网”。苏青回归，团队集结。顾长风发动局部数据吞噬，许默利用红绿灯与监控网反杀。\",\n      \"plotPoints\": [\"攻略电力中心，掌控城市能源\", \"苏青背叛顾长风，加入许默阵营\", \"利用“恋爱值”过载，瘫痪反派分部\"]\n    },\n    {\n      \"actNumber\": 5,\n      \"actName\": \"第五幕：主宰虚拟与现实\",\n      \"chapterRange\": \"第83-100章\",\n      \"summary\": \"最终决战，顾长风试图强制融合全城意识。许默攻略“城市之心”超级计算机，以爱意为代码改写底层逻辑。击败顾长风，成为现实与虚拟的双重主宰，继续他羞耻又平静的生活。\",\n      \"plotPoints\": [\"潜入顾长风总部，攻略防火墙\", \"许默与城市意识达成终极契约\", \"顾长风被数据同化，许默拯救世界\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"系统：请立刻亲吻你的键盘\",\n      \"summary\": \"社恐黑客许默家中突现系统，威胁若不亲吻机械键盘将扣除十年寿命。许默在绝望中含泪营业，键盘竟化作傲娇少女。\",\n      \"keyEvents\": [\"系统绑定\", \"初识羞耻任务\"],\n      \"characters\": [\"许默\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"好感度提升：极速编程\",\n      \"summary\": \"完成亲吻任务后，键盘女友解锁“物理权限”。许默手指如飞，代码输入速度提升十倍，轻松解决黑市悬赏。\",\n      \"keyEvents\": [\"解锁极速编程\", \"黑市首秀\"],\n      \"characters\": [\"许默\", \"王凯\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"路灯：它在对你抛媚眼\",\n      \"summary\": \"外出买泡面被系统强制要求壁咚路灯。许默在深夜街头对路灯深情告白，被路过的赏金猎人苏青全程目睹。\",\n      \"keyEvents\": [\"壁咚路灯\", \"苏青目击\"],\n      \"characters\": [\"许默\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"监控权：我也想低调啊\",\n      \"summary\": \"路灯好感度达标，许默获得整条街的监控权限。他利用监控避开苏青的盘查，却因行为过于诡异被列入嫌疑名单。\",\n      \"keyEvents\": [\"解锁监控权\", \"躲避苏青\"],\n      \"characters\": [\"许默\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"自动售货机：贪吃的小富婆\",\n      \"summary\": \"饥饿难耐的许默遭遇新任务：投喂自动售货机。他花费积蓄买光所有饮料，换取了售货机吐出的稀有道具。\",\n      \"keyEvents\": [\"攻略售货机\", \"获得稀有道具\"],\n      \"characters\": [\"许默\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"数据幽灵的求救\",\n      \"summary\": \"黑客王凯因破解异能局档案被全城通缉，信号追踪至许默附近。许默利用键盘权限帮王凯伪造数据，顺手救下这个未来的队友。\",\n      \"keyEvents\": [\"救下王凯\", \"伪造数据\"],\n      \"characters\": [\"许默\", \"王凯\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"红绿灯：别逼我调戏你\",\n      \"summary\": \"系统发布限时任务，要求许默在十字路口对红绿灯“深情对视”。许默硬着头皮执行，导致交通瘫痪，却意外帮王凯摆脱了追兵。\",\n      \"keyEvents\": [\"调戏红绿灯\", \"制造混乱\"],\n      \"characters\": [\"许默\", \"王凯\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"苏青的怀疑\",\n      \"summary\": \"苏青调查交通瘫痪事件，发现所有异常都指向许默。她找到许默的出租屋，却只看到对着电脑自言自语的“变态”。\",\n      \"keyEvents\": [\"苏青上门\", \"初步接触\"],\n      \"characters\": [\"许默\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"左臂的异样\",\n      \"summary\": \"许默左臂旧伤发作，数据流溢出。系统提示需攻略特定医疗器械才能缓解痛苦。许默潜入药店，对一台心电图机发动攻势。\",\n      \"keyEvents\": [\"旧伤发作\", \"攻略医疗器械\"],\n      \"characters\": [\"许默\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"顾长风的注视\",\n      \"summary\": \"城市数据异常波动引起了前局长顾长风的注意。他派遣养女薇薇安前往调查，誓要找出那个能“物理黑入”现实的怪人。\",\n      \"keyEvents\": [\"反派登场\", \"派遣杀手\"],\n      \"characters\": [\"顾长风\", \"薇薇安\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"薇薇安的第一刀\",\n      \"summary\": \"薇薇安锁定许默，在暗巷发动突袭。许默利用路边垃圾桶的“弹射”功能狼狈躲避，第一次面临生死危机。\",\n      \"keyEvents\": [\"遭遇刺杀\", \"利用垃圾桶逃生\"],\n      \"characters\": [\"许默\", \"薇薇安\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"这辆跑车有点高傲\",\n      \"summary\": \"为逃离追杀，许默被迫对路边一辆超跑展开“壁咚”求爱。高傲的跑车被他的真诚（求生欲）打动，自动解锁并开启自动驾驶。\",\n      \"keyEvents\": [\"攻略超跑\", \"驾车逃亡\"],\n      \"characters\": [\"许默\", \"薇薇安\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"飙车：与车谈心的艺术\",\n      \"summary\": \"许默一边与薇薇安追逐战，一边还要不断对跑车说情话维持好感度。这一幕被市民拍下，社死程度爆表。\",\n      \"keyEvents\": [\"飙车逃亡\", \"社死现场\"],\n      \"characters\": [\"许默\", \"薇薇安\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"地下黑拳场的邀请\",\n      \"summary\": \"跑车将许默带到地下黑拳场。这里藏着顾长风的一个秘密据点。许默决定混入其中，却被拳王雷烈拦住去路。\",\n      \"keyEvents\": [\"抵达黑拳场\", \"遭遇雷烈\"],\n      \"characters\": [\"许默\", \"雷烈\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"拳套：请轻一点打我\",\n      \"summary\": \"面对雷烈，许默无法力敌。他突发奇想，攻略了雷烈的拳套。拳套在关键时刻“漏力”，许默险胜，折服了雷烈。\",\n      \"keyEvents\": [\"攻略拳套\", \"折服雷烈\"],\n      \"characters\": [\"许默\", \"雷烈\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"雷烈的投名状\",\n      \"summary\": \"雷烈被许默的“诡异力量”震撼，决定追随强者。许默多了一个打手，但同时也多了一个需要解释奇怪行为的麻烦。\",\n      \"keyEvents\": [\"雷烈加入\", \"团队雏形\"],\n      \"characters\": [\"许默\", \"雷烈\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"苏青的抉择\",\n      \"summary\": \"苏青发现顾长风也在追杀许默，并得知许默的异常与“数据灵性”有关。她回忆起上司的实验，决定暂时不抓许默，暗中观察。\",\n      \"keyEvents\": [\"苏青动摇\", \"暗中观察\"],\n      \"characters\": [\"苏青\", \"顾长风\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"第一幕终章：被盯上的隐形人\",\n      \"summary\": \"许默以为能继续苟着，却发现城市里越来越多的物品开始对他“眨眼”。系统发布新指令：攻略一座小型基站，揭开阴谋的一角。\",\n      \"keyEvents\": [\"物品觉醒\", \"新任务发布\"],\n      \"characters\": [\"许默\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"基站：这里的信号有毒\",\n      \"summary\": \"许默潜入基站，发现数据流中混杂着吞噬人类意识的代码。他通过“拥抱”基站，净化了部分数据，却触动了顾长风的警报。\",\n      \"keyEvents\": [\"净化基站\", \"触动警报\"],\n      \"characters\": [\"许默\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"王凯的技术分析\",\n      \"summary\": \"王凯分析许默带回来的数据，震惊地发现这是“人类补完计划”的雏形。许默意识到，自己的恋爱任务可能是在拯救世界。\",\n      \"keyEvents\": [\"分析数据\", \"发现真相\"],\n      \"characters\": [\"许默\", \"王凯\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"神秘少女叶绯\",\n      \"summary\": \"许默在网吧偶遇叶绯，一个对常识一无所知的少女。她盯着许默的左臂发呆，那是她熟悉的“深渊”气息。\",\n      \"keyEvents\": [\"叶绯登场\", \"左臂共鸣\"],\n      \"characters\": [\"许默\", \"叶绯\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"叶绯的跟随\",\n      \"summary\": \"叶绯寸步不离地跟着许默，称他为“同源”。许默多了一个像宠物一样粘人但实力恐怖的跟班。\",\n      \"keyEvents\": [\"叶绯入队\", \"神秘体质\"],\n      \"characters\": [\"许默\", \"叶绯\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"陈默的药剂\",\n      \"summary\": \"左臂数据侵蚀加剧，许默找到偏执病理学家陈默。陈默为了临床数据，答应为他制作抑制剂，条件是观察他的“恋爱过程”。\",\n      \"keyEvents\": [\"结识陈默\", \"获得抑制剂\"],\n      \"characters\": [\"许默\", \"陈默\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"电梯：密闭空间的暧昧\",\n      \"summary\": \"顾长风的大楼内，许默被困电梯。系统要求他在十秒内对电梯“告白”以启动紧急制动。许默含泪大喊“我爱你”，电梯门开了。\",\n      \"keyEvents\": [\"被困电梯\", \"攻略电梯\"],\n      \"characters\": [\"许默\", \"薇薇安\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"薇薇安的杀戮舞步\",\n      \"summary\": \"电梯门开即是战场。薇薇安在狭小空间内展开杀戮。叶绯出手，一股无形的力量直接震飞了薇薇安，暴露了高阶意识体的实力。\",\n      \"keyEvents\": [\"叶绯出手\", \"薇薇安受挫\"],\n      \"characters\": [\"许默\", \"薇薇安\", \"叶绯\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"苏青的倒戈\",\n      \"summary\": \"苏青目睹薇薇安无差别攻击，终于出手阻拦。她正式与许默结盟，透露顾长风即将启动“全城数据化”。\",\n      \"keyEvents\": [\"苏青入队\", \"揭露计划\"],\n      \"characters\": [\"许默\", \"苏青\", \"薇薇安\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"攻略计划：城市地标\",\n      \"summary\": \"为了对抗顾长风，许默必须掌握城市的控制权。系统列出清单：电视塔、变电站、中央图书馆。攻略行动开始。\",\n      \"keyEvents\": [\"制定攻略计划\", \"选定目标\"],\n      \"characters\": [\"许默\", \"王凯\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"电视塔：全城告白\",\n      \"summary\": \"许默潜入电视塔顶端，任务要求他对全城“表白”。他被迫黑入广播系统，在所有频道播放羞耻的语音，好感度爆表。\",\n      \"keyEvents\": [\"黑入广播\", \"全城社死\"],\n      \"characters\": [\"许默\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"舆论风暴：变态英雄？\",\n      \"summary\": \"许默的“告白”虽然羞耻，但意外清除了顾长风植入的潜意识广告。市民们开始讨论这个神秘的“变态黑客”。\",\n      \"keyEvents\": [\"清除广告\", \"舆论反转\"],\n      \"characters\": [\"许默\", \"顾长风\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"顾长风的震怒\",\n      \"summary\": \"计划被打乱，顾长风决定提前行动。他启动了名为“猎犬”的自动化机械部队，围剿许默。\",\n      \"keyEvents\": [\"反派行动\", \"机械部队围剿\"],\n      \"characters\": [\"顾长风\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"扫地机器人：大军中的叛徒\",\n      \"summary\": \"面对机械大军，许默发动技能“万物共鸣”。所有的清洁机器人突然倒戈，缠住了军用机械，为众人争取时间。\",\n      \"keyEvents\": [\"万物共鸣\", \"清洁机器人叛变\"],\n      \"characters\": [\"许默\", \"雷烈\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"中央图书馆：知识的诱惑\",\n      \"summary\": \"许默进入图书馆寻找对抗顾长风的资料。他对服务器进行“抚摸”，海量知识涌入脑海，找到了顾长风的弱点。\",\n      \"keyEvents\": [\"攻略服务器\", \"获取弱点\"],\n      \"characters\": [\"许默\", \"王凯\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"叶绯的记忆碎片\",\n      \"summary\": \"在图书馆的数据流中，叶绯看到了自己的过去。她并非人类，而是初代网络意识体，被顾长风背叛并抛弃。\",\n      \"keyEvents\": [\"叶绯恢复记忆\", \"身世揭秘\"],\n      \"characters\": [\"叶绯\", \"许默\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"陈默的背叛？\",\n      \"summary\": \"陈默被顾长风绑架，被迫交出许默的生理数据。许默陷入两难，但他相信陈默的偏执里藏着变数。\",\n      \"keyEvents\": [\"陈默被抓\", \"数据泄露\"],\n      \"characters\": [\"陈默\", \"顾长风\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"潜入：异能管理局废墟\",\n      \"summary\": \"为救陈默，众人潜入废墟。许默通过“对话”废墟中的安保系统，让大门自动为敌人敞开，又瞬间关闭困住敌人。\",\n      \"keyEvents\": [\"潜入废墟\", \"利用安保系统\"],\n      \"characters\": [\"许默\", \"苏青\", \"雷烈\"]\n    },\n    {\n      \"chapterNumber\": 36,\n      \"title\": \"陈默的最后一剂药\",\n      \"summary\": \"陈默给顾长风的药剂其实是“数据病毒”。他用自己的方式完成了救赎，在许默赶到前自毁意识数据。\",\n      \"keyEvents\": [\"陈默牺牲\", \"数据病毒\"],\n      \"characters\": [\"陈默\", \"顾长风\"]\n    },\n    {\n      \"chapterNumber\": 37,\n      \"title\": \"愤怒的左臂\",\n      \"summary\": \"陈默的死激怒了许默，左臂的数据侵蚀彻底爆发，但他意外发现这股力量能直接“格式化”敌人的装备。\",\n      \"keyEvents\": [\"左臂爆发\", \"格式化装备\"],\n      \"characters\": [\"许默\"]\n    },\n    {\n      \"chapterNumber\": 38,\n      \"title\": \"第二幕终章：宣战公告\",\n      \"summary\": \"许默利用全城屏幕，向顾长风正式宣战。他不再是被迫恋爱的社恐，而是要"
