  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：反向扶贫与双向奔赴\",\n      \"chapterRange\": \"第1-25章\",\n      \"summary\": \"霍景深绑定系统，发现扶贫对象竟是社恐小职员云初夏。为了不让对方破产，两人开启疯狂装穷模式，领证同居。在应对势利亲戚嘲讽中，两人通过“疯狂消费”触发资产翻倍，建立起独特的“贫穷”夫妻关系。\",\n      \"plotPoints\": [\"系统绑定与初次相遇\", \"领证同居与确立人设\", \"初次交锋势利亲戚\", \"资产翻倍机制的初次触发\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：隐形大佬的日常互撩\",\n      \"chapterRange\": \"第26-50章\",\n      \"summary\": \"两人在贫民窟豪宅中生活，表面吃路边摊、骑共享单车，背地里却买下整条街。云初夏作为地下女王暗中处理危机，霍景深作为首富暗中铺路。两人在互相“帮对方省钱”的借口下，感情迅速升温。\",\n      \"plotPoints\": [\"商业危机与暗中出手\", \"互相掉马（部分）\", \"系统的奇葩任务\", \"感情升温与甜蜜互动\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：马甲掉落与危机升级\",\n      \"chapterRange\": \"第51-75章\",\n      \"summary\": \"反派势力察觉异常，试图针对这对“穷夫妻”。云初夏的地下女王身份在关键时刻暴露给霍景深，霍景深的财力也让云初夏震惊。两人决定不再隐藏实力，联手对抗试图吞并他们资产的商业对手。\",\n      \"plotPoints\": [\"反派的阴谋与陷害\", \"云初夏身份部分暴露\", \"霍景深霸气护妻\", \"联手反击与布局\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：全球震惊与终极撒糖\",\n      \"chapterRange\": \"第76-100章\",\n      \"summary\": \"订婚宴上，反派企图当众揭穿两人“穷酸”的真面目，却意外引出了两人真实的顶级身份。全球首富与地下女王的双重身份曝光，震惊世界。系统任务圆满完成，两人举办世纪婚礼。\",\n      \"plotPoints\": [\"订婚宴前的筹备\", \"反派的最后一次挣扎\", \"身份彻底大曝光\", \"大结局与系统升级\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"绑定反向扶贫系统\",\n      \"summary\": \"全球首富霍景深意外绑定“反向扶贫系统”，规则显示：他每消费一分，绑定对象资产翻倍。为了不让对方破产，他必须寻找那个幸运儿。\",\n      \"keyEvents\": [\"霍景深绑定系统\", \"得知规则\"],\n      \"characters\": [\"霍景深\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"目标竟是那个穷鬼\",\n      \"summary\": \"系统锁定目标：云初夏，一个住在下城区、靠捡垃圾为生的社恐小职员。霍景深看着对方账户里的三位数余额，陷入了沉思。\",\n      \"keyEvents\": [\"锁定云初夏\", \"霍景深调查背景\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"初次相遇：借火吗？\",\n      \"summary\": \"霍景深伪装成落魄打工仔接近云初夏。云初夏正在废品站拆解精密仪器，眼神锐利，瞬间识破霍景深的伪装却未点破。\",\n      \"keyEvents\": [\"废品站相遇\", \"互相试探\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"为了帮你，我娶了你\",\n      \"summary\": \"为了方便“扶贫”，霍景深提议结婚，理由是“两个人凑合过比较省钱”。云初夏看着手里刚到手的巨额地下订单，鬼使神差地答应了。\",\n      \"keyEvents\": [\"提议结婚\", \"云初夏答应\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"领证：我们很穷\",\n      \"summary\": \"两人领证，霍景深将全部资产转入信托，只留几百块零花钱。云初夏也将地下资金冻结。两人搬进贫民窟的“危房”（实为霍景深秘密安保基地）。\",\n      \"keyEvents\": [\"领证\", \"搬入贫民窟\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"第一顿饭：泡面加蛋\",\n      \"summary\": \"新婚之夜，两人为了比穷，争着吃泡面。霍景深偷偷在泡面里加了黑松露露，云初夏则拿出了珍藏的82年可乐当水喝。\",\n      \"keyEvents\": [\"吃泡面比穷\", \"暗戳戳炫富\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"回门：势利的亲戚\",\n      \"summary\": \"云初夏带霍景深回云家老宅，亲戚们嘲笑她找了个穷鬼。霍景深淡定自若，心里盘算着怎么收购云家集团给老婆“出气”。\",\n      \"keyEvents\": [\"云家聚会\", \"亲戚嘲讽\"],\n      \"characters\": [\"霍景深\", \"云初夏\", \"云家亲戚\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"这就叫破产？\",\n      \"summary\": \"云初夏的表姐炫耀名牌包，云初夏淡定表示自己背的是环保袋（实为全球限量版，被系统滤镜屏蔽了光芒）。霍景深心疼老婆，暗中收购了包场。\",\n      \"keyEvents\": [\"攀比名牌\", \"霍景深暗中收购\"],\n      \"characters\": [\"霍景深\", \"云初夏\", \"表姐\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"系统任务：花光一个亿\",\n      \"summary\": \"系统发布任务：霍景深需在24小时内花光一亿，否则云初夏将倒霉。霍景深为了不让老婆受苦，开始疯狂“挥霍”。\",\n      \"keyEvents\": [\"系统发布任务\", \"霍景深开始花钱\"],\n      \"characters\": [\"霍景深\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"老婆，这楼我替你买了\",\n      \"summary\": \"霍景深买下云家对面的烂尾楼，理由是“挡住风水，怕你表姐倒霉”。云初夏账户瞬间翻倍，震惊地看着余额。\",\n      \"keyEvents\": [\"买下烂尾楼\", \"云初夏资产翻倍\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"云初夏的反击\",\n      \"summary\": \"发现资产翻倍秘密的云初夏，决定反向操作。她偷偷买下了霍景深公司竞争对手的股份，理由是“怕你生意不好做，压力大”。\",\n      \"keyEvents\": [\"云初夏发现秘密\", \"云初夏买股份\"],\n      \"characters\": [\"云初夏\", \"霍景深\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"霍景深的资产危机\",\n      \"summary\": \"云初夏的消费导致霍景深资产再次翻倍，首富变得更富。霍景深看着账户多出来的零，痛苦地捂住胸口：“太穷了，花不完。”\",\n      \"keyEvents\": [\"霍景深资产翻倍\", \"哭穷\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"上班：挤地铁体验生活\",\n      \"summary\": \"两人为了维持人设，一起挤地铁。霍景深被挤得脚不沾地，云初夏暗中用黑客技术控制了地铁显示屏，播放霍景深名下的广告。\",\n      \"keyEvents\": [\"挤地铁\", \"云初夏小动作\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"公司风波：新来的实习生\",\n      \"summary\": \"云初夏为了体验生活，去霍景深的公司当保洁员。霍景深为了配合，假装是底层保安。两人在公司里上演“地下情”。\",\n      \"keyEvents\": [\"潜入公司\", \"身份伪装\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"绿茶同事的挑衅\",\n      \"summary\": \"女同事看不起保安霍景深，试图勾搭。霍景深冷笑，该女同事第二天就收到了调往非洲分部的通知书（霍景深的手笔）。\",\n      \"keyEvents\": [\"同事挑衅\", \"霍景深暗中处理\"],\n      \"characters\": [\"霍景深\", \"女同事\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"保洁阿姨的威慑力\",\n      \"summary\": \"云初夏在保洁时，顺手修复了公司主服务器的一个致命BUG。技术总监惊为天人，到处寻找扫地僧，却只找到了云初夏。\",\n      \"keyEvents\": [\"修复BUG\", \"技术总监震惊\"],\n      \"characters\": [\"云初夏\", \"技术总监\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"约会：地摊大排档\",\n      \"summary\": \"两人约会去大排档，霍景深包下了整个摊位，理由是“怕人多吵到你”。云初夏买下了大排档所在的整条街，理由是“怕你吃地沟油”。\",\n      \"keyEvents\": [\"大排档约会\", \"互相买街\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"危机：永生科技的注视\",\n      \"summary\": \"神秘财团“永生科技”注意到了这对异常的夫妇，派出商业间谍薇薇安接近，试图查探他们的底细。\",\n      \"keyEvents\": [\"永生科技登场\", \"派出间谍\"],\n      \"characters\": [\"薇薇安\", \"永生科技CEO\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"薇薇安的试探\",\n      \"summary\": \"薇薇安伪装成富家女，故意在云初夏面前炫富，试图激怒她。云初夏毫无波澜，反手用黑客技术曝光了薇薇安的假名牌。\",\n      \"keyEvents\": [\"薇薇安炫富\", \"云初夏打脸\"],\n      \"characters\": [\"云初夏\", \"薇薇安\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"霍景深的警告\",\n      \"summary\": \"霍景深识破了薇薇安的身份，作为商业帝王，他直接给永生科技CEO打了电话：“动我老婆？你们公司不想上市了？”\",\n      \"keyEvents\": [\"霍景深识破间谍\", \"电话警告\"],\n      \"characters\": [\"霍景深\", \"薇薇安\", \"永生科技CEO\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"系统的惩罚机制\",\n      \"summary\": \"系统检测到两人资产过高，发布惩罚任务：必须在24小时内让对方觉得自己“很穷”。两人开始新一轮的演技大比拼。\",\n      \"keyEvents\": [\"系统惩罚任务\", \"演技比拼\"],\n      \"characters\": [\"霍景深\", \"云初夏\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"卖惨大赛\",\n      \"summary\": \"霍景深穿着破洞袜（高定定制版），云初夏煮着糊锅饭（米是金箔做的）。两人互相心疼，演技浮夸却甜蜜。\",\n      \"keyEvents\": [\"穿破洞袜\", \"煮糊饭\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"地下世界的暗流\",\n      \"summary\": \"云初夏的旧部下“老鬼”发来求救信号，被财团围剿。云初夏决定出山，但必须瞒着霍景深。\",\n      \"keyEvents\": [\"老鬼求救\", \"云初夏决定出山\"],\n      \"characters\": [\"云初夏\", \"老鬼\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"深夜离家\",\n      \"summary\": \"云初夏留书出走，理由是“去隔壁省打工赚路费”。霍景深看着信，嘴角上扬：“老婆，你的黑丝袜忘带了。”\",\n      \"keyEvents\": [\"云初夏离家\", \"霍景深看穿\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"首富的暗中护航\",\n      \"summary\": \"霍景深调动私人卫星追踪云初夏，同时买下了老鬼所在的那个岛，理由是“想搞农业开发”。\",\n      \"keyEvents\": [\"卫星追踪\", \"买下岛屿\"],\n      \"characters\": [\"霍景深\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"女王归来\",\n      \"summary\": \"云初夏换上皮衣，气场全开，单枪匹马杀入重围。财团士兵惊恐发现，这个“穷鬼”竟是传说中的地下女王。\",\n      \"keyEvents\": [\"云初夏变身\", \"救出老鬼\"],\n      \"characters\": [\"云初夏\", \"老鬼\", \"财团士兵\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"霍景深的“农业开发”\",\n      \"summary\": \"霍景深的“农业队”（特种兵伪装）空降岛屿，以“驱赶野猪”为由，帮云初夏扫清了剩余的财团追兵。\",\n      \"keyEvents\": [\"特种兵空降\", \"清理战场\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"夫妻汇合\",\n      \"summary\": \"两人在废墟中相遇。霍景深递给云初夏一瓶水：“打工辛苦吗？这是我刚买的矿泉水厂产的。”\",\n      \"keyEvents\": [\"废墟相遇\", \"递水\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"默契的谎言\",\n      \"summary\": \"两人对视一眼，谁也没有拆穿对方的身份。霍景深：“我是来考察农业项目的。”云初夏：“我是来……捡破烂的。”\",\n      \"keyEvents\": [\"互相隐瞒\", \"借口蹩脚\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"回家后的温馨\",\n      \"summary\": \"回到贫民窟，两人累瘫在沙发上。霍景深给云初夏按摩腿：“以后这种重活（灭掉财团分部）让我来。”\",\n      \"keyEvents\": [\"按摩腿\", \"霍景深心疼\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"老鬼的投奔\",\n      \"summary\": \"老鬼带着伤势投奔夫妇俩，以为他们是隐居的高人。霍景深收留他，让他当“保安队长”。\",\n      \"keyEvents\": [\"老鬼加入\", \"当保安\"],\n      \"characters\": [\"老鬼\", \"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"技术宅咪咪\",\n      \"summary\": \"老鬼带来了孤儿咪咪，机械改装天才。咪咪一眼看穿家里的电器全是顶配，被云初夏用糖堵住了嘴。\",\n      \"keyEvents\": [\"咪咪登场\", \"看穿电器\"],\n      \"characters\": [\"咪咪\", \"云初夏\", \"老鬼\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"薇薇安的阴谋\",\n      \"summary\": \"薇薇安不甘心失败，联合云家亲戚，企图在商业上打压霍景深的公司，逼他们破产。\",\n      \"keyEvents\": [\"薇薇安联手\", \"商业打压\"],\n      \"characters\": [\"薇薇安\", \"云家亲戚\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"股价大跌？\",\n      \"summary\": \"霍氏集团股价异常波动。霍景深看着K线图，淡定地对云初夏说：“老婆，我们可能要睡大街了。”\",\n      \"keyEvents\": [\"股价波动\", \"霍景深演戏\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"云初夏的“私房钱”\",\n      \"summary\": \"云初夏为了“帮老公”，动用了地下资金，暗中大量买入霍氏股票，瞬间拉爆空头。\",\n      \"keyEvents\": [\"云初夏抄底\", \"拉爆股价\"],\n      \"characters\": [\"云初夏\", \"霍景深\"]\n    },\n    {\n      \"chapterNumber\": 36,\n      \"title\": \"薇薇安的破产\",\n      \"summary\": \"薇薇安因为杠杆操作，反而赔得底掉。她查不到资金来源，只能怀疑这对“穷鬼”有邪术。\",\n      \"keyEvents\": [\"薇薇安爆仓\", \"怀疑邪术\"],\n      \"characters\": [\"薇薇安\"]\n    },\n    {\n      \"chapterNumber\": 37,\n      \"title\": \"霍景深的报恩\",\n      \"summary\": \"霍景深“感激”神秘人帮忙，决定捐款做慈善。他捐了一所大学给云初夏，理由是“老婆没学历，我怕你被骗，这学校归你了”。\",\n      \"keyEvents\": [\"捐款大学\", \"理由奇葩\"],\n      \"characters\": [\"霍景深\", \"云初夏\"]\n    },\n    {\n"
