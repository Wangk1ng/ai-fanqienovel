  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：全网黑的“金丝雀”\",\n      \"chapterRange\": \"第1-20章\",\n      \"summary\": \"叶曦作为全网黑的花瓶，被迫参加全息选秀。她本想隐藏实力做个咸鱼，却因系统BUG和对手挑衅，被迫用“暴力美学”通关。帝国元帅陆泽试图将她圈养保护，却不知自家小娇妻在虚拟世界里大杀四方。\",\n      \"plotPoints\": [\"叶曦进入全息选秀，遭遇系统BUG\", \"一拳打爆机甲，初露锋芒\", \"陆泽试图劝退叶曦，反被安抚\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：马甲摇摇欲坠\",\n      \"chapterRange\": \"第21-40章\",\n      \"summary\": \"选秀进入白热化，叛军开始利用选秀进行暗杀和舆论操控。叶曦为了自保和队友，不得不展现出高超的战术指挥能力（联邦指挥官马甲松动）。陆泽在直播中看到了熟悉的战术，陷入自我怀疑。\",\n      \"plotPoints\": [\"团队赛中展现神级指挥\", \"陆泽怀疑叶曦身份，被“柔弱”演技骗过\", \"叛军特工在游戏中对叶曦下手\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：虚拟与现实的交织\",\n      \"chapterRange\": \"第41-60章\",\n      \"summary\": \"叛军加大渗透力度，试图利用全息网络精神力冲击控制观众。叶曦在游戏内反向追踪，化身神秘黑客“裁决者”对抗叛军网络。现实世界中，叶曦不得不多次暗中出手，保护陆泽免受叛军暗杀。\",\n      \"plotPoints\": [\"叶曦在游戏中化身黑客对抗病毒\", \"现实中叶曦夜行，解决针对陆泽的刺杀\", \"陆泽发现家中“金丝雀”的异常疲惫\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：帝都惊变与身份曝光\",\n      \"chapterRange\": \"第61-80章\",\n      \"summary\": \"叛军孤注一掷，攻入帝都星域。陆泽重伤倒地，帝国防线崩溃。正在直播总决赛的叶曦直接下线，手持光剑冲入战场。联邦第一指挥官“裁决者”身份彻底曝光，全星际震动。\",\n      \"plotPoints\": [\"叛军攻城，陆泽重伤\", \"叶曦掉马，单手拎光剑救场\", \"全星际沸腾，黑粉集体闭嘴\"]\n    },\n    {\n      \"actNumber\": 5,\n      \"actName\": \"第五幕：并肩作战与宠妻日常\",\n      \"chapterRange\": \"第81-100章\",\n      \"summary\": \"叶曦接管指挥权，联合陆泽的残余部队平定叛乱。战后，陆泽开启“妻管严”模式，努力追妻。两人联手肃清联邦与帝国的内部毒瘤，最终举办星际婚礼。\",\n      \"plotPoints\": [\"叶曦指挥反攻，彻底铲除叛军\", \"陆泽康复，疯狂宠妻求原谅\", \"尘埃落定，两人携手统治星际\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"全网黑的契约婚姻\",\n      \"summary\": \"叶曦被全网嘲讽为依附元帅的草包花瓶，陆泽为了保护她将其圈养，并禁止她接触危险事物，两人关系微妙。\",\n      \"keyEvents\": [\"叶曦被黑粉攻击\", \"陆泽发布声明护短\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"被迫营业的选秀\",\n      \"summary\": \"为了不拖累陆泽的声誉，叶曦决定参加全息选秀《星际战神》，试图用实力洗白，实则只想低调通关。\",\n      \"keyEvents\": [\"叶曦报名参赛\", \"陆泽表示担忧\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"全息舱里的意外\",\n      \"summary\": \"叶曦进入全息游戏，本想选辅助职业，却因手滑选了最冷门的“格斗家”，且初始武器是一把生锈的铁管。\",\n      \"keyEvents\": [\"角色创建失误\", \"获得废柴武器\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"第一场生存赛\",\n      \"summary\": \"海选开始，其他选手驾驶机甲互殴。叶曦因为没有机甲，被迫肉身抗机甲，被对手嘲笑。\",\n      \"keyEvents\": [\"海选开始\", \"叶曦遭嘲笑\"],\n      \"characters\": [\"叶曦\", \"路人选手\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"一拳超人\",\n      \"summary\": \"对手驾驶机甲嘲讽，叶曦忍无可忍，一拳打爆了对方造价昂贵的机甲。全场寂静，随后弹幕爆炸。\",\n      \"keyEvents\": [\"一拳打爆机甲\", \"直播间炸锅\"],\n      \"characters\": [\"叶曦\", \"路人选手\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"这是BUG吧？\",\n      \"summary\": \"官方判定数据正常，黑粉却坚称是BUG。陆泽看着直播画面，陷入沉思：自家小娇妻力气什么时候这么大了？\",\n      \"keyEvents\": [\"官方回应\", \"陆泽疑惑\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"元帅的“贴心”关怀\",\n      \"summary\": \"陆泽给叶曦送来顶级营养剂，心疼地说：“手疼吗？下次这种粗活让保镖做。”叶曦心虚地喝下营养剂。\",\n      \"keyEvents\": [\"陆泽送营养剂\", \"叶曦心虚\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"晋级赛的黑幕\",\n      \"summary\": \"晋级赛分组，叶曦被分到死亡之组。对手是拥有资本背景的流量明星，企图在比赛中围剿她。\",\n      \"keyEvents\": [\"分组黑幕\", \"遭遇围剿\"],\n      \"characters\": [\"叶曦\", \"流量明星\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"暴力美学\",\n      \"summary\": \"叶曦不再隐藏，利用地形和格斗技巧，将围剿她的选手一个个扔出擂台。观众直呼太残暴了。\",\n      \"keyEvents\": [\"叶曦反击\", \"暴力美学展现\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"神秘的关注\",\n      \"summary\": \"联邦最高指挥部的某人注意到了叶曦的战斗风格，觉得眼熟。叛军也在暗处观察，标记了叶曦。\",\n      \"keyEvents\": [\"联邦高层关注\", \"叛军标记\"],\n      \"characters\": [\"叶曦\", \"叛军首领\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"陆泽的试探\",\n      \"summary\": \"陆泽故意带叶曦去帝国机甲库，观察她对机甲的反应。叶曦装作害怕机器的样子，演技浮夸。\",\n      \"keyEvents\": [\"陆泽试探\", \"叶曦演戏\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"积分赛开启\",\n      \"summary\": \"比赛模式改为团队积分赛。叶曦被其他队伍嫌弃，最后只能和几个边缘人组队。\",\n      \"keyEvents\": [\"组队困难\", \"边缘人队伍\"],\n      \"characters\": [\"叶曦\", \"队友\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"废柴队友的逆袭\",\n      \"summary\": \"叶曦开始指挥队友，利用他们的特长布置陷阱。原本垫底的队伍竟然逆袭连胜。\",\n      \"keyEvents\": [\"叶曦指挥\", \"队伍逆袭\"],\n      \"characters\": [\"叶曦\", \"队友\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"熟悉的战术\",\n      \"summary\": \"陆泽作为特邀解说嘉宾观看比赛，听到叶曦的指挥指令，猛然想起失踪多年的联邦战神“裁决者”。\",\n      \"keyEvents\": [\"陆泽解说\", \"战术既视感\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"不可能的巧合\",\n      \"summary\": \"陆泽自我安慰：这只是巧合，曦曦那么柔弱，怎么可能是那个杀人不眨眼的“裁决者”。\",\n      \"keyEvents\": [\"陆泽自我洗脑\"],\n      \"characters\": [\"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"叛军的渗透\",\n      \"summary\": \"叛军利用选手在全息网络中植入精神病毒，试图控制观众。叶曦敏锐察觉网络波动。\",\n      \"keyEvents\": [\"精神病毒植入\", \"叶曦察觉异常\"],\n      \"characters\": [\"叶曦\", \"叛军\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"双重身份\",\n      \"summary\": \"叶曦在比赛间隙，利用精神力潜入网络后台，开始追踪病毒源。她的黑客代号“Z”浮出水面。\",\n      \"keyEvents\": [\"叶曦潜入后台\", \"黑客Z出现\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"网络攻防战\",\n      \"summary\": \"叶曦与叛军黑客在全息网络中展开激战，同时还要兼顾现实中的比赛。她开启多线程操作。\",\n      \"keyEvents\": [\"网络激战\", \"多线程操作\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"险胜与疲惫\",\n      \"summary\": \"叶曦成功阻断病毒传播，但精神力消耗巨大。下线后她脸色苍白，被陆泽误以为是吓到了。\",\n      \"keyEvents\": [\"阻断病毒\", \"叶曦疲惫\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"深夜的访客\",\n      \"summary\": \"陆泽心疼叶曦，守在她床边。叶曦在梦中呓语，喊出了军事代码。陆泽神色复杂。\",\n      \"keyEvents\": [\"叶曦说梦话\", \"陆泽起疑\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"半决赛的阴谋\",\n      \"summary\": \"叛军决定在半决赛直接抹杀叶曦，他们在比赛场景中埋伏了高等级的机械怪物。\",\n      \"keyEvents\": [\"叛军下杀手\", \"埋伏机械怪物\"],\n      \"characters\": [\"叶曦\", \"叛军\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"绝境求生\",\n      \"summary\": \"队友陷入绝境，叶曦不再保留，直接徒手撕裂了S级机械怪物。画面过于血腥被警告。\",\n      \"keyEvents\": [\"徒手撕怪\", \"画面警告\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"元帅的愤怒\",\n      \"summary\": \"陆泽看到叶曦在游戏中遇险，勃然大怒，下令军方调查赛事主办方，怀疑有恐怖袭击。\",\n      \"keyEvents\": [\"陆泽发怒\", \"军方介入\"],\n      \"characters\": [\"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"线索指向叛军\",\n      \"summary\": \"军方调查发现赛事数据异常，IP地址指向叛军控制区。陆泽开始警惕帝都内部的叛军间谍。\",\n      \"keyEvents\": [\"发现线索\", \"警惕间谍\"],\n      \"characters\": [\"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"叶曦的警告\",\n      \"summary\": \"叶曦暗示陆泽最近不要去人多的地方。陆泽以为她是撒娇，没有完全放在心上。\",\n      \"keyEvents\": [\"叶曦暗示\", \"陆泽忽视\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"决赛名单\",\n      \"summary\": \"叶曦凭借恐怖的战斗力和指挥能力，强势进入决赛。全网风向开始转变，出现大量“老婆粉”。\",\n      \"keyEvents\": [\"进入决赛\", \"风向转变\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"暗杀行动\",\n      \"summary\": \"叛军意识到无法在游戏中杀死叶曦，决定在现实中动手。陆泽前往军部途中遭遇伏击。\",\n      \"keyEvents\": [\"陆泽遇伏\", \"现实暗杀\"],\n      \"characters\": [\"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"影后的守护\",\n      \"summary\": \"叶曦通过监控发现伏击，她身穿黑衣，利用暗器远程协助陆泽反杀刺客，陆泽以为是援军到了。\",\n      \"keyEvents\": [\"叶曦暗中协助\", \"陆泽误判\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"受伤的保镖\",\n      \"summary\": \"叶曦在行动中受了轻伤，回家后偷偷包扎。陆泽发现她手指有伤，叶曦谎称是被纸划破的。\",\n      \"keyEvents\": [\"叶曦受伤\", \"拙劣借口\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"决赛前夜\",\n      \"summary\": \"全星际都在关注决赛。叛军首领决定在决赛直播时发动大规模网络攻击，瘫痪帝都防御。\",\n      \"keyEvents\": [\"全网关注\", \"叛军计划\"],\n      \"characters\": [\"叛军首领\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"最后的晚餐\",\n      \"summary\": \"陆泽为叶曦准备了烛光晚餐，承诺等比赛结束就带她去度假。叶曦预感到风雨欲来。\",\n      \"keyEvents\": [\"烛光晚餐\", \"叶曦预感\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"决赛开启\",\n      \"summary\": \"决赛在全星际直播，场景设定为古战场。叶曦一出场就气场全开，不再是那个唯唯诺诺的花瓶。\",\n      \"keyEvents\": [\"决赛开始\", \"气场全开\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"叛军动手\",\n      \"summary\": \"比赛进行到高潮，叛军同时发动现实袭击和网络攻击。帝都警报大作，全息网络陷入混乱。\",\n      \"keyEvents\": [\"袭击开始\", \"网络混乱\"],\n      \"characters\": [\"叛军\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"元帅出征\",\n      \"summary\": \"陆泽接到紧急军情，不得不离开直播现场前往指挥中心。他嘱咐叶曦待在安全舱不要动。\",\n      \"keyEvents\": [\"陆泽离开\", \"嘱咐叶曦\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"指挥中心被袭\",\n      \"summary\": \"叛军精锐部队突袭指挥中心，陆泽为了保护下属，身受重伤，被困在废墟中。\",\n      \"key受Number\": 35,\n      \"title\": \"指挥中心被袭\",\n      \"summary\": \"叛军精锐部队突袭指挥中心，陆泽为了保护下属，身受重伤，被困在废墟中。\",\n      \"keyEvents\": [\"指挥中心遇袭\", \"陆泽重伤\"],\n      \"characters\": [\"陆泽\", \"叛军\"]\n    },\n    {\n      \"chapterNumber\": 36,\n      \"title\": \"绝望的直播\",\n      \"summary\": \"全息网络接入了现实战场画面，全星际民众看到元帅倒下，陷入恐慌。叶曦在游戏中目睹了这一切。\",\n      \"keyEvents\": [\"画面接入\", \"全星际恐慌\"],\n      \"characters\": [\"叶曦\", \"陆泽\"]\n    },\n    {\n      \"chapterNumber\": 37,\n      \"title\": \"觉醒\",\n      \"summary\": \"叶曦眼神瞬间变得冰冷，她不再掩饰。她在游戏中直接强行登出，震碎了全息舱。\",\n      \"keyEvents\": [\"叶曦觉醒\", \"强行登出\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 38,\n      \"title\": \"取回装备\",\n      \"summary\": \"叶曦从密室中取出了尘封的光剑和联邦指挥官的战甲。那个柔弱的花瓶消失了，取而代之的是战神。\",\n      \"keyEvents\": [\"取出装备\", \"战神归来\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 39,\n      \"title\": \"降临战场\",\n      \"summary\": \"叶曦驾驶着私人飞船冲破天际，单枪匹马降落在指挥中心废墟前。叛军嘲笑又来一个送死的。\",\n      \"keyEvents\": [\"降临战场\", \"被嘲笑\"],\n      \"characters\": [\"叶曦\", \"叛军\"]\n    },\n    {\n      \"chapterNumber\": 40,\n      \"title\": \"动我的人？找死！\",\n      \"summary\": \"叶曦单手拎起光剑，剑气纵横。瞬间秒杀周围数十名叛军精锐。全场死寂。\",\n      \"keyEvents\": [\"光剑出鞘\", \"秒杀敌军\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 41,\n      \"title\": \"身份曝光\",\n      \"summary\": \"联邦的系统自动识别了叶曦的基因锁，弹出了最高权限认证：联邦第一指挥官“裁决者”。全星际炸了。\",\n      \"keyEvents\": [\"基因锁开启\", \"身份曝光\"],\n      \"characters\": [\"叶曦\"]\n    },\n    {\n      \"chapterNumber\": 42,\n      \"title\": \"全网震惊\",\n      \"summary\": \""
