  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：霓虹下的剧本\",\n      \"chapterRange\": \"第1-20章\",\n      \"summary\": \"陈诺降临赛博朋克世界，任务是感化垄断能源的暴君顾苍生。她接近原身主角林渊，试图修补剧情，却在不知不觉中落入顾苍生的精心算计。任务完成之际，并非解脱的开始，而是噩梦的序章。\",\n      \"plotPoints\": [\"陈诺进入世界，结识林渊与苏叶\", \"接触反派顾苍生，进行感化攻略\", \"顾苍生识破身份，暗中封锁世界\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：笼中鸟的逃离\",\n      \"chapterRange\": \"第21-40章\",\n      \"summary\": \"系统结算失败，顾苍生撕下伪装，利用“道种”芯片将陈诺囚禁。陈诺在林渊等人的帮助下，强行启动紧急穿越程序。世界崩塌，她逃入下一个位面，却发现顾苍生的执念已跨越时空紧随其后。\",\n      \"plotPoints\": [\"顾苍生黑化，揭露对陈诺的疯狂占有欲\", \"陈诺利用梦璃的力量寻找系统漏洞\", \"世界崩坏，陈诺狼狈逃亡至古代位面\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：暴君的猎场\",\n      \"chapterRange\": \"第41-60章\",\n      \"summary\": \"陈诺误以为逃入古代修真世界能暂避锋芒，却发现顾苍生的意识侵蚀了此世的暴君。时空壁垒破碎，三千世界开始融合。顾苍生化身修真魔尊，以生灵为祭，只为逼出陈诺的踪迹。\",\n      \"plotPoints\": [\"古代世界被顾苍生力量侵蚀\", \"配角以不同身份再次登场\", \"陈诺身份暴露，展开生死时速的逃亡\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：崩坏的迷宫\",\n      \"chapterRange\": \"第61-80章\",\n      \"summary\": \"世界彻底融合为“逃亡迷宫”，秩序不复存在。陈诺的记忆开始出现混乱，顾苍生不仅要在肉体上囚禁她，更要在精神上同化她。她必须在彻底沦陷前，找到管理局遗留的后门。\",\n      \"plotPoints\": [\"现实与剧情混淆，陈诺精神受创\", \"顾苍生力量指数级增长，掌控规则\", \"老鬼透露关于管理局核心的秘密\"]\n    },\n    {\n      \"actNumber\": 5,\n      \"actName\": \"第五幕：永恒的囚徒\",\n      \"chapterRange\": \"第81-100章\",\n      \"summary\": \"最终对决在破碎的高维空间展开。陈诺试图重启系统清除一切，顾苍生却选择与她一同坠入虚无。这是一场关于爱与毁灭的终极博弈，结局是彻底的占有，还是灵魂深处的自我囚禁？\",\n      \"plotPoints\": [\"陈诺集结残存力量发起反攻\", \"顾苍生打破最后一道防线\", \"结局：跨越维度的永恒囚禁\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"第001章 任务代号：暴君\",\n      \"summary\": \"高维修补师陈诺降临赛博世界，目标感化永恒集团创始人顾苍生。她初入贫民窟，偶遇正在捡垃圾的林渊。\",\n      \"keyEvents\": [\"陈诺激活系统\", \"遭遇街头混混\", \"林渊出手相助\"],\n      \"characters\": [\"陈诺\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"第002章 第13区的幸存者\",\n      \"summary\": \"陈诺为了接近剧情核心，跟随林渊回到第13区。她发现林渊手中的“道种”芯片竟是关键道具。\",\n      \"keyEvents\": [\"进入第13区\", \"发现芯片异常\", \"确立初步信任\"],\n      \"characters\": [\"陈诺\", \"林渊\", \"梦璃\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"第003章 霓虹城的阴影\",\n      \"summary\": \"陈诺通过林渊联系上地下医生苏叶。苏叶透露永恒集团正在进行活体实验，陈诺决定潜入。\",\n      \"keyEvents\": [\"前往地下诊所\", \"苏叶揭露黑幕\", \"制定潜入计划\"],\n      \"characters\": [\"陈诺\", \"苏叶\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"第004章 慈善晚宴的邀请函\",\n      \"summary\": \"为了获得接近顾苍生的机会，陈诺利用修补师权限制造契机，成功混入顾苍生举办的慈善晚宴。\",\n      \"keyEvents\": [\"获取邀请函\", \"潜入上流社会\", \"初见顾苍生\"],\n      \"characters\": [\"陈诺\", \"顾苍生\", \"蛇蝎\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"第005章 冰冷的审视\",\n      \"summary\": \"顾苍生表面上对陈诺感兴趣，实则眼神冰冷。蛇蝎察觉陈诺身份可疑，暗中试探。\",\n      \"keyEvents\": [\"与顾苍生周旋\", \"蛇蝎的刁难\", \"化解危机\"],\n      \"characters\": [\"陈诺\", \"顾苍生\", \"蛇蝎\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"第006章 执念的种子\",\n      \"summary\": \"陈诺开始执行攻略计划，试图温暖顾苍生。她发现顾苍生体内有一股异常强大的黑暗力量。\",\n      \"keyEvents\": [\"攻略开始\", \"察觉力量波动\", \"系统警告\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"第007章 被抛弃的利刃\",\n      \"summary\": \"陈诺在调查中遇见前特种兵雷烈。雷烈被顾苍生抛弃后心怀怨恨，成为陈诺的助力。\",\n      \"keyEvents\": [\"收服雷烈\", \"了解顾苍生过去\", \"建立同盟\"],\n      \"characters\": [\"陈诺\", \"雷烈\", \"苏叶\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"第008章 梦璃苏醒\",\n      \"summary\": \"林渊手中的芯片发生反应，古代AI梦璃苏醒。梦璃警告陈诺，顾苍生并非普通反派。\",\n      \"keyEvents\": [\"梦璃苏醒\", \"揭露世界真相\", \"危机感加重\"],\n      \"characters\": [\"林渊\", \"梦璃\", \"陈诺\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"第009章 执法局的精英\",\n      \"summary\": \"白夜探员调查连环失踪案，线索指向永恒集团。陈诺巧妙引导白夜，制造混乱以牵制顾苍生。\",\n      \"keyEvents\": [\"接触白夜\", \"引导舆论\", \"牵制顾苍生\"],\n      \"characters\": [\"陈诺\", \"白夜\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"第010章 感化的假象\",\n      \"summary\": \"在陈诺的努力下，顾苍生似乎流露出一丝人性。黑化值下降，系统提示任务即将完成。\",\n      \"keyEvents\": [\"黑化值下降\", \"顾苍生示弱\", \"陈诺放松警惕\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"第011章 贪财的情报贩子\",\n      \"summary\": \"陈诺向老鬼购买关于顾苍生核心机密的情报。老鬼神秘地暗示，顾苍生在等待一个人。\",\n      \"keyEvents\": [\"交易情报\", \"得到关键线索\", \"心生疑虑\"],\n      \"characters\": [\"陈诺\", \"老鬼\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"第012章 灵气能源的秘密\",\n      \"summary\": \"陈诺深入能源中心，发现顾苍生垄断的不仅是能源，更是世界的“本源”。他在以此养蛊。\",\n      \"keyEvents\": [\"潜入能源中心\", \"发现本源\", \"震惊真相\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"第013章 最后的温柔\",\n      \"summary\": \"顾苍生带陈诺参观他的私人收藏馆，那里全是关于“她”的画像。陈诺感到莫名的寒意。\",\n      \"keyEvents\": [\"参观收藏馆\", \"画像的冲击\", \"不安蔓延\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"第014章 系统的异常\",\n      \"summary\": \"系统频繁报错，提示剧情逻辑出现死循环。陈诺试图修复，却发现权限被锁死。\",\n      \"keyEvents\": [\"系统报错\", \"权限被锁\", \"无法脱离\"],\n      \"characters\": [\"陈诺\", \"梦璃\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"第015章 真正的猎手\",\n      \"summary\": \"任务进度显示99%。陈诺准备结算离开，却发现顾苍生早已站在她身后，露出了獠牙。\",\n      \"keyEvents\": [\"准备结算\", \"顾苍生现身\", \"身份暴露\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"第016章 撕碎时空\",\n      \"summary\": \"顾苍生不再伪装，直接动用执念力量撕碎空间。他宣称早已看穿剧本，只等陈诺自投罗网。\",\n      \"keyEvents\": [\"顾苍生黑化爆发\", \"空间撕裂\", \"绝望处境\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"第017章 笼中鸟\",\n      \"summary\": \"陈诺被顾苍生囚禁在永恒塔顶端。顾苍生试图给陈诺洗脑，让她永远属于这里。\",\n      \"keyEvents\": [\"被囚禁\", \"精神施压\", \"拒绝屈服\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"第018章 营救行动\",\n      \"summary\": \"林渊、雷烈、苏叶等人联手突袭永恒塔。梦璃利用AI能力干扰防御系统，为陈诺争取机会。\",\n      \"keyEvents\": [\"众人突袭\", \"梦璃干扰\", \"陈诺自救\"],\n      \"characters\": [\"林渊\", \"雷烈\", \"苏叶\", \"梦璃\", \"陈诺\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"第019章 代价惨重的逃离\",\n      \"summary\": \"陈诺强行启动紧急穿越程序。雷烈为掩护断后，生死未卜。陈诺在最后一刻跳入时空乱流。\",\n      \"keyEvents\": [\"启动穿越\", \"雷烈断后\", \"进入乱流\"],\n      \"characters\": [\"陈诺\", \"雷烈\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"第020章 追猎令\",\n      \"summary\": \"陈诺虽然逃脱，但世界开始崩塌。顾苍生立于废墟之上，发出跨越维度的追猎令。\",\n      \"keyEvents\": [\"世界崩塌\", \"发出追猎令\", \"进入下一幕\"],\n      \"characters\": [\"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"第021章 陌生的修真界\",\n      \"summary\": \"陈诺重伤坠落在古代修真世界。她失去了部分记忆，系统处于重启状态。\",\n      \"keyEvents\": [\"坠落修真界\", \"记忆受损\", \"系统重启\"],\n      \"characters\": [\"陈诺\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"第022章 魔尊的传说\",\n      \"summary\": \"此世被一位突然崛起的魔尊统治，其手段残忍酷似顾苍生。陈诺惊恐地发现魔尊竟是顾苍生的投影。\",\n      \"keyEvents\": [\"了解魔尊传说\", \"发现相似处\", \"恐惧再生\"],\n      \"characters\": [\"陈诺\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"第023章 旧识重逢\",\n      \"summary\": \"陈诺在修真界再次遇到转世的林渊（宗门弟子）和苏叶（医仙）。虽然容貌不同，但灵魂共鸣。\",\n      \"keyEvents\": [\"遇见转世林渊\", \"遇见转世苏叶\", \"建立新关系\"],\n      \"characters\": [\"陈诺\", \"林渊\", \"苏叶\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"第024章 蛇蝎女修\",\n      \"summary\": \"魔尊座下护法蛇蝎奉命搜捕异界灵魂。陈诺不得不隐藏身份，躲避追杀。\",\n      \"keyEvents\": [\"蛇蝎追杀\", \"隐藏身份\", \"惊险躲避\"],\n      \"characters\": [\"陈诺\", \"蛇蝎\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"第025章 扎根灵魂的芯片\",\n      \"summary\": \"梦璃的芯片与陈诺灵魂融合，梦璃警告顾苍生的执念正在侵蚀这个世界的法则。\",\n      \"keyEvents\": [\"芯片融合\", \"法则侵蚀\", \"危机预警\"],\n      \"characters\": [\"陈诺\", \"梦璃\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"第026章 执法天将白夜\",\n      \"summary\": \"此世的白夜是维护天道的天将。他察觉到陈诺身上的异样气息，开始暗中调查。\",\n      \"keyEvents\": [\"白夜调查\", \"气息暴露\", \"引起怀疑\"],\n      \"characters\": [\"陈诺\", \"白夜\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"第027章 魔尊的祭典\",\n      \"summary\": \"魔尊宣布举行血祭，要献祭全城生灵，只为逼出那个“逃跑的小老鼠”。\",\n      \"keyEvents\": [\"宣布血祭\", \"全城恐慌\", \"陈诺现身\"],\n      \"characters\": [\"顾苍生\", \"陈诺\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"第028章 正面交锋\",\n      \"summary\": \"陈诺为救苍生，不得不与魔尊（顾苍生）正面交锋。力量悬殊，她陷入苦战。\",\n      \"keyEvents\": [\"为救苍生\", \"正面交锋\", \"陷入苦战\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"第029章 想要毁掉你\",\n      \"summary\": \"顾苍生表示既然感化不了，那就毁掉陈诺珍视的一切。他当着陈诺的面屠杀无辜。\",\n      \"keyEvents\": [\"顾苍生暴行\", \"陈诺崩溃\", \"绝望升级\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"第030章 诡计多端的老鬼\",\n      \"summary\": \"修真界的情报贩子老鬼出现，告诉陈诺有一个传说中的“归墟”可以摆脱顾苍生。\",\n      \"keyEvents\": [\"老鬼出现\", \"透露归墟秘密\", \"新的希望\"],\n      \"characters\": [\"陈诺\", \"老鬼\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"第031章 前往归墟\",\n      \"summary\": \"陈诺带领众人前往归墟。途中遭遇蛇蝎和魔尊大军的围追堵截。\",\n      \"keyEvents\": [\"前往归墟\", \"遭遇围追\", \"艰难突围\"],\n      \"characters\": [\"陈诺\", \"林渊\", \"苏叶\", \"蛇蝎\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"第032章 雷烈的转世\",\n      \"summary\": \"在此世，雷烈是一名忠烈的护国将军。他为保护陈诺，再次战死。\",\n      \"keyEvents\": [\"遇见雷烈\", \"再次战死\", \"宿命悲剧\"],\n      \"characters\": [\"陈诺\", \"雷烈\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"第033章 感情的裂痕\",\n      \"summary\": \"陈诺因为连累众人而深感自责，林渊却表示无论如何都会守护她。\",\n      \"keyEvents\": [\"陈诺自责\", \"林渊安慰\", \"羁绊加深\"],\n      \"characters\": [\"陈诺\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"第034章 归墟的入口\",\n      \"summary\": \"众人终于抵达归墟入口，却发现这里早已被顾苍生布下天罗地网。\",\n      \"keyEvents\": [\"抵达归墟\", \"发现陷阱\", \"中计\"],\n      \"characters\": [\"陈诺\", \"顾苍生\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"第035章 世界的融合\",\n      \"summary\": \"顾苍生强行将修真界与赛博朋克世界的残骸融合，制造出一个混乱的“迷宫”。\",\n      \"keyEvents\": [\"世界融合\", \"迷宫形成\", \"秩序崩坏\