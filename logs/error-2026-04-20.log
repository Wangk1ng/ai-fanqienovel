  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：绝境逢生，初入雷区\",\n      \"chapterRange\": \"第1-20章\",\n      \"summary\": \"苏念确诊绝症绑定系统，锁定疯批资本家顾妄。她化身顶级绿茶接近顾妄，通过言语挑衅和“白莲花”行径初次收集怨气。顾妄对苏念产生兴趣，两人展开初次试探，苏念在危险边缘成功续命。\",\n      \"plotPoints\": [\"绑定系统，锁定目标\", \"初次交锋，收集怨气\", \"进入娱乐圈，引起注意\", \"绿茶演技，顾妄动怒\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：以爱为囚，步步惊心\",\n      \"chapterRange\": \"第21-40章\",\n      \"summary\": \"顾妄将苏念禁锢在身边，两人关系升温但充满火药味。苏念利用男二江驰刺激顾妄，导致顾妄嫉妒爆发。苏念在顾妄的雷区反复横跳，怨气值不断上涨，但顾妄的占有欲也愈发恐怖。\",\n      \"plotPoints\": [\"被顾妄掌控\", \"利用男二激怒男主\", \"顾妄黑化前兆\", \"苏念身体恶化\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：致命背叛，彻底决裂\",\n      \"chapterRange\": \"第41-60章\",\n      \"summary\": \"为了收集巨额怨气值续命，苏念策划了一场“惊天背叛”。她假意泄露商业机密并当众羞辱顾妄。顾妄彻底失控，将苏念死死囚禁，恨意手段残忍，苏命悬一线，系统任务进入倒计时。\",\n      \"plotPoints\": [\"策划背叛\", \"顾妄恨意滔天\", \"残酷囚禁\", \"生命垂危\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：真相大白，疯批救赎\",\n      \"chapterRange\": \"第61-80章\",\n      \"summary\": \"顾妄在折磨中发现苏念绝症的秘密，意识到她激怒自己的真相。恨意瞬间转化为绝望与悔恨。顾妄不惜一切代价寻找治疗方法，从“囚禁者”变为“守护者”，苏念在生死边缘感受到了顾妄扭曲的爱。\",\n      \"plotPoints\": [\"发现绝症诊断书\", \"真相揭露\", \"顾妄崩溃\", \"全力救治\"]\n    },\n    {\n      \"actNumber\": 5,\n      \"actName\": \"第五幕：至死方休，余生纠缠\",\n      \"chapterRange\": \"第81-100章\",\n      \"summary\": \"苏念手术成功，系统任务完成。两人解开心结，顾妄学会了正确的爱的方式，但依然保留了一丝疯批的占有欲。苏念原谅了顾妄，两人在娱乐圈的风雨中携手，达成救赎与共生的结局。\",\n      \"plotPoints\": [\"手术成功\", \"系统解绑\", \"情感和解\", \"终成眷属\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"绝症晚期与怨气系统\",\n      \"summary\": \"苏念收到绝症通知书，生命进入倒计时。绝望中绑定怨气收集系统，系统提示需激怒目标顾妄收集负面情绪续命。\",\n      \"keyEvents\": [\"确诊绝症\", \"绑定系统\"],\n      \"characters\": [\"苏念\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"目标：疯批资本家\",\n      \"summary\": \"系统锁定娱乐圈掌控者顾妄。苏念查阅资料，得知顾妄性格暴戾、喜怒无常，是完美的怨气库，决定主动出击。\",\n      \"keyEvents\": [\"锁定顾妄\", \"制定计划\"],\n      \"characters\": [\"苏念\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"名流宴会上的初遇\",\n      \"summary\": \"苏念盛装出席宴会，故意将红酒泼在顾妄昂贵的西装上。她施展顶级绿茶演技，无辜道歉并暗讽顾妄小气。\",\n      \"keyEvents\": [\"泼酒\", \"初次挑衅\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"第一笔怨气值\",\n      \"summary\": \"顾妄眼角抽搐，怒气值上升。苏念脑海响起系统提示音，生命值增加。她确信计划可行，更加大胆。\",\n      \"keyEvents\": [\"顾妄动怒\", \"收集怨气\"],\n      \"characters\": [\"苏念\", \"顾妄\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"顾妄的兴趣\",\n      \"summary\": \"顾妄没有惩罚苏念，反而觉得她有趣，命人调查她。苏念意识到顾妄的注意力被吸引，这正是她需要的。\",\n      \"keyEvents\": [\"顾妄调查\", \"引起注意\"],\n      \"characters\": [\"顾妄\", \"苏念\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"签约天启娱乐\",\n      \"summary\": \"苏念通过顾妄的娱乐公司面试，成为签约艺人。她故意在顾妄面前表现得贪慕虚荣，实则为了接近他。\",\n      \"keyEvents\": [\"进入娱乐圈\", \"接近目标\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"电梯里的“偶遇”\",\n      \"summary\": \"苏念制造电梯偶遇，假装害怕幽闭症，故意往顾妄怀里缩，却在下一秒嫌弃地推开他，指责他身上有烟味。\",\n      \"keyEvents\": [\"肢体接触\", \"言语嫌弃\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"雷区边缘试探\",\n      \"summary\": \"顾妄捏住苏念的下巴警告她。苏念虽然恐惧，但为了生命值，硬着头皮回视，眼中含泪，激起顾妄的施虐欲。\",\n      \"keyEvents\": [\"对峙\", \"情绪波动\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"系统的新任务\",\n      \"summary\": \"系统发布新任务：让顾妄产生嫉妒情绪。苏念将目光投向了当红小生江驰，决定利用他做挡箭牌。\",\n      \"keyEvents\": [\"发布任务\", \"寻找工具人\"],\n      \"characters\": [\"苏念\", \"系统\", \"江驰\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"片场暧昧\",\n      \"summary\": \"苏念在片场与江驰互动亲密，故意做戏给来视察的顾妄看。顾妄脸色阴沉，怨气值暴涨。\",\n      \"keyEvents\": [\"激将法\", \"顾妄嫉妒\"],\n      \"characters\": [\"苏念\", \"顾妄\", \"江驰\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"深夜的警告\",\n      \"summary\": \"顾妄将苏念堵在化妆间，质问她刚才的行为。苏念撒谎说喜欢江驰那种温柔型，暗讽顾妄是疯狗。\",\n      \"keyEvents\": [\"质问\", \"言语刺激\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"被搬进别墅\",\n      \"summary\": \"顾妄强行将苏念带回半山别墅，名义上是“培养”，实则是软禁。苏念意识到自己成了笼中鸟。\",\n      \"keyEvents\": [\"软禁\", \"入住别墅\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"金丝雀的日常\",\n      \"summary\": \"苏念在别墅中继续作妖，挑剔顾妄的收藏品，甚至在他的真迹上画乌龟。顾妄气得想杀人，却下不了手。\",\n      \"keyEvents\": [\"破坏藏品\", \"激怒升级\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"第一次身体不适\",\n      \"summary\": \"苏念因情绪激动导致身体剧痛，但她强忍着。顾妄察觉她的异样，却以为她是装的，冷嘲热讽。\",\n      \"keyEvents\": [\"病发\", \"误会加深\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"顾妄的“奖励”\",\n      \"summary\": \"顾妄带苏念参加拍卖会，送了她一条昂贵的项链，却要求她必须戴着，像狗链一样。苏念当众摔碎项链。\",\n      \"keyEvents\": [\"羞辱\", \"反抗\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"怨气值的狂欢\",\n      \"summary\": \"项链破碎瞬间，顾妄的怨气值达到新高。苏念感觉身体轻松了许多，但顾妄的眼神变得极度危险。\",\n      \"keyEvents\": [\"收集大量怨气\", \"顾妄黑化\"],\n      \"characters\": [\"苏念\", \"顾妄\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"雨夜的惩罚\",\n      \"summary\": \"顾妄将苏念关在露台淋雨，惩罚她的不识抬举。苏念在雨中瑟瑟发抖，心中默念系统倒计时。\",\n      \"keyEvents\": [\"淋雨惩罚\", \"身体透支\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"发烧与照顾\",\n      \"summary\": \"苏念高烧昏迷。顾妄虽然生气，但不想她死，叫来医生。苏念醒来后继续冷言冷语，感谢他的“折磨”。\",\n      \"keyEvents\": [\"生病\", \"复杂情感\"],\n      \"characters\": [\"苏念\", \"顾妄\", \"医生\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"江驰的探望\",\n      \"summary\": \"江驰得知消息来探望苏念，被顾妄拦下。苏念在楼上喊江驰的名字，顾妄嫉妒得发狂，强行上楼。\",\n      \"keyEvents\": [\"男二探望\", \"嫉妒爆发\"],\n      \"characters\": [\"苏念\", \"顾妄\", \"江驰\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"第一幕终章：危险的平衡\",\n      \"summary\": \"顾妄警告苏念不要再想别的男人。苏念表面答应，内心却在策划更大的背叛，因为生命值再次告急。\",\n      \"keyEvents\": [\"警告\", \"策划下一步\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"系统发布S级任务\",\n      \"summary\": \"生命值仅剩三天，系统发布S级任务：让顾妄产生“绝望与恨意交织”的极致情绪。苏念决定出卖顾妄的商业机密。\",\n      \"keyEvents\": [\"生命告急\", \"S级任务\"],\n      \"characters\": [\"苏念\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"窃取机密\",\n      \"summary\": \"苏念利用顾妄对她的松懈，潜入书房偷拍核心项目文件。顾妄突然回家，苏念惊险躲过。\",\n      \"keyEvents\": [\"窃取文件\", \"惊险时刻\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"虚假的温情\",\n      \"summary\": \"为了降低顾妄的防备，苏念开始扮演“乖巧情人”，给顾妄做饭，甚至主动拥抱。顾妄虽然怀疑，但享受这片刻温存。\",\n      \"keyEvents\": [\"绿茶演技\", \"降低防备\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"顾妄的动摇\",\n      \"summary\": \"顾妄看着温顺的苏念，心中生出一丝异样的感觉，甚至想过放过她，给她真正的名分。\",\n      \"keyEvents\": [\"动心\", \"犹豫\"],\n      \"characters\": [\"顾妄\", \"苏念\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"背叛的前夜\",\n      \"summary\": \"苏念将机密发送给顾妄的死对头。系统提示任务即将完成。苏念看着熟睡的顾妄，眼中闪过一丝不忍，随即被求生欲压过。\",\n      \"keyEvents\": [\"发送机密\", \"内心挣扎\"],\n      \"characters\": [\"苏念\", \"顾妄\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"庆功宴上的炸弹\",\n      \"summary\": \"顾妄的新品发布会，机密被泄露，现场一片混乱。顾妄第一时间看向苏念，却发现她不见了。\",\n      \"keyEvents\": [\"机密泄露\", \"寻找苏念\"],\n      \"characters\": [\"顾妄\", \"苏念\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"留下的信\",\n      \"summary\": \"顾妄回到别墅，只看到苏念留下的一封信。信中极尽嘲讽，称他只是个垫脚石，她从未爱过他。\",\n      \"keyEvents\": [\"发现信件\", \"被羞辱\"],\n      \"characters\": [\"顾妄\", \"苏念\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"全城搜捕\",\n      \"summary\": \"顾妄彻底疯魔，封锁全城寻找苏念。他的怨气值突破天际，苏念在躲藏处感受到了生命力的回流。\",\n      \"keyEvents\": [\"全城搜捕\", \"怨气爆发\"],\n      \"characters\": [\"顾妄\", \"苏念\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"躲藏的角落\",\n      \"summary\": \"苏念躲在廉价旅馆，身体因绝症痛苦不堪。她看着手机上顾妄的疯狂新闻，知道自己成功了，也完了。\",\n      \"keyEvents\": [\"躲藏\", \"病痛折磨\"],\n      \"characters\": [\"苏念\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"被抓现行\",\n      \"summary\": \"顾妄的人马找到了苏念。顾妄亲自出现，眼神如恶鬼，掐住苏念的脖子，问她有没有心。\",\n      \"keyEvents\": [\"被抓\", \"对峙\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"真正的囚禁\",\n      \"summary\": \"苏念被带回别墅，这次是真正的囚禁。门窗被封死，脚链加身。顾妄不再是那个金主，而是狱卒。\",\n      \"keyEvents\": [\"加脚链\", \"囚禁升级\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"恨意宣泄\",\n      \"summary\": \"顾妄在苏念身上发泄恨意，言语羞辱，行为粗暴。苏念默默承受，因为系统提示生命值已满，甚至可以延长寿命。\",\n      \"keyEvents\": [\"发泄恨意\", \"生命值满\"],\n      \"characters\": [\"苏念\", \"顾妄\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"想死？下辈子吧\",\n      \"summary\": \"苏念试图绝食求死，觉得任务完成了该离开了。顾妄强行喂食，红着眼眶吼出那句经典台词。\",\n      \"keyEvents\": [\"绝食\", \"强行喂食\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"系统的警告\",\n      \"summary\": \"系统警告：顾妄的情绪过于极端，可能导致宿主精神崩溃。苏念开始出现幻觉，分不清现实与演戏。\",\n      \"keyEvents\": [\"精神崩溃\", \"系统警告\"],\n      \"characters\": [\"苏念\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"顾妄的温柔刀\",\n      \"summary\": \"顾妄突然转变态度，变得极度温柔，带苏念看海，仿佛什么都没发生。苏念感到毛骨悚然，这是死刑前的狂欢。\",\n      \"keyEvents\": [\"假意温柔\", \"心理恐惧\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 36,\n      \"title\": \"最后的羞辱\",\n      \"summary\": \"顾妄带苏念去参加慈善晚宴，当众宣布她是他的“金丝雀”，没有任何尊严。苏念配合演出，内心已死。\",\n      \"keyEvents\": [\"公开羞辱\", \"自尊破碎\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 37,\n      \"title\": \"江驰的营救计划\",\n      \"summary\": \"江驰得知苏念处境，试图联合顾妄的竞争对手营救。苏念通过系统得知消息，却拒绝配合，因为她不想连累无辜。\",\n      \"keyEvents\": [\"营救计划\", \"拒绝配合\"],\n      \"characters\": [\"苏念\", \"江驰\", \"系统\"]\n    },\n    {\n      \"chapterNumber\": 38,\n      \"title\": \"顾妄的察觉\",\n      \"summary\": \"顾妄发现了江驰的小动作，更加确信苏念是“身在曹营心在汉”。他的恨意再次叠加，对苏念的看管更严。\",\n      \"keyEvents\": [\"发现端倪\", \"看管加严\"],\n      \"characters\": [\"顾妄\", \"苏念\"]\n    },\n    {\n      \"chapterNumber\": 39,\n      \"title\": \"苏念的崩溃\",\n      \"summary\": \"长期的折磨和绝症痛苦让苏念彻底崩溃。她哭着求顾妄杀了她，承认自己是个骗子，只求解脱。\",\n      \"keyEvents\": [\"精神崩溃\", \"求死\"],\n      \"characters\": [\"苏念\", \"顾妄\"]\n    },\n    {\n      \"chapterNumber\": 40,\n      \"title\": \"第二幕终章：无法逃离的网\",\n      \"summary"
}
