  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：垃圾星的疯犬\",\n      \"chapterRange\": \"第1-10章\",\n      \"summary\": \"楚瑶在垃圾星捡到精神力暴走的元帅霍渊，用灵植果暂时安抚了他。两人为了生存联手对抗当地暴徒，霍渊在杀戮中逐渐对楚瑶产生依赖，最终护送楚瑶离开垃圾星前往文明世界。\",\n      \"plotPoints\": [\"捡到濒死元帅并喂食\", \"霍渊展现疯批战力护主\", \"夺取飞船逃离垃圾星\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：全星际的馋虫\",\n      \"chapterRange\": \"第11-20章\",\n      \"summary\": \"抵达边境星，楚瑶通过售卖真实食物引起轰动，被称为“神之味”。霍渊恢复部分记忆暗中保护，两人遭遇贵族打压与联邦探子窥探，霍渊不再掩饰杀意，震慑宵小。\",\n      \"plotPoints\": [\"真实食物引爆网络\", \"霍渊暗中清理威胁\", \"初次遭遇联邦特工\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：联邦的猎杀\",\n      \"chapterRange\": \"第21-30章\",\n      \"summary\": \"联邦高层发现灵植能净化精神力，意图切片研究楚瑶。霍渊身份曝光，带楚瑶回归帝国。面对联邦的暗杀与贵族的嘲讽，霍渊当众宣誓主权，楚瑶开启净化计划。\",\n      \"plotPoints\": [\"联邦下达切片通缉令\", \"霍渊恢复帝帅身份\", \"帝国宴会打脸贵族\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：废土的生机\",\n      \"chapterRange\": \"第31-40章\",\n      \"summary\": \"星际粮荒与精神力崩溃加剧，楚瑶建立灵植基地，大规模生产粮食与净化剂。联邦发动突袭，霍渊精神力再次暴走，楚瑶用高级灵植彻底治愈并唤醒深层力量，双方全面开战。\",\n      \"plotPoints\": [\"建立灵植基地\", \"霍渊精神力彻底治愈\", \"联邦突袭基地\"]\n    },\n    {\n      \"actNumber\": 5,\n      \"actName\": \"第五幕：新世界的神女\",\n      \"chapterRange\": \"第41-50章\",\n      \"summary\": \"霍渊与楚瑶率领帝国军反攻联邦，揭露联邦高层囤积资源、制造污染的真相。楚瑶种植世界树净化星际，推翻旧政权，重塑秩序，两人举行星际大婚。\",\n      \"plotPoints\": [\"反攻联邦首都星\", \"揭露联邦黑暗真相\", \"种植世界树净化星际\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"垃圾堆里的疯狗\",\n      \"summary\": \"楚瑶在垃圾星捡破烂时被一个浑身是血的男人咬住手腕，认出对方是全网黑的疯批元帅霍渊，反手塞给他一颗灵植果。\",\n      \"keyEvents\": [\"楚瑶捡到濒死霍渊\", \"喂食灵植果安抚\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"别咬人，吃果子\",\n      \"summary\": \"霍渊吃下果子后精神稍缓，但依然处于野兽状态，死死盯着楚瑶。楚瑶无奈将他带回破旧避难所，用空间里的水帮他清洗伤口。\",\n      \"keyEvents\": [\"霍渊暂时平复\", \"楚瑶带霍渊回避难所\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"他的精神海在咆哮\",\n      \"summary\": \"霍渊精神力反噬，痛苦难忍。楚瑶利用空间里的薄荷草煮水，意外发现能安抚精神海。霍渊第一次对人类产生了不是杀意的情绪。\",\n      \"keyEvents\": [\"霍渊精神力反噬\", \"薄荷水安抚成功\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"废土上的第一顿饭\",\n      \"summary\": \"楚瑶用空间里的一颗番茄做了简单的汤面。霍渊被食物的味道唤醒理智，狼吞虎咽。他意识到这个女人是珍贵的“资源”。\",\n      \"keyEvents\": [\"霍渊恢复部分理智\", \"霍渊视楚瑶为私有物\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"谁敢动她\",\n      \"summary\": \"当地拾荒者小队看中楚瑶的“物资”上门抢劫。霍渊瞬间化身修罗，徒手撕碎小队，手段残忍至极，楚瑶却只关心他有没有受伤。\",\n      \"keyEvents\": [\"拾荒者抢劫\", \"霍渊展现疯批战力\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"拾荒者小队\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"他是一条疯狗\",\n      \"summary\": \"霍渊杀完人后浑身戾气，眼神空洞。楚瑶没有害怕，再次喂食灵植果，并摸头安抚。霍渊彻底沦陷，决定做她一个人的狗。\",\n      \"keyEvents\": [\"楚瑶安抚杀后的霍渊\", \"霍渊确立忠犬雏形\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"寻找离开的飞船\",\n      \"summary\": \"垃圾星即将发生磁暴，必须尽快离开。两人前往废墟深处寻找可用的飞船零件。途中遭遇变异兽袭击，霍渊肉身挡刀。\",\n      \"keyEvents\": [\"寻找飞船零件\", \"霍渊肉身挡变异兽\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"空间升级了\",\n      \"summary\": \"楚瑶利用战斗间隙吸收了环境中的微弱能量，随身空间升级，解锁了初级防御罩和水稻种子。她用防御罩救了霍渊一命。\",\n      \"keyEvents\": [\"空间吸收能量升级\", \"解锁水稻种子\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"抢夺巡逻艇\",\n      \"summary\": \"两人发现一艘联邦坠毁的巡逻艇。联邦先遣队已赶到。霍渊在楚瑶的指挥下，利用地形和陷阱，全副武装夺取了巡逻艇。\",\n      \"keyEvents\": [\"发现联邦巡逻艇\", \"夺取飞船\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"联邦先遣队\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"起航，前往文明世界\",\n      \"summary\": \"霍渊驾驶飞船冲出垃圾星大气层。楚瑶看着星空，决定在这个崩坏的世界种出希望。霍渊看着她的侧脸，眼神晦暗不明。\",\n      \"keyEvents\": [\"成功逃离垃圾星\", \"确立前往文明世界目标\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"边境星黑市\",\n      \"summary\": \"抵达混乱的中立星域。霍渊戴着面具隐瞒身份，楚瑶去黑市出售从垃圾星捡来的高级金属，顺便购买了一些基础生活用品。\",\n      \"keyEvents\": [\"抵达边境星\", \"黑市交易\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"一碗白米饭的诱惑\",\n      \"summary\": \"楚瑶在路边摊煮了一锅真正的白米饭。米饭的香气瞬间引爆了整条街，长期吃营养液的星际人像丧尸一样围了过来。\",\n      \"keyEvents\": [\"煮白米饭\", \"香气引爆街道\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"路人群众\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"天价一碗饭\",\n      \"summary\": \"楚瑶开始售卖“灵米饭”，价格高昂却供不应求。霍渊在旁边冷脸维持秩序，谁敢插队就断谁的手指。\",\n      \"keyEvents\": [\"高价售卖灵米饭\", \"霍渊维持秩序\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"全星际直播\",\n      \"summary\": \"有人直播了吃饭的过程，全网沸腾。网友疯狂嘲讽是假道具，直到直播主吃下后基因锁松动，精神力暴涨。\",\n      \"keyEvents\": [\"吃饭过程被直播\", \"全网质疑与反转\"],\n      \"characters\": [\"楚瑶\", \"直播主\", \"网友\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"贵族少爷的觊觎\",\n      \"summary\": \"当地落魄贵族少爷看上了楚瑶的美貌和“秘方”，派人强行掳人。霍渊感知到危险，眼神瞬间变得嗜血。\",\n      \"keyEvents\": [\"贵族少爷觊觎\", \"霍渊感知杀意\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"贵族少爷\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"半夜的敲门声\",\n      \"summary\": \"贵族少爷带人深夜强闯。霍渊没有用机甲，只用一把匕首，在黑暗中将所有人无声无息地解决，手段令人胆寒。\",\n      \"keyEvents\": [\"贵族少爷强闯\", \"霍渊匕首灭杀\"],\n      \"characters\": [\"霍渊\", \"贵族少爷\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"联邦的调查员\",\n      \"summary\": \"联邦异能管理局注意到了边境星的异常能量波动，派出调查员。霍渊敏锐地察觉到了官方的气息，拉着楚瑶转移。\",\n      \"keyEvents\": [\"联邦派出调查员\", \"紧急转移\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"联邦调查员\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"他在隐瞒什么\",\n      \"summary\": \"楚瑶发现霍渊对联邦的军事基地异常熟悉。霍渊坦白自己曾是军人，但隐瞒了元帅身份。楚瑶表示不管他是谁，只认他。\",\n      \"keyEvents\": [\"霍渊坦白部分身份\", \"两人情感升温\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"第一桶金与声望\",\n      \"summary\": \"楚瑶利用赚来的星币购买了一块荒地，准备建立农场。系统的声望值开启，她获得了“净化番茄”的种子。\",\n      \"keyEvents\": [\"购买荒地\", \"获得净化番茄种子\"],\n      \"characters\": [\"楚瑶\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"风暴前夕\",\n      \"summary\": \"联邦调查员查到了贵族少爷的死状，确认是S级以上精神力者所为。联邦高层怀疑失踪的霍渊就在附近，封锁了星域。\",\n      \"keyEvents\": [\"联邦封锁星域\", \"怀疑霍渊行踪\"],\n      \"characters\": [\"联邦高层\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"无路可退\",\n      \"summary\": \"联邦舰队包围了边境星。霍渊决定不再躲藏，他联系了帝国残部。一艘帝国私人战舰突破封锁线接应。\",\n      \"keyEvents\": [\"联邦舰队包围\", \"帝国战舰接应\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"帝国副官\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"他是帝国元帅\",\n      \"summary\": \"登上战舰后，霍渊摘下面具。帝国副官跪地高呼“元帅”。楚瑶震惊，但随即被霍渊紧紧抱住，生怕她离开。\",\n      \"keyEvents\": [\"霍渊暴露元帅身份\", \"楚瑶得知真相\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"帝国副官\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"帝都的嘲笑\",\n      \"summary\": \"回到帝国首都，霍渊带楚瑶出席皇室会议。皇室和贵族嘲笑霍渊捡了个垃圾星回来的平民，甚至有人提议将楚瑶送给联邦换和平。\",\n      \"keyEvents\": [\"出席皇室会议\", \"贵族嘲笑楚瑶\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"帝国皇室\", \"帝国贵族\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"谁敢动她试试\",\n      \"summary\": \"霍渊当场暴怒，精神力威压震碎会议桌。他当众宣布楚瑶是他的伴侣，动她就是向帝国宣战。全场死寂。\",\n      \"keyEvents\": [\"霍渊精神威压全场\", \"宣布伴侣关系\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"帝国皇室\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"联邦的通缉令\",\n      \"summary\": \"联邦得知霍渊回归，立刻向全星际发布通缉令，污蔑楚瑶是“携带生化病毒的恐怖分子”，要求各国交出切片研究。\",\n      \"keyEvents\": [\"联邦发布通缉令\", \"污蔑楚瑶\"],\n      \"characters\": [\"联邦高层\", \"楚瑶\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"我要种田\",\n      \"summary\": \"面对政治压力，楚瑶懒得理会，在霍渊划拨的军事禁区开始种田。她种下净化番茄，准备在即将到来的皇室宴会上展示。\",\n      \"keyEvents\": [\"楚瑶在禁区种田\", \"准备净化番茄\"],\n      \"characters\": [\"楚瑶\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"皇室晚宴\",\n      \"summary\": \"皇室晚宴举行，联邦间谍混入。楚瑶一身素衣出席，端出一盘红艳艳的番茄。贵族们嗤之以鼻，却不知这是救命药。\",\n      \"keyEvents\": [\"参加皇室晚宴\", \"展示净化番茄\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"联邦间谍\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"神迹降临\",\n      \"summary\": \"帝国皇帝因精神力枯竭当场病发。楚瑶喂食番茄，瞬间治愈了皇帝。全场哗然，楚瑶从“平民”变成了“神女”。\",\n      \"keyEvents\": [\"皇帝病发\", \"楚瑶当场治愈\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"帝国皇帝\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"联邦的暗杀\",\n      \"summary\": \"联邦见势不妙，命令潜伏的刺客强行抢人。霍渊早已布下天罗地网，将刺客全部歼灭，并抓了活口。\",\n      \"keyEvents\": [\"联邦刺客抢人\", \"霍渊反杀抓活口\"],\n      \"characters\": [\"楚瑶\", \"霍渊\", \"联邦刺客\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"全面备战\",\n      \"summary\": \"从活口口中得知联邦计划发动全面战争并投放污染炸弹。霍渊向帝国议会申请战时指挥权，楚瑶决定大规模开放灵植种植。\",\n      \"keyEvents\": [\"得知联邦战争计划\", \"霍渊申请指挥权\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"灵植基地建立\",\n      \"summary\": \"楚瑶在帝都郊区建立“希望基地”。大量平民和低等贵族排队求购灵植。声望值暴涨，空间升级至3级，解锁“空气净化树”。\",\n      \"keyEvents\": [\"建立希望基地\", \"空间升级解锁净气树\"],\n      \"characters\": [\"楚瑶\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"粮荒爆发\",\n      \"summary\": \"联邦切断星际粮道，数个星球发生暴乱。楚瑶开启直播，演示如何种植灵植，并免费发放第一批种子，安抚了民心。\",\n      \"keyEvents\": [\"星际粮荒\", \"楚瑶直播教学\"],\n      \"characters\": [\"楚瑶\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"污染炸弹降临\",\n      \"summary\": \"联邦丧心病狂向帝国边境投放高浓度污染弹。霍渊驾驶机甲单枪匹马拦截，虽成功但精神力再次濒临崩溃。\",\n      \"keyEvents\": [\"联邦投放污染弹\", \"霍渊拦截受伤\"],\n      \"characters\": [\"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"喂一口，救救我\",\n      \"summary\": \"霍渊浑身是血地回到基地，精神海彻底崩坏，即将变成怪物。他求楚瑶杀了他，楚瑶却吻上他，喂下最高级的“生命之果”。\",\n      \"keyEvents\": [\"霍渊精神力崩溃\", \"楚瑶喂食生命之果\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"SSS级精神力\",\n      \"summary\": \"霍渊不仅没疯，反而突破瓶颈，觉醒了传说中的SSS级神级精神力，可以直接沟通天地元素。他比以前更疯，但只对楚瑶温柔。\",\n      \"keyEvents\": [\"霍渊突破至SSS级\", \"完全掌控精神力\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 36,\n      \"title\": \"反攻的号角\",\n      \"summary\": \"霍渊率领帝国第一军团反攻联邦被占领的星域。楚瑶制作的“净化雾剂”成为战略物资，让联邦的污染武器失效。\",\n      \"keyEvents\": [\"帝国反攻\", \"净化雾剂失效污染武器\"],\n      \"characters\": [\"楚瑶\", \"霍渊\"]\n    },\n    {\n      \"chapterNumber\": 37,\n      \"title\": \"联邦的生化士兵\",\n      \"summary\": \"联邦为了对抗霍渊，秘密注射药剂制造了不受控制的狂躁士兵军团。"
}
