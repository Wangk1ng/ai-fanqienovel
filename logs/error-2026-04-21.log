  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：寒门崛起，弹幕初现\",\n      \"chapterRange\": \"第1-8章\",\n      \"summary\": \"苏云策穿越成大梁寒门书生，面对即将到来的县试和死板的八股文束手无策。关键时刻觉醒“万界弹幕系统”，在现代网友的吐槽和提示下，他开始尝试用后现代逻辑解构儒家经典，在县试中初露锋芒，震惊考官。\",\n      \"plotPoints\": [\"觉醒系统，初次尝试利用弹幕破题\", \"县试考场遭遇刁难，用现代逻辑反击\", \"考官震怒后被折服，夺得案首\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：府试扬名，舌经战儒\",\n      \"chapterRange\": \"第9-18章\",\n      \"summary\": \"苏云策前往府城参加府试，面对世家子弟的挑衅和更高级别的考官。他利用系统兑换的初级现代知识，在策论中提出“经世致用”的务实观点，将枯燥的考场变成了个人辩论秀场，名声初显。\",\n      \"plotPoints\": [\"遭遇世家子弟赵无极的挑衅\", \"府试策论题，弹幕提供农桑新解\", \"当众辩论，用科学常识打脸守旧派\", \"府试第一，获得“人气值”兑换新知识\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：乡试风波，经世致用\",\n      \"chapterRange\": \"第19-26章\",\n      \"summary\": \"乡试（秋闱）开启，全省精英云集。守旧派考官联手针对苏云策，试图在阅卷环节做手脚。苏云策在贡院中利用弹幕提示的“地缘政治”与“经济杠杆”理论，写出惊世骇俗的文章，引发朝堂震动。\",\n      \"plotPoints\": [\"贡院内的恶劣环境与心理战\", \"乡试题目涉及治水，弹幕狂刷水利知识\", \"阅卷房内考官激辩，文章惊动主考官\", \"成功中举，成为解元，引发舆论风暴\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：殿试夺魁，震古烁今\",\n      \"chapterRange\": \"第27-34章\",\n      \"summary\": \"苏云策入京参加会试与殿试，直面皇帝与天下大儒。他利用系统积攒的巨大人气值兑换超前治国理念，在金銮殿上舌战群儒，痛陈时弊。最终皇帝钦点状元，苏云策开启新政，打破大梁僵局。\",\n      \"plotPoints\": [\"会试中遭遇暗杀与陷害，系统预警化险为夷\", \"殿试策问，提出“法治”与“民权”雏形\", \"当朝大儒联合围剿，被弹幕教做人\", \"皇帝力排众议点状元，苏云策开启改革时代\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"穿越大梁，八股文的噩梦\",\n      \"summary\": \"现代辩论天才苏云策穿越成大梁寒门书生，家徒四壁，明日便是县试。面对死板的八股文题目，他毫无头绪，绝望之际，眼前突然浮现出滚动的文字。\",\n      \"keyEvents\": [\"苏云策穿越，了解处境\", \"面对县试题目束手无策\", \"万界弹幕系统觉醒\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"这题我会！弹幕狂刷屏\",\n      \"summary\": \"系统界面出现，无数现代网友开始吐槽八股文的荒谬。弹幕提示题目逻辑漏洞，并提供了现代辩论的切入点。苏云策尝试用后现代逻辑破题，下笔如有神。\",\n      \"keyEvents\": [\"网友弹幕吐槽八股文\", \"苏云策获得逻辑漏洞提示\", \"尝试用新思维写出第一篇破题文章\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"县试考场，寒门受辱\",\n      \"summary\": \"苏云策前往县衙参加县试，因衣着寒酸被世家子弟赵无极羞辱。考官王夫子是守旧派，对苏云策这种寒门学子带有偏见，考场气氛压抑。\",\n      \"keyEvents\": [\"入场被赵无极羞辱\", \"考官王夫子偏见明显\", \"苏云策进入考场，系统提示直播开启\"],\n      \"characters\": [\"苏云策\", \"王夫子\", \"赵无极\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"离经叛道？这是逻辑闭环！\",\n      \"summary\": \"县试题目为“唯女子与小人为难养也”。众考生皆在附和，苏云策却在弹幕的煽动下，从社会分工与人性角度猛烈抨击此观点，写出一篇惊世骇俗的“驳论”。\",\n      \"keyEvents\": [\"看到歧视性考题\", \"弹幕提供现代平权思想\", \"写出反驳圣人的文章\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"考官震怒：你敢非议圣人？\",\n      \"summary\": \"王夫子阅卷时大怒，认为苏云策离经叛道，要当众撕毁试卷并逐出考场。苏云策不卑不亢，请求当众辩论。弹幕瞬间沸腾，人气值飙升。\",\n      \"keyEvents\": [\"王夫子大怒欲撕卷\", \"苏云策请求辩论\", \"弹幕活跃度暴涨\"],\n      \"characters\": [\"苏云策\", \"王夫子\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"舌战王夫子，降维打击\",\n      \"summary\": \"苏云策利用弹幕提供的逻辑陷阱，将王夫子的教条言论逼入死角。他用“实事求是”的逻辑，将王夫子驳得哑口无言，全场考生目瞪口呆。\",\n      \"keyEvents\": [\"苏云策开启辩论模式\", \"利用逻辑陷阱反驳王夫子\", \"王夫子被驳倒，哑口无言\"],\n      \"characters\": [\"苏云策\", \"王夫子\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"县试案首，初露锋芒\",\n      \"summary\": \"王夫子虽不甘心，但被苏云策的才华折服，不得不将其列为案首（第一名）。苏云策获得大量人气值，兑换了“基础数学”与“物理常识”。\",\n      \"keyEvents\": [\"被钦点为案首\", \"赵无极嫉妒\", \"兑换初级现代知识\"],\n      \"characters\": [\"苏云策\", \"王夫子\", \"赵无极\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"赵家报复，街头对峙\",\n      \"summary\": \"赵无极因落榜心生怨恨，带家丁在街头围堵苏云策。苏云策利用兑换的物理力学知识，巧用杠杆原理以弱胜强，教训了赵家恶奴，再次引发围观。\",\n      \"keyEvents\": [\"赵无极带人报复\", \"苏云策运用物理知识反击\", \"以弱胜强，名声传开\"],\n      \"characters\": [\"苏云策\", \"赵无极\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"奔赴府城，路见不平\",\n      \"summary\": \"苏云策前往府城备考，途中遇到因赋税过重而流离失所的百姓。弹幕刷屏吐槽古代税制，苏云策深受触动，决定在接下来的考试中关注民生。\",\n      \"keyEvents\": [\"前往府城\", \"目睹百姓疾苦\", \"弹幕科普现代税制\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"府试风云，才子聚会\",\n      \"summary\": \"抵达府城，各方才子云集。府试主考官是出了名的“铁面判官”，极度厌恶空谈。苏云策在诗会上，用现代意象写出“朦胧诗”，震惊四座。\",\n      \"keyEvents\": [\"参加才子诗会\", \"用现代朦胧诗技惊四座\", \"引起主考官注意\"],\n      \"characters\": [\"苏云策\", \"主考官\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"府试策论，农桑之本\",\n      \"summary\": \"府试考题发布，问“农桑之本”。众考生皆在引经据典，歌颂尧舜。苏云策在弹幕提示下，从育种、化肥角度切入，提出“科学种田”。\",\n      \"keyEvents\": [\"发布府试考题\", \"众考生空谈义理\", \"苏云策准备写科学种田方案\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"奇谈怪论？产量说话！\",\n      \"summary\": \"苏云策在试卷中详细阐述了选种法与堆肥技术，考官们看后大皱眉头，认为这是“奇技淫巧”。然而副主考官是务实派，对此大感兴趣。\",\n      \"keyEvents\": [\"试卷内容被视为奇技淫巧\", \"副考官表现出兴趣\", \"务实派与守旧派产生分歧\"],\n      \"characters\": [\"苏云策\", \"主考官\", \"副考官\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"覆核环节，当众验证\",\n      \"summary\": \"为了证明自己不是胡言乱语，苏云策申请当庭演示。他利用兑换的生物知识，指出府衙后花园作物生长的弊端，并预言三日后的虫害。\",\n      \"keyEvents\": [\"申请当庭演示\", \"指出府衙作物问题\", \"预言虫害发生\"],\n      \"characters\": [\"苏云策\", \"主考官\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"预言成真，考官折服\",\n      \"summary\": \"三日后，虫害如期爆发，府衙损失惨重，唯独苏云策处理过的几株作物安然无恙。主考官震惊，亲自拜访苏云策，态度大变。\",\n      \"keyEvents\": [\"虫害爆发验证预言\", \"主考官态度转变\", \"苏云策获得认可\"],\n      \"characters\": [\"苏云策\", \"主考官\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"府试第一，名动一府\",\n      \"summary\": \"苏云策毫无悬念地夺得府试第一。他的“科学种田”文章被传抄，引发士绅阶层的热议，有人骂他是异端，有人视他为救星。\",\n      \"keyEvents\": [\"夺得府试第一\", \"文章被广泛传抄\", \"引发社会舆论争议\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"兑换奖励，工业萌芽\",\n      \"summary\": \"凭借极高的人气值，苏云策兑换了“初级炼钢术”和“火药配方”。他意识到，光靠文章无法改变世界，必须要有硬实力。\",\n      \"keyEvents\": [\"人气值大涨\", \"兑换工业技术知识\", \"意识到武力的重要性\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"乡试前夕，暗流涌动\",\n      \"summary\": \"乡试（秋闱）在即，京城派下来的学政大人极度守旧。赵家勾结学政，准备在乡试中做掉苏云策。弹幕发出红色警报。\",\n      \"keyEvents\": [\"乡试临近\", \"赵家勾结学政\", \"系统发出危险预警\"],\n      \"characters\": [\"苏云策\", \"学政\", \"赵无极\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"贡院号舍，绝地求生\",\n      \"summary\": \"进入贡院，苏云策发现自己的号舍被做了手脚，漏风漏雨，甚至还有蛇虫鼠蚁。他利用弹幕提示的生存技巧，改造环境，从容备考。\",\n      \"keyEvents\": [\"号舍被破坏\", \"利用生存技巧改造环境\", \"从容应对恶劣条件\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"乡试第一场，四书疑云\",\n      \"summary\": \"第一场考四书文，题目极其生僻，旨在刁难。苏云策开启弹幕“学霸模式”，万千网友共同解析，他写出的文章不仅切题，更暗藏对时政的讽刺。\",\n      \"keyEvents\": [\"遭遇生僻刁钻考题\", \"弹幕共同解析题目\", \"写出暗藏讽刺的文章\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"第二场，论国之虚实\",\n      \"summary\": \"第二场考论，题目为“虚实”。众考生皆谈兵法之虚实。苏云策在弹幕提示下，从国家经济虚实入手，痛陈大梁表面繁荣、内里空虚的现状。\",\n      \"keyEvents\": [\"考题发布\", \"从经济角度切入\", \"痛陈国家时弊\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"第三场，策问边防\",\n      \"summary\": \"第三场策问，涉及北方边患。苏云策兑换了“地缘政治学”与“大战略”视角，提出“以夷制夷”与“经济封锁”的超前策略。\",\n      \"keyEvents\": [\"策问边防问题\", \"兑换地缘政治知识\", \"提出超前战略\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"阅卷风波，必欲除之\",\n      \"summary\": \"学政大人看到苏云策的卷子，大骂其狂妄无知，直接扔进废纸堆。副主考官极力争取，两人在阅卷房爆发激烈争吵。\",\n      \"keyEvents\": [\"试卷被学政否决\", \"副主考官据理力争\", \"阅卷房爆发争吵\"],\n      \"characters\": [\"学政\", \"副主考官\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"死灰复燃，副主考官力保\",\n      \"summary\": \"副主考官冒死将苏云策的卷子从废堆中捡回，并强行将其列入中举名单，但名次极低。学政虽然愤怒，但碍于副主考官的官阶，勉强同意。\",\n      \"keyEvents\": [\"试卷被捡回\", \"被强行列为中举\", \"名次被压低\"],\n      \"characters\": [\"学政\", \"副主考官\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"放榜之日，解元归谁？\",\n      \"summary\": \"放榜时刻，赵无极通过作弊获得了“解元”（第一名）。苏云策虽然中举，但名次靠后。然而，弹幕提示赵无极的卷子存在抄袭痕迹。\",\n      \"keyEvents\": [\"赵无极作弊得解元\", \"苏云策名次靠后\", \"弹幕提示抄袭证据\"],\n      \"characters\": [\"苏云策\",赵无极\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"当众揭弊，鹿鸣宴变\",\n      \"summary\": \"在鹿鸣宴上，苏云策当众指出赵无极文章中的抄袭段落，并背诵出原典。学政试图压下此事，苏云策却越战越勇，引发士子哗然。\",\n      \"keyEvents\": [\"当众揭穿抄袭\", \"背诵原典证据\", \"引发全场哗然\"],\n      \"characters\": [\"苏云策\", \"赵无极\", \"学政\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"实至名归，真解元\",\n      \"summary\": \"事情闹大，巡按御史介入调查。最终查明赵无极作弊，苏云策的文章被重新评定，因其见解独到，被补授为解元，名震全省。\",\n      \"keyEvents\": [\"御史介入调查\", \"赵无极被革除功名\", \"苏云策补授解元\"],\n      \"characters\": [\"苏云策\", \"赵无极\", \"御史\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"进京赶考，风雨欲来\",\n      \"summary\": \"苏云策进京准备会试，途中结识了几位同样怀才不遇的志士。京城内部，守旧派大佬已经听说了苏云策的“恶名”，准备在会试中将其扼杀。\",\n      \"keyEvents\": [\"进京赶考\", \"结识志同道合者\", \"京城守旧派准备围剿\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"会试暗杀，系统护主\",\n      \"summary\": \"会试前夜，神秘刺客潜入客栈行刺。系统弹幕疯狂刷屏预警，苏云策利用兑换的简易机关术制造陷阱，成功擒获刺客，送官究办。\",\n      \"keyEvents\": [\"遭遇刺客行刺\", \"系统预警\", \"利用机关术擒获刺客\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"会试殿试，连中三元\",\n      \"summary\": \"会试中，苏云策凭借系统的加持和深厚的积累，势如破竹。随后进入殿试，面对皇帝的亲自策问，他即将迎来最终的决战。\",\n      \"keyEvents\": [\"顺利通过会试\", \"进入殿试\", \"准备面对皇帝\"],\n      \"characters\": [\"苏云策\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"金銮殿上，帝王之问\",\n      \"summary\": \""
}
