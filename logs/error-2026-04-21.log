  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：双面娇妻与猫鼠游戏\",\n      \"chapterRange\": \"第1-10章\",\n      \"summary\": \"苏青表面是依附元帅的柔弱未婚妻，实则是令星际闻风丧胆的海盗王“深渊”。陆霆发布通缉令誓要抓捕“深渊”，苏青被迫在未婚妻和海盗王两个身份间极限拉扯，通过精湛演技多次化解掉马危机。\",\n      \"plotPoints\": [\n        \"陆霆归来发布通缉令，苏青表面配合实则内心吐槽\",\n        \"苏青化身“深渊”劫掠物资，险些被陆霆发现踪迹\",\n        \"贵族宴会遇袭，苏青暗中操控机甲救场，伪造不在场证明\"\n      ]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：掉马危机与极限拉扯\",\n      \"chapterRange\": \"第11-22章\",\n      \"summary\": \"陆霆对“深渊”的追捕力度加大，甚至将苏青带至军事基地。苏青为了维持人设，不得不一边帮陆霆“抓自己”，一边利用黑科技掩盖行踪。两人在多次危机中互生情愫，但身份的隔阂日益加深。\",\n      \"plotPoints\": [\n        \"苏青随军出征，试图暗中删除自己的通缉数据\",\n        \"遗迹争夺战爆发，苏青被迫出手救陆霆，留下破绽\",\n        \"陆霆开始怀疑身边人，对苏青进行试探，苏青惊险过关\"\n      ]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：星际危机与抉择\",\n      \"chapterRange\": \"第23-28章\",\n      \"summary\": \"失落高等文明的终极兵器被反派势力唤醒，星际陷入灭顶之灾。陆霆率领的帝国军队节节败退。面对全人类的存亡，苏青无法再置身事外，她必须在暴露身份和拯救爱人之间做出抉择。\",\n      \"plotPoints\": [\n        \"失落文明遗迹异动，未知生物席卷核心星域\",\n        \"陆霆陷入绝境，帝国防线濒临崩溃\",\n        \"苏青试图暗中输送科技支援，但局势已无法挽回\"\n      ]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：女王降临与终局\",\n      \"chapterRange\": \"第29-34章\",\n      \"summary\": \"苏青不再隐藏，当众召唤失落文明舰队，以海盗王“深渊”的身份力挽狂澜。陆霆震惊于枕边人的真实身份，最终选择与她并肩作战。两人携手击退强敌，苏青身份大白，全星际哗然。\",\n      \"plotPoints\": [\n        \"苏青现身战场，召唤失落舰队扭转战局\",\n        \"陆霆得知真相，经历震惊到接受的心理转变\",\n        \"危机解除，两人坦诚相待，共同面对未来\"\n      ]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"元帅的通缉令\",\n      \"summary\": \"帝国元帅陆霆凯旋，发布最高通缉令追捕海盗王“深渊”。家中，苏青装作柔弱模样扑进他怀里瑟瑟发抖，实则内心毫无波澜。\",\n      \"keyEvents\": [\n        \"陆霆发布通缉令\",\n        \"苏青开启“柔弱未婚妻”演技模式\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"深渊的影子\",\n      \"summary\": \"苏青利用外出购物的间隙，通过黑科技伪装成“深渊”劫掠了一艘运输船，获取维持“苏青”身份所需的稀有资源，并故意留下假线索误导陆霆。\",\n      \"keyEvents\": [\n        \"苏青化身深渊劫掠物资\",\n        \"伪造现场线索误导调查\"\n      ],\n      \"characters\": [\"苏青\", \"陆霆\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"数据异常\",\n      \"summary\": \"陆霆分析战场数据，发现“深渊”的战术风格与某位已故传奇海盗相似，却不知那是苏青的导师。苏青在旁心虚，趁机撒娇转移话题。\",\n      \"keyEvents\": [\n        \"陆霆分析战术风格\",\n        \"苏青撒娇转移注意力\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"贵族晚宴\",\n      \"summary\": \"苏青陪同陆霆参加皇室晚宴，遭贵族嘲笑其精神力微弱。苏青暗中黑入宴会灯光系统恶作剧，贵族们狼狈不堪，她却装作无辜。\",\n      \"keyEvents\": [\n        \"苏青遭贵族嘲笑\",\n        \"暗中黑入系统恶作剧报复\"\n      ],\n      \"characters\": [\"苏青\", \"陆霆\", \"贵族配角\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"突袭与暗手\",\n      \"summary\": \"宴会突遭不明武装分子袭击，目标直指陆霆。陆霆护住苏青，苏青趁乱利用精神力网络暗中瘫痪了袭击者的机甲武器，助陆霆反杀。\",\n      \"keyEvents\": [\n        \"宴会遇袭\",\n        \"苏青暗中瘫痪敌人武器\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\", \"袭击者\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"元帅的怀疑\",\n      \"summary\": \"陆霆对袭击者武器莫名故障感到疑惑，检查现场发现一丝极难察觉的数据波动。他看向苏青，苏青立刻用“夫君我好怕”掩盖过去。\",\n      \"keyEvents\": [\n        \"陆霆发现数据波动\",\n        \"苏青用演技掩盖破绽\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"同床异梦\",\n      \"summary\": \"深夜，苏青趁陆霆睡熟，试图入侵他的个人终端删除关于“深渊”的敏感文件。陆霆突然翻身，苏青惊险撤回，假装梦游。\",\n      \"keyEvents\": [\n        \"苏青深夜入侵陆霆终端\",\n        \"惊险伪装梦游\"\n      ],\n      \"characters\": [\"苏青\", \"陆霆\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"边缘星域的信号\",\n      \"summary\": \"情报显示“深渊”出现在边缘星域。陆霆决定亲自带队前往，并将苏青安置在军事基地“保护”起来。苏青无奈，只能另想办法脱身。\",\n      \"keyEvents\": [\n        \"陆霆决定出征边缘星域\",\n        \"苏青被软禁在基地\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"基地的秘密\",\n      \"summary\": \"在基地中，苏青发现这里关押着几个曾追随“深渊”的小弟。她利用黑科技伪造狱警指令，将他们秘密放走并制造越狱假象。\",\n      \"keyEvents\": [\n        \"苏青发现旧部\",\n        \"伪造越狱事件\"\n      ],\n      \"characters\": [\"苏青\", \"旧部小弟\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"深渊的“仁慈”\",\n      \"summary\": \"陆霆在边缘星域遭遇“深渊”伏击。苏青操控海盗舰队故意射偏，给陆霆留出撤退路线。陆霆误以为是“深渊”在戏弄他，怒火中烧。\",\n      \"keyEvents\": [\n        \"苏青伏击陆霆\",\n        \"故意放水让陆霆撤退\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"元帅的执念\",\n      \"summary\": \"陆霆回到基地，对“深渊”的挑衅耿耿于怀。苏青贴心安慰，并在茶水中加了微量安抚剂，试图降低陆霆的警惕性。\",\n      \"keyEvents\": [\n        \"陆霆对伏击耿耿于怀\",\n        \"苏青安抚陆霆\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"意外的同居\",\n      \"summary\": \"因基地安全等级提升，陆霆搬入苏青的临时住所暂住。两人开始了尴尬的同居生活，苏青必须时刻注意不暴露自己的黑客设备。\",\n      \"keyEvents\": [\n        \"陆霆搬入苏青住处\",\n        \"苏青隐藏黑客设备\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"试探\",\n      \"summary\": \"陆霆故意在苏青面前谈论失落文明的科技特性，观察她的反应。苏青装作听不懂，反而问出几个外行问题，暂时打消了陆霆的疑虑。\",\n      \"keyEvents\": [\n        \"陆霆试探苏青知识储备\",\n        \"苏青装傻充愣\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"遗迹坐标\",\n      \"summary\": \"一份失落文明遗迹坐标流出，多方势力涌动。苏青知道那是真正的宝藏，必须先一步拿到。她借口去“散心”离开基地。\",\n      \"keyEvents\": [\n        \"遗迹坐标流出\",\n        \"苏青借口离开基地\"\n      ],\n      \"characters\": [\"苏青\", \"陆霆\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"遗迹争夺战\",\n      \"summary\": \"苏青以“深渊”身份抵达遗迹，遭遇帝国军与反叛军的混战。她利用失落科技屏障独善其身，暗中观察陆霆的战况。\",\n      \"keyEvents\": [\n        \"苏青抵达遗迹战场\",\n        \"利用科技屏障自保\"\n      ],\n      \"characters\": [\"苏青\", \"陆霆\", \"反叛军\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"绝境救援\",\n      \"summary\": \"陆霆被反叛军的陷阱困住，机甲受损严重。苏青不忍见死，操控遗迹防御系统消灭了反叛军，随后迅速撤离，只留下一个背影。\",\n      \"keyEvents\": [\n        \"陆霆陷入绝境\",\n        \"苏青操控遗迹系统救人\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"熟悉的背影\",\n      \"summary\": \"陆霆虽然获救，但那一瞬间的能量波动让他感到莫名的熟悉。他捡起“深渊”遗落的一块碎片，发现上面有特殊的涂层。\",\n      \"keyEvents\": [\n        \"陆霆获救\",\n        \"捡到关键碎片证据\"\n      ],\n      \"characters\": [\"陆霆\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"回家的“惊喜”\",\n      \"summary\": \"苏青匆忙赶回基地，身上带着战斗留下的尘土。她谎称是遇到了沙尘暴。陆霆看着她，眼神变得深邃，没有拆穿。\",\n      \"keyEvents\": [\n        \"苏青匆忙返回\",\n        \"陆霆暗中观察\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"碎片比对\",\n      \"summary\": \"陆霆私下化验碎片，发现涂层成分与苏青收藏的“古董”摆件材质一致。他心中大震，开始秘密调查苏青的过往。\",\n      \"keyEvents\": [\n        \"化验碎片成分\",\n        \"发现与苏青有关联\"\n      ],\n      \"characters\": [\"陆霆\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"温柔的陷阱\",\n      \"summary\": \"陆霆对苏青更加温柔，却带上了试探的意味。他带苏青参观机甲库，观察她对机甲型号的反应。苏青凭借高超演技完美应对。\",\n      \"keyEvents\": [\n        \"陆霆带苏青参观机甲库\",\n        \"苏青再次通过测试\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"危机前兆\",\n      \"summary\": \"星际各处出现空间震荡，失落文明的“毁灭程序”被意外触发。帝国高层乱作一团，陆霆被紧急召回参谋部。\",\n      \"keyEvents\": [\n        \"空间震荡出现\",\n        \"毁灭程序触发\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\", \"帝国高层\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"无法隐瞒的真相\",\n      \"summary\": \"苏青意识到这是她当年留下的后手失控。为了阻止程序，她必须接入核心网络。她看着忙碌的陆霆，心中充满愧疚。\",\n      \"keyEvents\": [\n        \"苏青确认程序来源\",\n        \"决定介入阻止\"\n      ],\n      \"characters\": [\"苏青\", \"陆霆\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"全面爆发\",\n      \"summary\": \"机械军团从虚空中涌现，攻击各大星系。帝国常规武器无效。陆霆率领第一舰队在前线苦苦支撑，伤亡惨重。\",\n      \"keyEvents\": [\n        \"机械军团全面入侵\",\n        \"帝国军队惨败\"\n      ],\n      \"characters\": [\"陆霆\", \"机械军团\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"元帅的陨落？\",\n      \"summary\": \"陆霆的座舰被击中，信号中断。全星际以为元帅牺牲。苏青在后方看到新闻，彻底撕碎手中的伪装道具，眼神冷冽。\",\n      \"keyEvents\": [\n        \"陆霆座舰被击中\",\n        \"苏青决定不再伪装\"\n      ],\n      \"characters\": [\"苏青\", \"陆霆\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"深渊降临\",\n      \"summary\": \"苏青驾驶着改装后的究极机甲“深渊”降临战场。她利用失落科技权限，瞬间接管了敌方机械军团，局势瞬间逆转。\",\n      \"keyEvents\": [\n        \"苏青驾驶究极机甲现身\",\n        \"接管敌方机械军团\"\n      ],\n      \"characters\": [\"苏青\", \"机械军团\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"王者归来\",\n      \"summary\": \"陆霆在逃生舱中目睹了“深渊”的英姿。他看着那台熟悉的机甲，终于将所有线索串联起来，苦笑中带着释然。\",\n      \"keyEvents\": [\n        \"陆霆目睹深渊战斗\",\n        \"确认身份真相\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"并肩作战\",\n      \"summary\": \"苏青清理完杂兵，来到陆霆身边。机甲舱门打开，她没有戴面具。陆霆看着她，两人隔空对视，默契地转身迎击最终BOSS。\",\n      \"keyEvents\": [\n        \"苏青现身救陆霆\",\n        \"两人确认心意\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"终极对决\",\n      \"summary\": \"面对失控的AI核心，陆霆负责正面牵制，苏青负责破解代码。两人的精神力与黑科技完美融合，爆发惊人力量。\",\n      \"keyEvents\": [\n        \"陆霆正面牵制\",\n        \"苏青破解核心代码\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\", \"AI核心\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"身份大白\",\n      \"summary\": \"危机解除，苏青召唤出失落文明的旗舰舰队悬停在帝国上空。全星际直播捕捉到了她的面容，全宇宙震惊：海盗王竟是元帅夫人！\",\n      \"keyEvents\": [\n        \"苏青召唤失落舰队\",\n        \"全星际知晓身份\"\n      ],\n      \"characters\": [\"苏青\", \"陆霆\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"全星际的哗然\",\n      \"summary\": \"帝国高层要求陆霆立刻逮捕苏青。陆霆当众拒绝，并宣布苏青是拯救星际的英雄，将所有功绩揽在她身上。\",\n      \"keyEvents\": [\n        \"高层施压\",\n        \"陆霆公开护妻\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\", \"帝国高层\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"摊牌时刻\",\n      \"summary\": \"回到家中，苏青忐忑不安地等待审判。陆霆走过来，无奈地抱住她：“以后不用演戏了，抓捕令撤销，换成结婚请帖。”\",\n      \"keyEvents\": [\n        \"苏青忐忑等待\",\n        \"陆霆撤销通缉令\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"新的秩序\",\n      \"summary\": \"苏青利用失落科技协助帝国改革，消除贫富差距带来的海盗根源。曾经的对手海盗纷纷归顺，星际迎来和平。\",\n      \"keyEvents\": [\n        \"苏青协助改革\",\n        \"海盗势力归顺\"\n      ],\n      \"characters\": [\"苏青\", \"陆霆\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"世纪婚礼\",\n      \"summary\": \"陆霆与苏青的婚礼在全星际直播。失落文明的舰队作为礼炮鸣响。苏青穿着婚纱，对着镜头俏皮地眨眼：“海盗王退休了。”\",\n      \"keyEvents\": [\n        \"两人举行盛大婚礼\",\n        \"苏青正式退休\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"尾声：枕边人\",\n      \"summary\": \"婚后的甜蜜生活。陆霆偶尔会拿出当年的通缉令调侃苏青。苏青笑着将他扑倒：“元帅，这次该抓你了。”\",\n      \"keyEvents\": [\n        \"婚后甜蜜日常\",\n        \"调侃当年的通缉令\"\n      ],\n      \"characters\": [\"陆霆\", \"苏青"
