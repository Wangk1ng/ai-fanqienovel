  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"寒门觉醒，初露锋芒\",\n      \"chapterRange\": \"第1-9章\",\n      \"summary\": \"苏云策穿越成大梁寒门书生，面对家徒四壁和即将到来的县试，觉醒“万界弹幕系统”。他利用现代网友的吐槽和逻辑提示，在县试中打破八股文僵化格式，初试啼声便惊动考官，不仅通过考试，更狠狠打了看不起他的世家子弟脸。\",\n      \"plotPoints\": [\"觉醒系统与初次尝试\", \"县试考场上的破局\", \"回击世家子弟的嘲讽\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"府试风波，舌战群儒\",\n      \"chapterRange\": \"第10-18章\",\n      \"summary\": \"苏云策前往府城参加府试，遭遇更复杂的局势。守旧派考官刻意刁难，题目刁钻古怪。苏云策借助弹幕提供的现代经世致用理念，写出惊世骇俗的文章。面对作弊指控，他开启直播模式，用现代辩论逻辑当众驳倒对手，名震一府。\",\n      \"plotPoints\": [\"府城遭遇刁难\", \"利用现代知识破题\", \"公开辩论洗清冤屈\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"乡试夺魁，舆论风暴\",\n      \"chapterRange\": \"第19-26章\",\n      \"summary\": \"乡试大比，苏云策面对全省精英。此时系统功能升级，弹幕活跃度达到顶峰。他在考场上针对时弊，提出超前的治国方略。文章传出后引发朝野震动，守旧大儒欲封杀其文章，却反被苏云策用“民为贵”的思想借力打力，成功夺得解元。\",\n      \"plotPoints\": [\"乡试提出超前治国策\", \"文章引发朝野震动\", \"对抗守旧大儒的封杀\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"殿试问对，独步天下\",\n      \"chapterRange\": \"第27-34章\",\n      \"summary\": \"进京赶考，会试与殿试接连而至。苏云策在金銮殿上面对皇帝与权臣的终极拷问。他不再局限于文章，而是用万界弹幕兑换的近代政治蓝图，当面阐述变革之道。皇帝当场折服，钦点状元，苏云策借此开启大梁新政，成为一代传奇。\",\n      \"plotPoints\": [\"进京面对终极考验\", \"金銮殿阐述变革蓝图\", \"钦点状元开启新政\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"穿越大梁，开局家徒四壁\",\n      \"summary\": \"现代辩论天才苏云策穿越成大梁寒门书生，家徒四壁，且面临三天后的县试。他看着死板的八股文书籍感到绝望，眼前突然浮现出奇怪的弹幕。\",\n      \"keyEvents\": [\"苏云策穿越觉醒\", \"发现万界弹幕系统\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"弹幕护体，这八股我不写了\",\n      \"summary\": \"苏云策试图理解八股文，弹幕疯狂吐槽这种文体是垃圾。受弹幕启发，苏云策决定不再死记硬背，而是尝试用现代逻辑去解构题目，准备在县试中“离经叛道”一次。\",\n      \"keyEvents\": [\"弹幕吐槽八股文\", \"决定尝试新式写法\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"县试考场，考官看傻了\",\n      \"summary\": \"县试开始，题目是《论孝》。众考生皆在引经据典，唯独苏云策笔走龙蛇，用现代心理学和社会学角度剖析“孝”。主考官初看大怒，细看后竟被其逻辑深深吸引。\",\n      \"keyEvents\": [\"县试开始\", \"用现代逻辑剖析考题\"],\n      \"characters\": [\"苏云策\", \"县试主考官\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"惊才绝艳，弹幕刷屏666\",\n      \"summary\": \"苏云策的文章交卷，弹幕瞬间刷屏“666”，人气值暴涨。考官虽觉离经叛道，但不得不承认此文章切中时弊。最终苏云策获得高分，但他那狂放的文风也引起了世家子弟的注意。\",\n      \"keyEvents\": [\"文章获得高分\", \"引起世家子弟注意\"],\n      \"characters\": [\"苏云策\", \"县试主考官\", \"王公子\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"世家挑衅，你也配读书？\",\n      \"summary\": \"放榜之日，苏云策高中，却遭到落榜世家子弟王公子的嘲讽，称其文章是“野狐禅”。王公子带人围堵苏云策，试图逼他当众认错，毁掉他的名声。\",\n      \"keyEvents\": [\"遭遇世家子弟围堵\", \"被嘲讽文章不正统\"],\n      \"characters\": [\"苏云策\", \"王公子\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"逻辑降维，教你什么是辩论\",\n      \"summary\": \"苏云策面对挑衅，开启“辩论模式”。弹幕实时提供王公子话语中的逻辑漏洞。苏云策三言两语将王公子驳得体无完肤，围观百姓纷纷叫好，王公子狼狈而逃。\",\n      \"keyEvents\": [\"开启辩论模式\", \"利用逻辑漏洞驳倒对手\"],\n      \"characters\": [\"苏云策\", \"王公子\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"府试在即，奔赴府城\",\n      \"summary\": \"县试风波后，苏云策名声小噪。他带着妹妹和简单的行囊前往府城参加府试。路上，他利用系统兑换的“基础农学知识”帮助受灾农户，积攒了更多人气值。\",\n      \"keyEvents\": [\"前往府城\", \"利用农学知识帮助农户\"],\n      \"characters\": [\"苏云策\", \"苏云策妹妹\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"府城暗流，守旧派的阴谋\",\n      \"summary\": \"抵达府城，苏云策发现这里阶级壁垒更森严。守旧派学政早已收到世家密信，准备在府试中针对苏云策，给他出极偏极难的题目，逼他落榜。\",\n      \"keyEvents\": [\"抵达府城\", \"得知守旧派阴谋\"],\n      \"characters\": [\"苏云策\", \"守旧学政\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"考场刁难，题目是《虚无》\",\n      \"summary\": \"府试考场上，学政果然出了极为生僻的题目《虚无》。众考生抓耳挠腮，苏云策却在弹幕提示下，联想到了“存在主义”哲学，提笔挥洒，将虚无写出了积极入世之意。\",\n      \"keyEvents\": [\"遭遇刁钻考题\", \"用哲学思维破题\"],\n      \"characters\": [\"苏云策\", \"守旧学政\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"文章传世，学政的纠结\",\n      \"summary\": \"学政看到苏云策的卷子，虽然极度反感其不守规矩，但被文中磅礴的气势所震慑，不敢轻易黜落。此时，王公子买通考棚人员，试图制造苏云策作弊的假象。\",\n      \"keyEvents\": [\"学政被文章震慑\", \"对手制造作弊假象\"],\n      \"characters\": [\"苏云策\", \"守旧学政\", \"王公子\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"当堂对质，谁在作弊？\",\n      \"summary\": \"作弊指控爆发，苏云策被带到公堂。他不仅没有慌张，反而要求当众复盘文章思路。他口若悬河，将文章脉络一一道来，逻辑严密绝无抄袭可能，反指考棚人员监管不力。\",\n      \"keyEvents\": [\"被指控作弊\", \"当众复盘文章自证清白\"],\n      \"characters\": [\"苏云策\", \"守旧学政\", \"考棚人员\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"人气爆发，兑换《国富论》\",\n      \"summary\": \"府试对质事件让苏云策彻底火了，弹幕热度空前。他利用积攒的巨额人气值，兑换了现代经济学经典《国富论》的精华版，为接下来的乡试做准备。\",\n      \"keyEvents\": [\"热度空前\", \"兑换经济学知识\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"府案首，名动一府\",\n      \"summary\": \"苏云策最终以府案首（第一名）的成绩通过府试。守旧学政虽然给了他名次，但警告他若在乡试还敢如此胡来，定不轻饶。苏云策对此置若罔闻。\",\n      \"keyEvents\": [\"获得府案首\", \"受到学政警告\"],\n      \"characters\": [\"苏云策\", \"守旧学政\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"乡试开考，全省精英云集\",\n      \"summary\": \"时间飞逝，乡试大比在省城举行。全省顶尖才子云集，其中不乏世家大族培养出的“八股机器”。苏云策的出现被他们视为眼中钉。\",\n      \"keyEvents\": [\"参加乡试\", \"遭遇全省精英敌视\"],\n      \"characters\": [\"苏云策\", \"众举子\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"策论题目，问治国之策\",\n      \"summary\": \"乡试第二场策论，题目问的是“国库空虚何以解”。世家子弟们还在写“节用”、“仁政”，苏云策则直接祭出了《国富论》中的市场经济与流通理论。\",\n      \"keyEvents\": [\"策论考试开始\", \"提出市场经济理论\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"惊世骇俗，商亦可富国\",\n      \"summary\": \"苏云策在文中提出“商乃国之血脉”，主张打破重农抑商。这种思想在当时简直是异端邪说。阅卷房内大儒们吵成一团，有人主张烧卷，有人主张录遗。\",\n      \"keyEvents\": [\"提出重商思想\", \"阅卷房引发激烈争论\"],\n      \"characters\": [\"苏云策\", \"阅卷大儒们\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"副主考力保，解元出炉\",\n      \"summary\": \"一位思想开明的副主考官力排众议，认为苏云策虽离经叛道但确有真才实学，强行将其卷子列为第一。苏云策意外夺魁，成为全省解元，消息瞬间引爆全省。\",\n      \"keyEvents\": [\"副主考力保\", \"夺得解元\"],\n      \"characters\": [\"苏云策\", \"副主考官\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"鹿鸣宴，鸿门宴？\",\n      \"summary\": \"乡试结束后举办鹿鸣宴，按理这是庆祝之宴。但守旧派大儒联合起来，准备在宴会上用经义难题羞辱苏云策，逼他认错，收回那篇“妖文”。\",\n      \"keyEvents\": [\"参加鹿鸣宴\", \"守旧派设下鸿门宴\"],\n      \"characters\": [\"苏云策\", \"守旧大儒\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"舌战群儒，弹幕神助攻\",\n      \"summary\": \"宴会上，大儒们引经据典围攻苏云策。苏云策毫无惧色，弹幕实时提供各种历史反例和现代逻辑。他将大儒们的教条逐一击破，甚至反问得大儒们哑口无言。\",\n      \"keyEvents\": [\"大儒围攻\", \"逐一击破教条\"],\n      \"characters\": [\"苏云策\", \"守旧大儒\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"名扬天下，进京赶考\",\n      \"summary\": \"鹿鸣宴一战，苏云策“苏狂生”的名号响彻天下。他收拾行囊，带着无数人的期待或诅咒，踏上了前往京城参加会试的道路。此时，连皇宫中的皇帝也听说了他的名字。\",\n      \"keyEvents\": [\"名号响彻天下\", \"前往京城\"],\n      \"characters\": [\"苏云策\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"京城风云，各方势力的博弈\",\n      \"summary\": \"抵达京城，苏云策发现这里不仅是考场，更是政治漩涡。改革派暗中派人接触他，守旧派则散布谣言称他是“妖言惑众”的骗子。苏云策冷眼旁观，专心备考。\",\n      \"keyEvents\": [\"抵达京城\", \"改革派与守旧派拉拢\"],\n      \"characters\": [\"苏云策\", \"改革派官员\", \"守旧派权臣\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"会试贡院，最后的筛选\",\n      \"summary\": \"会试开始，考场气氛森严。题目由皇帝亲自拟定，极为宏大。苏云策感到压力，但看到弹幕中网友们“大佬加油”的刷屏，信心倍增，决定再赌一把大的。\",\n      \"keyEvents\": [\"会试开始\", \"网友刷屏鼓励\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"万言书，直指官场弊病\",\n      \"summary\": \"苏云策在试卷中不再拘泥于理论，而是直指大梁官场冗员、效率低下的弊病。他利用系统兑换的“行政管理学”知识，提出了一套精简机构、考核官员的方案。\",\n      \"keyEvents\": [\"直指官场弊病\", \"提出行政管理方案\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"贡院烧卷，权臣的愤怒\",\n      \"summary\": \"守旧权臣看到苏云策的卷子，认为这是在动摇国本，下令暗中烧毁此卷，企图让他落榜。关键时刻，负责看卷的小官被苏云策之前的文章折服，偷偷将卷子救下并呈送给皇帝。\",\n      \"keyEvents\": [\"权臣下令烧卷\", \"试卷被救下呈给皇帝\"],\n      \"characters\": [\"苏云策\", \"守旧权臣\", \"正直小官\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"御前朱批，此子当用\",\n      \"summary\": \"皇帝深夜批阅试卷，看到了苏云策那篇针砭时弊的万言书。皇帝正为朝政腐败头疼，苏云策的方案让他眼前一亮。大笔一挥，将其列为会元，并钦点殿试。\",\n      \"keyEvents\": [\"皇帝阅卷\", \"钦点会元\"],\n      \"characters\": [\"苏云策\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"殿试前夕，最后的暗战\",\n      \"summary\": \"殿试在即，守旧派知道无法在试卷上做手脚，便准备在殿试的“策问”环节，由皇帝亲自出题问死他。苏云策在客栈中闭门不出，利用弹幕模拟面试场景。\",\n      \"keyEvents\": [\"守旧派策划策问\", \"模拟面试场景\"],\n      \"characters\": [\"苏云策\", \"守旧派权臣\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"金銮殿上，天子门生\",\n      \"summary\": \"殿试开始，苏云策站在金銮殿上，面对九五之尊。皇帝神色威严，连珠炮般抛出关于边疆、赋税、吏治的难题。苏云策不卑不亢，对答如流。\",\n      \"keyEvents\": [\"殿试开始\", \"皇帝连珠炮提问\"],\n      \"characters\": [\"苏云策\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"经世致用，大梁的出路\",\n      \"summary\": \"面对终极一问“大梁何去何从”，苏云策没有用四书五经回答。他利用系统兑换的“洋务运动”与“君主立宪”雏形思想，提出了一套渐进式改革方案，震惊四座。\",\n      \"keyEvents\": [\"回答大梁出路\", \"提出渐进式改革\"],\n      \"characters\": [\"苏云策\", \"皇帝\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"朝堂哗然，这是造反吗？\",\n      \"summary\": \"守旧派大臣听出苏云策话中“限制君权”、“开设议院”的意味，纷纷跪地斥责其是乱臣贼子，请求皇帝治罪。朝堂上一片混乱，弹幕疯狂刷屏“保护我方大佬”。\",\n      \"keyEvents\": [\"守旧派斥责乱臣贼子\", \"朝堂一片混乱\"],\n      \"characters\": [\"苏云策\", \"皇帝\", \"守旧派大臣\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"皇帝的决断，朕意已决\",\n      \"summary\": \"皇帝看着跪地痛哭的大臣们，又看着目光清澈的苏云策，意识到大梁若不变革必亡。他猛地拍案而起，喝退众臣，称赞苏云策是“救世之才”，当场宣布苏云策为状元。\",\n      \"keyEvents\": [\"皇帝喝退众臣\", \"宣布苏云策为状元\"],\n      \"characters\":"
}
