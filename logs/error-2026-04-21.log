  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：人形抑制剂\",\n      \"chapterRange\": \"第1-12章\",\n      \"summary\": \"SSS级精神力者楚云濒临狂暴，异族遗孤苏离化身军医潜伏。她以“痛觉共生”体质成为楚云唯一的救赎。两猎手与猎物的关系中，苏离在复仇与动心间挣扎，楚云在警惕与沉沦中越陷越深。\",\n      \"plotPoints\": [\n        \"苏离初次接触楚云，成功平息其狂暴\",\n        \"苏离利用身份便利暗中搜集情报\",\n        \"楚云对苏离产生特殊依赖，赐予特权\"\n      ]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：折断的翅膀\",\n      \"chapterRange\": \"第13-25章\",\n      \"summary\": \"苏离的异族身份意外败露，昔日宠溺瞬间崩塌。楚云感到被背叛的极致愤怒，亲手折断苏离的精神之翼。他将她从爱人变为阶下囚，在恨意与占有欲中开启病娇囚禁模式。\",\n      \"plotPoints\": [\n        \"苏离的异族特征被政敌发现\",\n        \"楚云当众揭穿并逮捕苏离\",\n        \"楚云将苏离关入特制囚笼，实施精神折磨\"\n      ]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：深渊中的爱恨\",\n      \"chapterRange\": \"第26-38章\",\n      \"summary\": \"星际战局恶化，楚云精神力再次失控，却只能依靠身为敌人的苏离。两人在囚禁中极限拉扯，误会层层叠加。苏离试图逃离，楚云以爱为名的囚禁愈发疯狂，直至帝国下达处决令。\",\n      \"plotPoints\": [\n        \"楚云狂暴发作，被迫向苏离求救\",\n        \"苏离试图逃跑失败，遭受残酷惩罚\",\n        \"楚云违抗帝国命令，私下藏匿苏离\"\n      ]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：血泪与独活\",\n      \"chapterRange\": \"第39-50章\",\n      \"summary\": \"星际决战，异族释放精神毒雾，楚云彻底陷入毁灭边缘。苏离为救他，也为了成全两人的结局，毅然选择自爆神魂平息风暴。楚云在最后时刻得知真相，却只留下一滴血泪，独活万年。\",\n      \"plotPoints\": [\n        \"决战爆发，楚云机甲失控屠戮友军\",\n        \"苏离冲破束缚奔赴战场\",\n        \"苏离自爆神魂，楚云悔恨终生\"\n      ]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"濒临崩溃的SSS级\",\n      \"summary\": \"帝国元帅楚云在战斗后精神力狂暴，摧毁医疗室。高层紧急征召神秘军医苏离，她以特殊体质介入，瞬间平息风暴。\",\n      \"keyEvents\": [\"楚云精神力失控\", \"苏离初次施展能力\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"唯一的解药\",\n      \"summary\": \"苏离成为楚云的专属军医。楚云对苏离既警惕又依赖，苏离隐藏起异族血脉，在接触中暗中承受巨大的反噬剧痛。\",\n      \"keyEvents\": [\"确立专属医患关系\", \"苏离忍受剧痛\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"猎手与猎物\",\n      \"summary\": \"苏离利用职务之便接触核心数据库。楚云敏锐察觉她的试探，却因贪恋她带来的安宁而选择视而不见，内心产生博弈。\",\n      \"keyEvents\": [\"苏离窃取情报\", \"楚云默许行为\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"霓虹下的伪装\",\n      \"summary\": \"一次庆功宴上，苏离险些被异族探测器识别。她巧妙化解危机，楚云替她挡酒，两人眼神交汇，气氛暧昧。\",\n      \"keyEvents\": [\"宴会危机\", \"楚云挡酒\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"痛觉的共鸣\",\n      \"summary\": \"楚云噩梦连连，苏离整夜守护。在精神链接中，楚云看到了苏离内心深处的孤独，第一次对这个“女人”产生了怜惜。\",\n      \"keyEvents\": [\"精神链接\", \"楚云产生怜惜\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"旧时代的遗孤\",\n      \"summary\": \"苏离在废墟中寻找异族遗物，回忆起灭族之仇。她看着楚云送她的项链，内心挣扎，决定推迟刺杀计划。\",\n      \"keyEvents\": [\"苏离回忆灭族\", \"推迟刺杀\"],\n      \"characters\": [\"苏离\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"元帅的偏爱\",\n      \"summary\": \"楚云公然违抗军部条令，带苏离前往私人星球疗养。外界传言元帅被迷惑，苏离在温柔乡中逐渐迷失。\",\n      \"keyEvents\": [\"前往私人星球\", \"外界传言\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"无法抑制的心动\",\n      \"summary\": \"遭遇星空兽袭击，楚云为救苏离受伤。苏离本能地过度透支能力为他疗伤，昏迷不醒，楚云方知她对自己有多重要。\",\n      \"keyEvents\": [\"遭遇星空兽\", \"苏离透支疗伤\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"暗处的眼睛\",\n      \"summary\": \"帝国反对派盯上了苏离，开始调查她的身世。苏离察觉异常，试图疏远楚云，却被楚云强硬挽留。\",\n      \"keyEvents\": [\"反对派调查\", \"苏离试图疏远\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"名为“背叛”的试探\",\n      \"summary\": \"异族联络员暗中接触苏离，逼迫她动手。苏离在楚云的茶中下毒，却在最后一刻打翻茶杯，被楚云看在眼里。\",\n      \"keyEvents\": [\"异族逼迫\", \"苏离犹豫\"],\n      \"characters\": [\"苏离\", \"楚云\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"破碎的宁静\",\n      \"summary\": \"楚云并未揭穿，反而更加疯狂地占有苏离。苏离在愧疚与恐惧中，发现楚云眼底深处压抑的疯狂爱意。\",\n      \"keyEvents\": [\"楚云疯狂占有\", \"苏离发现爱意\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"风暴前夕\",\n      \"summary\": \"帝国高层决定对异族残党进行总清洗，楚云被召回。苏离预感到末日将至，决定向楚云坦白部分身份。\",\n      \"keyEvents\": [\"总清洗命令\", \"苏离欲坦白\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"血色舞会\",\n      \"summary\": \"在誓师大会上，政敌当众拿出证据，指控苏离是异族“血魔”的后裔。全场哗然，矛头直指苏离。\",\n      \"keyEvents\": [\"政敌发难\", \"身份曝光\"],\n      \"characters\": [\"苏离\", \"楚云\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"元帅的审判\",\n      \"summary\": \"所有人都以为楚云会暴怒杀人，他却面无表情地走向苏离，亲手扣下了特制的精神抑制项圈，冷声宣判她的罪行。\",\n      \"keyEvents\": [\"楚云扣项圈\", \"宣判罪行\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"跌落尘埃\",\n      \"summary\": \"苏离被剥夺军衔，关入水牢。楚云来看她，眼神不再有温度，只有被欺骗后的滔天恨意：“你演得真好。”\",\n      \"keyEvents\": [\"关入水牢\", \"楚云恨意\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"折翼\",\n      \"summary\": \"为了防止苏离逃跑，楚云亲手废除了她引以为傲的精神力回路。苏离痛不欲生，却只问了一句：“你爱过我吗？”\",\n      \"keyEvents\": [\"废除精神力\", \"苏离质问\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"囚鸟\",\n      \"summary\": \"苏离被转移到元帅府深处的密室。楚云将她当作金丝雀囚禁，每晚强迫她留在身边，却又拒绝听她的解释。\",\n      \"keyEvents\": [\"密室囚禁\", \"拒绝解释\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"病娇的独占\",\n      \"summary\": \"楚云对外宣称苏离已死，私下里却享受着这种完全拥有的扭曲快感。他开始变得喜怒无常，甚至不允许苏离开死。\",\n      \"keyEvents\": [\"楚云宣称苏离已死\", \"病娇发作\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"痛苦的共生\",\n      \"summary\": \"楚云精神力副作用加剧，只有靠近苏离才能缓解。他厌恶地抱住她，一边咒骂她是怪物，一边贪婪地汲取她的安抚。\",\n      \"keyEvents\": [\"楚云精神力反噬\", \"厌恶与依赖\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"唯一的温存\",\n      \"summary\": \"苏离发高烧，楚云不顾副官阻拦，亲自照顾。在昏迷中，楚云听到了苏离的呢喃，那是她从未说过的爱意。\",\n      \"keyEvents\": [\"苏离生病\", \"听到呢喃\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"谎言与真相\",\n      \"summary\": \"副官查出苏离并未真正泄露机密，甚至多次破坏异族计划。楚云看着报告，手指颤抖，内心信念动摇。\",\n      \"keyEvents\": [\"副官查清真相\", \"楚云动摇\"],\n      \"characters\": [\"楚云\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"越狱计划\",\n      \"summary\": \"异族残党劫狱，试图救走苏离。苏离不愿连累楚云，配合行动。楚云赶到，误以为她又要背叛自己。\",\n      \"keyEvents\": [\"异族劫狱\", \"再次误会\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"残酷的惩罚\",\n      \"summary\": \"楚云击退异族，对苏离施加更严厉的禁制。他将她锁在床头，冷冷地说：“这辈子，你死都要死在我手里。”\",\n      \"keyEvents\": [\"击退异族\", \"施加禁制\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"绝望的深渊\",\n      \"summary\": \"苏离心如死灰，开始绝食。楚云强行喂食，两人都遍体鳞伤。这种互相折磨的关系让周围人感到窒息。\",\n      \"keyEvents\": [\"苏离绝食\", \"强行喂食\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"帝国的最后通牒\",\n      \"summary\": \"帝国议会施压，要求处死苏离以安军心。楚云当众撕碎命令，宣布苏离是他的私有实验品，无人能动。\",\n      \"keyEvents\": [\"议会施压\", \"楚云护短\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"星际决战前夕\",\n      \"summary\": \"异族大军压境，人类帝国节节败退。楚云必须出征，但他无法离开苏离，最终决定将她带上旗舰，锁在观察舱内。\",\n      \"keyEvents\": [\"异族大军压境\", \"带上战场\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"观察舱内的守望\",\n      \"summary\": \"战场上硝烟弥漫，苏离透过玻璃看着楚云驾驶机甲厮杀。她感应到他的精神力正在崩溃，心急如焚。\",\n      \"keyEvents\": [\"战场厮杀\", \"感应崩溃\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"精神污染源\",\n      \"summary\": \"异族使用禁忌武器“精神毒雾”，人类士兵纷纷发狂。楚云作为最强者，首当其冲，开始无差别攻击。\",\n      \"keyEvents\": [\"精神毒雾\", \"楚云无差别攻击\"],\n      \"characters\": [\"楚云\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"失控的修罗\",\n      \"summary\": \"楚云机甲染血，神智完全丧失。他甚至开始攻击己方战舰。旗舰警报大作，所有人请求元帅停止，但他已听不见。\",\n      \"keyEvents\": [\"攻击己方\", \"完全丧失神智\"],\n      \"characters\": [\"楚云\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"唯一的钥匙\",\n      \"summary\": \"副官绝望中找到苏离。苏离看着发狂的楚云，知道只有她能阻止他。她请求副官打开舱门，哪怕这意味着去送死。\",\n      \"keyEvents\": [\"副官求助\", \"苏离请战\"],\n      \"characters\": [\"苏离\", \"楚云\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"奔赴深渊\",\n      \"summary\": \"苏离拖着虚弱的身体，穿上防护服，跳入茫茫宇宙，利用精神力牵引，冲向那台正在毁灭世界的机甲。\",\n      \"keyEvents\": [\"跳入宇宙\", \"冲向机甲\"],\n      \"characters\": [\"苏离\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"拥抱野兽\",\n      \"summary\": \"苏离强行打开机甲驾驶舱。狂暴的楚云掐住她的脖子，眼中满是杀戮欲望。苏离没有反抗，只是抱住了他。\",\n      \"keyEvents\": [\"打开驾驶舱\", \"拥抱楚云\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"苏离的抉择\",\n      \"summary\": \"苏离发动天赋“痛觉吞噬”，将楚云体内足以毁灭星球的精神狂暴全部转移到自己体内。她的身体开始崩裂。\",\n      \"keyEvents\": [\"发动天赋\", \"身体崩裂\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"清醒的瞬间\",\n      \"summary\": \"楚云在剧痛消退中找回神智。他看到了怀里浑身是血的苏离，以及她正在消散的灵魂。恐惧瞬间淹没了他。\",\n      \"keyEvents\": [\"楚云清醒\", \"恐惧\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"迟来的真相\",\n      \"summary\": \"苏离微笑着流泪，将一直隐藏的芯片交给楚云，那是异族母舰的核心坐标，也是她给他的最后礼物。“我从未背叛你。”\",\n      \"keyEvents\": [\"交出坐标\", \"表白\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 36,\n      \"title\": \"自爆神魂\",\n      \"summary\": \"异族精神源试图反扑夺舍。苏离为了彻底切断源头，也为了不再拖累楚云，毅然引爆了自己的神魂之火。\",\n      \"keyEvents\": [\"异族反扑\", \"自爆神魂\"],\n      \"characters\": [\"苏离\"]\n    },\n    {\n      \"chapterNumber\": 37,\n      \"title\": \"血泪\",\n      \"summary\": \"巨大的精神冲击波横扫战场，异族大军瞬间瘫痪。苏离的身体化作点点光尘消散，只在楚云脸上留下一滴血泪。\",\n      \"keyEvents\": [\"战场平息\", \"化作光尘\"],\n      \"characters\": [\"楚云\", \"苏离\"]\n    },\n    {\n      \"chapterNumber\": 38,\n      \"title\": \"毁灭的咆哮\",\n      \"summary\": \"楚云抱着空气发出撕心裂肺的哀嚎。SSS级精神力彻底爆发，但他没有发狂，而是将这份力量化作复仇的利刃。\",\n      \"keyEvents\": [\"楚云哀嚎\", \"复仇利刃\"],\n      \"characters\": [\"楚云\"]\n    },\n    {\n      \"chapterNumber\": 39,\n      \"title\": \"屠戮异族\",\n      \"summary\": \"楚云如同一台没有感情的机器，单枪匹马冲入异族母舰，利用苏离留下的坐标，将异族高层彻底抹杀。\",\n      \"keyEvents\": [\"冲入母舰\", \"抹杀高层\"],\n      \"characters\": [\"楚云\"]\n    },\n    {\n      \"chapterNumber\": 40,\n      \"title\":"
}
