  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：寒门觉醒，初露锋芒\",\n      \"chapterRange\": \"第1-11章\",\n      \"summary\": \"苏云策穿越成大梁寒门书生，家徒四壁，妹妹重病。面对死板的八股文，他觉醒“万界弹幕系统”。在县试中，利用现代网友的吐槽和逻辑漏洞，将一篇离经叛道的文章强行解释为圣人微言大义，惊呆考官，夺得案首，初试啼声。\",\n      \"plotPoints\": [\"觉醒系统，弹幕吐槽八股文\", \"县试破题，用后现代逻辑降维打击\", \"考官想判零分，被弹幕教做人\", \"夺得案首，打脸富家子弟\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：府试风云，舌战群儒\",\n      \"chapterRange\": \"第12-22章\",\n      \"summary\": \"苏云策前往府城参加府试，遭遇世家大族赵氏的打压和暗杀。在考场上，面对守旧派考官的故意刁难，苏云策开启“直播模式”，弹幕热度飙升。他当庭辩论，用“经世致用”的思想驳斥祖宗之法，将考场变成个人秀场，成功突围。\",\n      \"plotPoints\": [\"路遇赵氏纨绔，初次交锋\", \"府试考题暗藏杀机\", \"兑换现代知识，写出惊世策论\", \"考校现场舌战考官，引发全城热议\", \"反杀赵氏刺客，名声大噪\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：乡试夺魁，震动天下\",\n      \"chapterRange\": \"第23-34章\",\n      \"summary\": \"进入乡试（省考），这是科举最高难度的挑战。苏云策在贡院号舍中，面对极其晦涩的题目，利用弹幕提供的“降维打击”思路，结合现代政治经济学，写出足以改变大梁国运的《万言书》。主考官惊为天人，守旧派欲毁其卷，苏云策最终夺得解元，开启新政序幕。\",\n      \"plotPoints\": [\"进入贡院，系统升级为全网直播\", \"三场考试，场场引爆弹幕\", \"阅卷室风波，主考官力排众议\", \"放榜解元，名动天下\", \"鹿鸣宴演讲，确立改革派领袖地位\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"穿越大梁，家徒四壁\",\n      \"summary\": \"现代辩论天才苏云策穿越成大梁朝寒门书生，面对重病的妹妹和即将到期的债务，他必须尽快通过科举改变命运。\",\n      \"keyEvents\": [\"苏云策穿越醒来\", \"发现妹妹苏云婉重病\", \"回忆原身记忆，决定参加县试\"],\n      \"characters\": [\"苏云策\", \"苏云婉\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"万界弹幕，在线吐槽\",\n      \"summary\": \"苏云策拿起《四书》准备复习，眼前突然浮现出奇怪的弹幕。现代网友们疯狂吐槽八股文的僵化，并提示逻辑漏洞。\",\n      \"keyEvents\": [\"觉醒万界弹幕系统\", \"弹幕疯狂刷屏吐槽八股文\", \"苏云策发现弹幕能提供解题思路\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"县试报名，势利眼\",\n      \"summary\": \"苏云策前往县衙报名，遭遇富家子弟赵泰的嘲讽和书吏的刁难。弹幕提示赵泰的文章是抄袭的，苏云策当场揭穿。\",\n      \"keyEvents\": [\"在县衙遭遇赵泰\", \"书吏索要贿赂\", \"利用弹幕提示揭穿赵泰抄袭\"],\n      \"characters\": [\"苏云策\", \"赵泰\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"入场搜身，暗藏玄机\",\n      \"summary\": \"县试开始，入场搜检极严。苏云策凭借弹幕提示，避开了守卫的故意找茬，顺利进入号舍，准备应战。\",\n      \"keyEvents\": [\"入场搜检\", \"弹幕提示守卫心理\", \"顺利进入号舍\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"破题之难，弹幕助攻\",\n      \"summary\": \"考题发下，题目极其生僻刁钻。众考生苦思冥想，苏云策在弹幕的“降维打击”提示下，瞬间找到了破题的切入点。\",\n      \"keyEvents\": [\"拿到生僻考题\", \"弹幕提供现代视角切入点\", \"苏云策开始破题\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"离经叛道？不，是微言大义！\",\n      \"summary\": \"苏云策下笔如有神，写出的文章看似离经叛道，实则暗合圣人本心。弹幕疯狂刷“666”，人气值暴涨。\",\n      \"keyEvents\": [\"撰写文章\", \"文章内容看似离经叛道\", \"人气值暴涨，兑换知识\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"考官震怒，欲判零分\",\n      \"summary\": \"阅卷时，考官李大人看到苏云策的文章大怒，认为其妖言惑众，准备判零分并治罪。弹幕提示李大人的黑料。\",\n      \"keyEvents\": [\"考官阅卷大怒\", \"准备判零分\", \"弹幕提示考官贪污受贿证据\"],\n      \"characters\": [\"李考官\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"逻辑闭环，教考官做人\",\n      \"summary\": \"苏云策被提审，他不卑不亢，用严密的逻辑将文章解释为“经世致用”的新解，并隐晦点出考官把柄。考官冷汗直流。\",\n      \"keyEvents\": [\"苏云策被提审\", \"用逻辑解释文章\", \"隐晦威胁考官\"],\n      \"characters\": [\"苏云策\", \"李考官\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"放榜之日，案首归我\",\n      \"summary\": \"县试放榜，苏云策凭借惊人的实力和考官的“妥协”，夺得第一名案首。赵泰落榜，气急败坏。\",\n      \"keyEvents\": [\"县试放榜\", \"苏云策夺得案首\", \"赵泰气急败坏\"],\n      \"characters\": [\"苏云策\", \"赵泰\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"赵家报复，街头围堵\",\n      \"summary\": \"赵泰不甘心，指使家丁在街头围堵苏云策，试图打断他的腿让他无法参加府试。苏云策利用兑换的格斗技巧反杀。\",\n      \"keyEvents\": [\"赵家家丁围堵\", \"兑换现代格斗技巧\", \"反杀家丁\"],\n      \"characters\": [\"苏云策\", \"赵泰\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"整装待发，目标府城\",\n      \"summary\": \"苏云策意识到县试只是开始，真正的挑战在府城。他用积攒的人气值兑换了一些基础医术，暂时缓解了妹妹的病情，踏上征途。\",\n      \"keyEvents\": [\"兑换医术救治妹妹\", \"决定前往府城\", \"结识同窗书生顾清舟\"],\n      \"characters\": [\"苏云策\", \"苏云婉\", \"顾清舟\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"抵达府城，繁华背后的腐朽\",\n      \"summary\": \"抵达府城，苏云策被眼前的繁华震撼，但弹幕却揭示了这繁华背后的贫富差距和民生凋敝，坚定了他改革的心。\",\n      \"keyEvents\": [\"抵达府城\", \"目睹繁华与贫富差距\", \"弹幕揭示社会矛盾\"],\n      \"characters\": [\"苏云策\", \"顾清舟\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"府试前夕，鸿门宴\",\n      \"summary\": \"府试知府是赵家的靠山。赵泰设下鸿门宴，试图用金钱收买苏云策让出案首，被苏云策用现代话术嘲讽拒绝。\",\n      \"keyEvents\": [\"赵泰设鸿门宴\", \"试图收买苏云策\", \"苏云策嘲讽拒绝\"],\n      \"characters\": [\"苏云策\", \"赵泰\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"府试开始，知府的杀意\",\n      \"summary\": \"府试考场，知府亲自监考，目光死死盯着苏云策。考题竟然是赵家泄露出的偏题，专为针对苏云策。\",\n      \"keyEvents\": [\"府试开始\", \"知府亲自监考\", \"考题泄露针对苏云策\"],\n      \"characters\": [\"苏云策\", \"知府\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"逆向思维，绝地反击\",\n      \"summary\": \"面对死局，苏云策开启“直播模式”，弹幕活跃度爆表。网友们提供逆向思维，苏云策决定不按套路出牌，直接批判题目本身。\",\n      \"keyEvents\": [\"开启直播模式\", \"弹幕活跃度爆表\", \"决定批判题目，立意更高\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"策论惊世，人口红利\",\n      \"summary\": \"苏云策在策论中提出“人口即红利”的概念，虽然用词古雅，但核心思想超前，直接击中大梁人口流失的痛点。\",\n      \"keyEvents\": [\"撰写策论\", \"提出人口红利概念\", \"击中社会痛点\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"考校大堂，知府发难\",\n      \"summary\": \"府试复试（考校），知府当众指责苏云策文章离经叛道，甚至斥责其是“乱臣贼子”的思想苗子。\",\n      \"keyEvents\": [\"复试考校\", \"知府当众发难\", \"斥责苏云策思想\"],\n      \"characters\": [\"苏云策\", \"知府\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"舌战群儒，祖宗之法\",\n      \"summary\": \"苏云策面对知府和一众守旧儒生的围攻，毫无惧色。他引用古史，结合弹幕提供的辩证法，论证“祖宗之法当变则变”。\",\n      \"keyEvents\": [\"守旧儒生围攻\", \"引用古史结合辩证法\", \"论证祖宗之法当变\"],\n      \"characters\": [\"苏云策\", \"知府\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"全场寂静，逻辑碾压\",\n      \"summary\": \"苏云策的辩论逻辑严密，守旧派根本插不上嘴，只能气急败坏地喊“竖子无礼”。围观百姓和部分开明士子听得热血沸腾。\",\n      \"keyEvents\": [\"逻辑碾压守旧派\", \"守旧派气急败坏\", \"百姓和士子热血沸腾\"],\n      \"characters\": [\"苏云策\", \"知府\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"强行录取，暗流涌动\",\n      \"summary\": \"知府虽然恨苏云策，但在众目睽睽之下不敢明目张胆舞弊，只能勉强录取他为生员（秀才），但暗中联络赵家准备在乡试动手。\",\n      \"keyEvents\": [\"知府勉强录取\", \"知府联络赵家\", \"准备乡试暗算\"],\n      \"characters\": [\"苏云策\", \"知府\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"归途遇袭，生死一线\",\n      \"summary\": \"归乡途中，苏云策遭遇赵家雇佣的死士。关键时刻，顾清舟带来家族护卫拼死抵抗，苏云策利用系统兑换的陷阱知识反杀刺客。\",\n      \"keyEvents\": [\"遭遇死士袭击\", \"顾清舟带人救援\", \"利用陷阱知识反杀\"],\n      \"characters\": [\"苏云策\", \"顾清舟\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"名声远扬，各方关注\",\n      \"summary\": \"府试舌战群儒的事迹传开，苏云策名声大噪。京城来的神秘人物（改革派官员）开始关注这个寒门学子，送来一本《天下郡县利病书》。\",\n      \"keyEvents\": [\"事迹传开名声大噪\", \"京城神秘人物关注\", \"获赠《天下郡县利病书》\"],\n      \"characters\": [\"苏云策\", \"神秘官员\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"乡试在即，系统升级\",\n      \"summary\": \"乡试（省考）临近，这是通往仕途的关键。系统全面升级，弹幕池扩大，甚至可以兑换现代工业基础知识的简化版。\",\n      \"keyEvents\": [\"准备乡试\", \"系统全面升级\", \"兑换工业基础知识\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"贡入号舍，龙争虎斗\",\n      \"summary\": \"苏云策进入贡院，这里的竞争更加激烈。他发现周围的考生都是各县的学霸，甚至还有几个解元种子选手。\",\n      \"keyEvents\": [\"进入贡院\", \"遇到各路学霸\", \"感受到竞争压力\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"第一场，四书疑云\",\n      \"summary\": \"第一场考四书文，题目极其晦涩，仿佛字字都在考校训诂。苏云策利用弹幕提供的“文字狱”案例，避开所有敏感点，写得中正平和却暗藏锋芒。\",\n      \"keyEvents\": [\"第一场考试开始\", \"题目晦涩\", \"避开敏感点暗藏锋芒\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"第二场，五经溯源\",\n      \"summary\": \"第二场考五经，苏云策选择《春秋》。他弹幕提示“地缘政治学”，他将春秋战国的局势与大梁周边局势类比，分析得头头是道。\",\n      \"keyEvents\": [\"第二场考试\", \"选择《春秋》\", \"用地缘政治学分析局势\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"第三场，策问天下\",\n      \"summary\": \"第三场策论是重中之重。题目问的是“国用不足”。苏云策看着满篇的“节流”，决定写“开源”。\",\n      \"keyEvents\": [\"第三场策论\", \"题目问国用不足\", \"决定写开源而非节流\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"商业兴国，离经叛道\",\n      \"summary\": \"苏云策在文章中提出“商者流通万物”，主张提高商人地位，发展商业税收替代农业税。这在重农抑商的大梁简直是异端邪说。\",\n      \"keyEvents\": [\"提出商业兴国\", \"主张提高商人地位\", \"观点被视为异端\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"阅卷风暴，主考官的惊叹\",\n      \"summary\": \"阅卷室里，主考官（改革派）看到苏云策的卷子，拍案叫绝。但副主考官（守旧派）大骂这是洪水猛兽，要求撕毁试卷。\",\n      \"keyEvents\": [\"主考官惊叹\", \"副主考官大骂\", \"要求撕毁试卷\"],\n      \"characters\": [\"主考官\", \"副主考官\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"据理力争，保护卷子\",\n      \"summary\": \"主考官与副主考官在阅卷室爆发激烈争吵。主考官以“才学高低不论门户”为由，强行保下苏云策的卷子，列为前十。\",\n      \"keyEvents\": [\"主副考官争吵\", \"主考官强行保卷\", \"列为前十\"],\n      \"characters\": [\"主考官\", \"副主考官\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"放榜时刻，解元！\",\n      \"summary\": \"乡试放榜，全城轰动。苏云策的名字高居榜首——解元！这是寒门子弟多年未有的荣耀，百姓夹道欢迎。\",\n      \"keyEvents\": [\"乡试放榜\", \"夺得解元\", \"百姓夹道欢迎\"],\n      \"characters\": [\"苏云策\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"赵家吐血，世家恐慌\",\n      \"summary\": \"赵家得知苏云策中了解元，气得赵太爷吐血。各大世家开始恐慌，担心这个寒门疯子真的会进入朝廷中枢。\",\n      \"keyEvents\": [\"赵太爷吐血\", \"世家感到恐慌\", \"担心苏云策进入中枢\"],\n      \"characters\": [\"赵太爷\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"鹿鸣宴，新王登基？\",\n      \"summary\": \"乡试鹿鸣宴上，苏云策作为新科解元致辞。他没有说套话，而是发表了一篇关于“大梁向何处去”的演讲，言辞犀利，直指时弊。\",\n      \"keyEvents\": [\"鹿鸣宴致辞\", \"发表时弊演讲\", \"言"
}
