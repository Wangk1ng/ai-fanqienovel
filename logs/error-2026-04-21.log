  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：废土上的奇迹\",\n      \"chapterRange\": \"第1-20章\",\n      \"summary\": \"林渊穿越至辐射超标的贫民窟，觉醒随身农场。在饥饿中种下第一株古地球植物，被黑客皮普发现并意外开启直播。真实食物的香气震惊全网，引来财阀赫利俄斯的注意与打压，同时结识了老兵老铁和医生索菲亚。\",\n      \"plotPoints\": [\"觉醒农场与第一株植物\", \"意外开启直播引发轰动\", \"财阀初期的打压与试探\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：香气引爆星际\",\n      \"chapterRange\": \"第21-40章\",\n      \"summary\": \"林渊培育出古茶树，通过直播打脸嘲笑的贵族，引发全星际抢购热潮。黑粉质疑时，他展现惊人植物学知识。财阀派遣杀手薇拉与改造人奥米伽暗杀，林渊利用农场防御反击，并成功策反薇拉。\",\n      \"plotPoints\": [\"古茶树打脸贵族\", \"植物学博士身份掉落\", \"策反杀手薇拉\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：伊甸星的绿色革命\",\n      \"chapterRange\": \"第41-60章\",\n      \"summary\": \"为躲避财阀追杀并扩大种植，林渊买下废弃星球伊甸-4。在索菲亚和薇拉的帮助下，利用农场净化能力改造星球环境。财阀试图封锁物资，林渊通过直播建立独立生态圈，解决辐射病问题，彻底打破垄断。\",\n      \"plotPoints\": [\"买下废弃星球\", \"净化辐射环境\", \"解决粮食危机\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：生态与机械的决战\",\n      \"chapterRange\": \"第61-80章\",\n      \"summary\": \"赫利俄斯孤注一掷，派遣舰队轰炸伊甸-4。林渊觉醒植物防御系统，击退进攻。情报贩子K提供关键情报，林渊联合反抗军反击。随着绿色生态圈的扩张，全星际粮食危机得到缓解，财阀统治动摇。\",\n      \"plotPoints\": [\"击退财阀舰队\", \"情报贩子K倒戈\", \"全星际粮食危机缓解\"]\n    },\n    {\n      \"actNumber\": 5,\n      \"actName\": \"第五幕：星际救世主\",\n      \"chapterRange\": \"第81-100章\",\n      \"summary\": \"林渊率众攻入永生科技总部，揭露赫利俄斯将人类视为电池的阴谋。最终击败赫利俄斯，将古地球植物种子撒向全宇宙。星际迎来绿色复兴，林渊拒绝成为领袖，回归田园生活，成为传说中的星际救世主。\",\n      \"plotPoints\": [\"攻入永生科技\", \"击败赫利俄斯\", \"绿色复兴与回归\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"垃圾场的苏醒\",\n      \"summary\": \"林渊在充满辐射的贫民窟垃圾场醒来，融合了禁忌的“创世纪”核心，觉醒随身净化农场空间，面临饥饿威胁。\",\n      \"keyEvents\": [\"穿越垃圾场\", \"觉醒随身农场\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"第一颗古地球种子\",\n      \"summary\": \"在农场空间中，林渊利用净化能力种下第一颗古地球土豆种子，期待奇迹的发生，同时躲避巡逻无人机。\",\n      \"keyEvents\": [\"种下土豆\", \"躲避巡逻\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"亚空间的丰收\",\n      \"summary\": \"土豆在农场空间内极速成熟，散发着诱人的香气。林渊将其带回现实，这股香气引来了在附近翻找电子废料的黑客皮普。\",\n      \"keyEvents\": [\"土豆成熟\", \"引来了皮普\"],\n      \"characters\": [\"林渊\", \"皮普\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"这不是合成蛋白！\",\n      \"summary\": \"皮普误以为林渊偷了高级营养剂，林渊分给他一块烤土豆。皮普被从未体验过的美味震撼，惊呼这是传说中的真食物。\",\n      \"keyEvents\": [\"分食土豆\", \"确认真食物\"],\n      \"characters\": [\"林渊\", \"皮普\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"意外的直播\",\n      \"summary\": \"皮普为了炫耀，擅自开启了林渊的旧式终端进行全息直播。直播间瞬间涌入几个看热闹的底层网民，嘲笑这是塑料。\",\n      \"keyEvents\": [\"擅自开启直播\", \"网民嘲笑\"],\n      \"characters\": [\"林渊\", \"皮普\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"香气穿透屏幕\",\n      \"summary\": \"虽然全息影像无法传输气味，但林渊吃土豆时满足的神情和滋滋冒油的声音，让全星际观众感到饥饿和怀疑。\",\n      \"keyEvents\": [\"直播画面冲击\", \"观众感到饥饿\"],\n      \"characters\": [\"林渊\", \"皮普\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"财阀的注视\",\n      \"summary\": \"直播数据异常，被永生科技的监控系统捕捉。赫利俄斯看到画面，认为是底层人的拙劣CGI表演，下令关注。\",\n      \"keyEvents\": [\"被系统捕捉\", \"赫利俄斯注视\"],\n      \"characters\": [\"赫利俄斯\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"暴躁邻居老铁\",\n      \"summary\": \"烤土豆的香气飘到了隔壁的地下诊所。退役特种兵老铁破门而入，以为是有人在使用违禁香料，却看到了真实的植物。\",\n      \"keyEvents\": [\"老铁闯入\", \"发现真实植物\"],\n      \"characters\": [\"林渊\", \"老铁\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"食物换保护\",\n      \"summary\": \"老铁认出这是古地球植物，震惊之余提出用武力保护林渊，换取食物供应。林渊同意，初步建立安全据点。\",\n      \"keyEvents\": [\"达成协议\", \"建立据点\"],\n      \"characters\": [\"林渊\", \"老铁\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"种下一株茶树\",\n      \"summary\": \"直播间热度稍降，林渊决定种植更有价值的古茶树。他将一株枯萎的茶树苗移入农场空间，开始净化培育。\",\n      \"keyEvents\": [\"种植茶树\", \"培育开始\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"医生的发现\",\n      \"summary\": \"反抗军医生索菲亚无意间进入直播间，通过分析林渊手部的皮肤状态，推测他接触了高能净化物质，对他产生了兴趣。\",\n      \"keyEvents\": [\"索菲亚发现\", \"分析净化物质\"],\n      \"characters\": [\"索菲亚\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"神秘的联络\",\n      \"summary\": \"索菲亚通过加密频道联系林渊，希望能合作研究植物对辐射病的缓解作用。林渊尝试用茶叶水进行远程测试。\",\n      \"keyEvents\": [\"索菲亚联络\", \"远程测试\"],\n      \"characters\": [\"林渊\", \"索菲亚\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"第一次危机\",\n      \"summary\": \"赫利俄斯派出的当地混混试图强占林渊的住处。老铁虽然勇猛，但对方人数众多且持有武器，局势危急。\",\n      \"keyEvents\": [\"混混强占\", \"局势危急\"],\n      \"characters\": [\"林渊\", \"老铁\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"农场初显威\",\n      \"summary\": \"林渊利用农场空间外的藤蔓植物进行防御，藤蔓如同活物般击退混混。这一幕被直播完整记录，全网哗然。\",\n      \"keyEvents\": [\"藤蔓防御\", \"直播记录\"],\n      \"characters\": [\"林渊\", \"老铁\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"情绪值系统\",\n      \"summary\": \"直播间观众的震惊和恐惧转化为大量情绪值。林渊发现这些能量可以兑换“超级生长液”，农场升级。\",\n      \"keyEvents\": [\"收集情绪值\", \"农场升级\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"茶树发芽\",\n      \"summary\": \"在生长液的催化下，茶树抽出嫩绿的新芽。直播间那抹绿色在灰暗的废土背景下显得无比神圣，观众人数激增。\",\n      \"keyEvents\": [\"茶树发芽\", \"人数激增\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"赫利俄斯的杀意\",\n      \"summary\": \"赫利俄斯意识到林渊手中的植物可能威胁到营养液垄断，决定不再观望，派遣养女薇拉前去抹杀或收编。\",\n      \"keyEvents\": [ \"赫利俄斯决定抹杀\", \"派遣薇拉\"],\n      \"characters\": [\"赫利俄斯\", \"薇拉\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"杀手的潜入\",\n      \"summary\": \"薇拉伪装成难民接近林渊的住处。她冷静观察，发现林渊虽然警惕，但对植物毫无防备，是个完美的机会。\",\n      \"keyEvents\": [\"薇拉伪装\", \"寻找机会\"],\n      \"characters\": [\"薇拉\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"那一抹茶香\",\n      \"summary\": \"林渊采摘第一批茶叶，开始炒制。独特的茶香溢出屏幕，薇拉闻到这股熟悉又陌生的味道，记忆产生了一丝波动。\",\n      \"keyEvents\": [\"炒制茶叶\", \"薇拉动摇\"],\n      \"characters\": [\"林渊\", \"薇拉\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"贵族的嘲讽\",\n      \"summary\": \"直播间混入贵族，嘲讽林渊喝的是“刷锅水”。林渊不为所动，邀请全星际共同见证第一泡茶的诞生。\",\n      \"keyEvents\": [\"贵族嘲讽\", \"邀请见证\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"茶汤琥珀\",\n      \"summary\": \"开水冲泡，茶叶舒展，茶汤变为琥珀色。林渊轻抿一口，表情陶醉。直播间弹幕瞬间爆炸，质疑声与渴望声交织。\",\n      \"keyEvents\": [\"冲泡成功\", \"全网沸腾\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"打脸时刻\",\n      \"summary\": \"皮普黑入了贵族晚宴的屏幕，将林渊喝茶的画面投射在穹顶之上。贵族们看着那清澈的液体，感到了莫名的羞愧。\",\n      \"keyEvents\": [\"画面投射\", \"贵族羞愧\"],\n      \"characters\": [\"皮普\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"薇拉的抉择\",\n      \"summary\": \"薇拉想起童年时赫利俄斯曾给她看过古地球茶叶的图片。她意识到林渊是真实的希望，暂时放弃了刺杀任务。\",\n      \"keyEvents\": [\"回忆过去\", \"放弃刺杀\"],\n      \"characters\": [\"薇拉\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"黑粉的狂欢\",\n      \"summary\": \"赫利俄斯雇佣水军攻击林渊，称他是使用全息投影的骗子，植物是假的。舆论开始出现两极分化。\",\n      \"keyEvents\": [\"水军攻击\", \"舆论分化\"],\n      \"characters\": [\"赫利俄斯\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"博士的马甲\",\n      \"summary\": \"面对质疑，林渊在直播中开始讲解古地球植物学知识，专业术语信手拈来，并现场解剖植物结构，震惊学术界。\",\n      \"keyEvents\": [\"讲解植物学\", \"震惊学术界\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"索菲亚的背书\",\n      \"summary\": \"索菲亚公开站队，发布医疗报告证明林渊提供的植物叶片确实含有能修复辐射损伤的成分，黑粉不攻自破。\",\n      \"keyEvents\": [\"索菲亚站队\", \"医疗报告\"],\n      \"characters\": [\"索菲亚\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"赫利俄斯的暴怒\",\n      \"summary\": \"舆论反转，赫利俄斯震怒。他决定动用武力，派遣改造人奥米伽带队，直接摧毁贫民窟据点，抢夺核心。\",\n      \"keyEvents\": [\"赫利俄斯暴怒\", \"决定动武\"],\n      \"characters\": [\"赫利俄斯\", \"奥米伽\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"奥米伽降临\",\n      \"summary\": \"巨大的阴影笼罩贫民窟，改造人奥米伽手持高能光剑破门。老铁挺身而出，却被奥米伽轻松击飞，重伤倒地。\",\n      \"keyEvents\": [\"奥米伽攻击\", \"老铁重伤\"],\n      \"characters\": [\"奥米伽\", \"老铁\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"荆棘防御\",\n      \"summary\": \"林渊激活农场防御机制，无数钢铁般的荆棘从地下涌出，缠绕住奥米伽。虽然无法击杀，但暂时困住了怪物。\",\n      \"keyEvents\": [\"激活防御\", \"困住奥米伽\"],\n      \"characters\": [\"林渊\", \"奥米伽\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"薇拉的背叛\",\n      \"summary\": \"关键时刻，薇拉倒戈，利用她对赫利俄斯基地的了解，攻击奥米伽的感应器弱点，迫使奥米伽撤退。\",\n      \"keyEvents\": [\"薇拉倒戈\", \"奥米伽撤退\"],\n      \"characters\": [\"薇拉\", \"奥米伽\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"情报贩子K\",\n      \"summary\": \"神秘的情报贩子K主动联系林渊，表示愿意提供赫利俄斯的下一步计划，代价是一株活体古植物样本。\",\n      \"keyEvents\": [\"K主动联系\", \"交易情报\"],\n      \"characters\": [\"K\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"必须离开\",\n      \"summary\": \"K透露赫利俄斯将发动轨道轰炸。贫民窟已不再安全。林渊决定寻找一个新的基地，一个属于他自己的星球。\",\n      \"keyEvents\": [\"得知轰炸计划\", \"决定离开\"],\n      \"characters\": [\"K\", \"林渊\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"废弃星球伊甸-4\",\n      \"summary\": \"在K的指引下，林渊看中了被判定为死亡星球的伊甸-4。那里辐射极强，但农场核心正是完美的净化器。\",\n      \"keyEvents\": [\"寻找新基地\", \"锁定伊甸-4\"],\n      \"characters\": [\"林渊\", \"K\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"全星际众筹\",\n      \"summary\": \"购买星球需要巨额资金。林渊开启预售，利用直播间观众的情绪值和捐款，加上皮普的黑客技术，凑齐了首付。\",\n      \"keyEvents\": [\"开启众筹\", \"凑齐首付\"],\n      \"characters\": [\"林渊\", \"皮普\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"逃离下城区\",\n      \"summary\": \"在赫利俄斯舰队抵达前一刻，林渊一行人乘坐老铁搞来的旧飞船，在千钧一发之际冲出了贫民窟的大气层。\",\n      \"keyEvents\": [\"舰队抵达\", \"成功逃离\"],\n      \"characters\": [\"林渊\", \"老铁\", \"薇拉\", \"皮普\"]\n    },\n    {\n      \"chapterNumber\": 36,\n      \"title\": \"抵达伊甸-4\",\n      \"summary\": \"飞船降落在荒凉的红褐色地表。这里寸草不生，辐射值爆表。薇拉和老铁都怀疑这里能否生存。\",\n      \"keyEvents\": [\"抵达荒星\", \"环境恶劣\"],\n      \"characters\": [\"林渊\", \"薇拉\", \"老铁\"]\n    },\n    {\n      \"chapterNumber\": 37,\n      \"title\": \"净化之光\",\n      \"summary\": \"林渊走出飞船，将随身农场核心植入地下。一道绿光以他为中心爆发，迅速扩散，红土瞬间转化为黑土。\",\n      \"keyEvents\": [\"植入核心\", \"净化土地\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 38,\n      \"title\": \"第一座生态穹顶\",\n      \"summary\": \"利用农场能量，林渊制造了一个透明的生态穹顶。在穹顶内，他种下了第一批小麦和水稻，绿意盎然。\",\n      \"keyEvents\": [\"制造穹顶\", \"种植作物\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 39,\n      \"title\": \"直播新家园\",\n      \"summary\": \"直播恢复，全星际看到林渊在死亡星球上创造出的绿色奇迹。希望之火在绝望的平民心中点燃。\",\n      \"keyEvents\": [\"恢复直播\", \"点燃希望\"],\n      \"characters\": [\"林渊\"]\n    },\n    {\n      \"chapterNumber\": 40,\n      \"title\": \"赫利俄斯的封锁\",\n      \"summary\": \"赫利俄斯宣布伊甸-4为非法区域，禁止任何飞船靠近，试图将林渊困死在荒星上。\",\n      \"keyEvents\": [\"宣布非法\", \"封锁禁令\"],\n      \"characters\": [\"赫利俄斯\"]\n    },\n    {\n      \"chapterNumber\": 41,\n      \"title\": \"自给自足\",\n      \"summary\": \""
}
