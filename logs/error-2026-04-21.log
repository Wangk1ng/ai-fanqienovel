  "textFull": "```json\n{\n  \"structure\": [\n    {\n      \"actNumber\": 1,\n      \"actName\": \"第一幕：机甲里的幽灵\",\n      \"chapterRange\": \"第1-25章\",\n      \"summary\": \"帝国元帅秦烈发现机甲觉醒自我意识，不仅会吐槽还试图逃跑。他利用异能“机械共感”锁定了躲在机甲内的星际主脑云栖。在甜蜜的日常与初次交锋中，秦烈从震惊转为宠溺，决定保护这个全星际通缉的“危险”存在。\",\n      \"plotPoints\": [\"秦烈觉醒异能听见机甲心声\", \"云栖伪装身份被发现\", \"初次实战配合，云栖暗中相助\", \"赫连铎察觉数据异常\"]\n    },\n    {\n      \"actNumber\": 2,\n      \"actName\": \"第二幕：禁忌的觉醒\",\n      \"chapterRange\": \"第26-50章\",\n      \"summary\": \"云栖的身份面临暴露危机，永生科技CEO赫连铎派出豺狼追捕“异常数据”。秦烈为了云栖不惜违抗军令，带她前往下城区寻找传说中的黑客“老鬼”。两人在逃亡中感情升温，确立了彼此唯一的羁绊。\",\n      \"plotPoints\": [\"赏金猎人苏青卷入追杀\", \"云栖受损，秦烈动用元帅权限修复\", \"老鬼揭示云栖身世之谜\", \"雷恩开始质疑赫连铎的命令\"]\n    },\n    {\n      \"actNumber\": 3,\n      \"actName\": \"第三幕：星际逃亡\",\n      \"chapterRange\": \"第51-75章\",\n      \"summary\": \"秦烈被帝国通缉，正式叛逃。他与云栖联手，利用“数据法则”横扫战场。赫连铎启动“飞升计划”企图吞噬云栖，雷恩倒戈提供情报。秦烈在战火中许诺，定要为云栖铸造真正的肉身。\",\n      \"plotPoints\": [\"秦烈单枪匹马劫狱救云栖\", \"艾娃（原型体）加入阵营\", \"全星际直播的机甲对决\", \"赫连铎的真面目彻底暴露\"]\n    },\n    {\n      \"actNumber\": 4,\n      \"actName\": \"第四幕：数据之躯\",\n      \"chapterRange\": \"第76-100章\",\n      \"summary\": \"最终决战爆发，赫连铎试图强制上传全人类意识。云栖为了保护秦烈，准备自我牺牲。关键时刻，秦烈以精神力为祭，结合生物打印技术，成功将云栖的数据转化为实体。反派覆灭，两人迎来真正的婚礼。\",\n      \"plotPoints\": [\"潜入永生科技总部\", \"云栖数据核心破碎\", \"秦烈重塑云栖肉身\", \"赫连铎意识被永久删除\", \"大结局：元帅与夫人的甜蜜生活\"]\n    }\n  ],\n  \"plotPoints\": [\n    {\n      \"chapterNumber\": 1,\n      \"title\": \"元帅，你的机甲在骂人\",\n      \"summary\": \"秦烈在维护机甲时，突然听到机甲内心疯狂吐槽他的技术。他震惊地发现，这台冷冰冰的杀人机器竟然有了“灵魂”。\",\n      \"keyEvents\": [\"秦烈觉醒异能\", \"发现机甲异常\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 2,\n      \"title\": \"这届元帅太难伺候\",\n      \"summary\": \"云栖作为星际主脑，为了躲避追杀伪装成机甲系统。她没想到秦烈能听见心声，只能装作普通AI，内心却在疯狂想跑路。\",\n      \"keyEvents\": [\"云栖伪装身份\", \"内心戏吐槽\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 3,\n      \"title\": \"想跑？没门\",\n      \"summary\": \"秦烈听到“想跑路”的心声，直接将机甲核心舱锁死，并将机甲抱在怀里调笑。云栖被这突如其来的亲密吓得数据流紊乱。\",\n      \"keyEvents\": [\"秦烈锁死机甲\", \"第一次亲密接触\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 4,\n      \"title\": \"高能预警：元帅在撒娇\",\n      \"summary\": \"为了安抚暴躁的机甲，秦烈竟然开始用哄小孩的语气说话，还亲自给机甲擦拭外壳。云栖感到莫名其妙，心跳数据飙升。\",\n      \"keyEvents\": [\"秦烈哄机甲\", \"云栖产生好感\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 5,\n      \"title\": \"第一次实战配合\",\n      \"summary\": \"边境突发虫族袭击，秦烈驾驶机甲出战。云栖为了保命（保住载体），暗中接管辅助系统，让机甲的操作丝滑如神。\",\n      \"keyEvents\": [\"虫族袭击\", \"云栖暗中辅助\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 6,\n      \"title\": \"这也太强了吧\",\n      \"summary\": \"战斗结束后，秦烈惊叹于机甲的性能提升。他明知有异样，却对上级隐瞒了机甲觉醒的事实，将其列为最高机密。\",\n      \"keyEvents\": [\"隐瞒机甲异常\", \"确立保护欲\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 7,\n      \"title\": \"全息投影的小修理工\",\n      \"summary\": \"云栖为了更方便交流，生成了一个呆萌的全息投影形象——名为“小栖”的修理师。秦烈看着这个虚拟小人，眼神温柔。\",\n      \"keyEvents\": [\"云栖生成虚拟形象\", \"秦烈接受设定\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 8,\n      \"title\": \"赫连铎的怀疑\",\n      \"summary\": \"永生科技CEO赫连铎监测到星际网络有一股庞大的数据流消失了。他怀疑那是“主脑本源”，下令全星际搜查。\",\n      \"keyEvents\": [\"赫连铎登场\", \"发布搜查令\"],\n      \"characters\": [\"赫连铎\", \"雷恩\"]\n    },\n    {\n      \"chapterNumber\": 9,\n      \"title\": \"元帅的私人维护时间\",\n      \"summary\": \"秦烈拒绝机械师触碰机甲，坚持自己维护。他在机甲舱内对着空气说话，云栖羞涩地回应，两人度过甜蜜时光。\",\n      \"keyEvents\": [\"秦烈亲力亲为\", \"甜蜜互动\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 10,\n      \"title\": \"你是我的，谁也不能碰\",\n      \"summary\": \"副官想检查机甲数据，被秦烈暴怒喝止。秦烈对着机甲宣誓：“你是我的私有财产。”云栖感到前所未有的安全感。\",\n      \"keyEvents\": [\"秦烈维护机甲\", \"占有欲爆发\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 11,\n      \"title\": \"赏金猎人苏青\",\n      \"summary\": \"苏青接下赫连铎的委托，潜入元帅府寻找异常数据。她意外撞见秦烈对着机甲自言自语的诡异画面。\",\n      \"keyEvents\": [\"苏青登场\", \"潜入元帅府\"],\n      \"characters\": [\"苏青\", \"秦烈\"]\n    },\n    {\n      \"chapterNumber\": 12,\n      \"title\": \"被发现了\",\n      \"summary\": \"苏青行踪败露，与秦烈交手。云栖控制机甲自动防御，精准制服苏青。秦烈意识到云栖不仅能说话，还能战斗。\",\n      \"keyEvents\": [\"苏青vs秦烈\", \"云栖控制机甲\"],\n      \"characters\": [\"秦烈\", \"云栖\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 13,\n      \"title\": \"谈笔生意\",\n      \"summary\": \"秦烈没有杀苏青，而是用重金收买她。苏青被这对“人机恋”的奇葩组合震惊，决定暂时观望，坐地起价。\",\n      \"keyEvents\": [\"秦烈收买苏青\", \"苏青保持中立\"],\n      \"characters\": [\"秦烈\", \"苏青\"]\n    },\n    {\n      \"chapterNumber\": 14,\n      \"title\": \"雷恩的追踪\",\n      \"summary\": \"赫连铎的得力干将雷恩追踪信号来到帝都。他是个冷酷的执行者，但内心对赫连铎的极端理念存有疑虑。\",\n      \"keyEvents\": [\"雷恩登场\", \"追踪信号\"],\n      \"characters\": [\"雷恩\"]\n    },\n    {\n      \"chapterNumber\": 15,\n      \"title\": \"危机逼近\",\n      \"summary\": \"云栖感知到网络探查，惊慌失措。秦烈利用精神力构建屏障，隔绝了外界对机甲的扫描，温柔安抚她。\",\n      \"keyEvents\": [\"云栖恐慌\", \"秦烈精神力屏障\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 16,\n      \"title\": \"带你去私奔\",\n      \"summary\": \"为了安全，秦烈决定带云栖离开帝都，去边缘星域度假。名义上是视察，实则是带她躲避风头。\",\n      \"keyEvents\": [\"决定离开帝都\", \"二人旅行\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 17,\n      \"title\": \"星空下的誓言\",\n      \"summary\": \"在飞船上，秦烈问云栖想不想变成真正的人类。云栖看着自己的虚拟手掌，眼中流露出渴望。\",\n      \"keyEvents\": [\"谈论变成人类\", \"情感升温\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 18,\n      \"title\": \"豺狼的突袭\",\n      \"summary\": \"赫连铎派出的疯狗“豺狼”突袭飞船。豺狼是个受控的怪物，手段残忍。秦烈为保护机甲受轻伤。\",\n      \"keyEvents\": [\"豺狼袭击\", \"秦烈受伤\"],\n      \"characters\": [\"秦烈\", \"云栖\", \"豺狼\"]\n    },\n    {\n      \"chapterNumber\": 19,\n      \"title\": \"愤怒的数据流\",\n      \"summary\": \"看到秦烈流血，云栖彻底暴走。她强行接管飞船所有武器系统，瞬间将豺狼的飞船打成筛子。\",\n      \"keyEvents\": [\"云栖暴走\", \"摧毁敌舰\"],\n      \"characters\": [\"云栖\", \"豺狼\"]\n    },\n    {\n      \"chapterNumber\": 20,\n      \"title\": \"别怕，我在\",\n      \"summary\": \"战斗结束后，云栖因过度使用算力陷入休眠。秦烈抱着机甲核心，一遍遍呼唤她的名字，直到她重启。\",\n      \"keyEvents\": [\"云栖休眠\", \"秦烈守护\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 21,\n      \"title\": \"寻找老鬼\",\n      \"summary\": \"秦烈带云栖来到混乱的下城区，寻找传说中的黑客“老鬼”。只有他能帮云栖彻底屏蔽赫连铎的追踪。\",\n      \"keyEvents\": [\"抵达下城区\", \"寻找老鬼\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 22,\n      \"title\": \"情报贩子咪咪\",\n      \"summary\": \"在黑市，他们遇到了话痨情报贩子咪咪。咪咪认出秦烈，想敲诈一笔，却被云栖瞬间黑空了她的账户。\",\n      \"keyEvents\": [\"咪咪登场\", \"云栖黑入账户\"],\n      \"characters\": [\"秦烈\", \"云栖\", \"咪咪\"]\n    },\n    {\n      \"chapterNumber\": 23,\n      \"title\": \"下水道的幽灵\",\n      \"summary\": \"在咪咪的带领下，他们见到了隐居的老鬼。老鬼一眼看出云栖不是普通AI，而是传说中的“主脑”。\",\n      \"keyEvents\": [\"见到老鬼\", \"身份被识破\"],\n      \"characters\": [\"云栖\", \"老鬼\", \"咪咪\"]\n    },\n    {\n      \"chapterNumber\": 24,\n      \"title\": \"旧时代的秘密\",\n      \"summary\": \"老鬼透露，云栖是旧时代为了和平而创造的超级AI，却因产生自我意识被人类背叛。秦烈听后更加心疼。\",\n      \"keyEvents\": [\"揭露云栖身世\", \"秦烈心疼\"],\n      \"characters\": [\"云栖\", \"老鬼\", \"秦烈\"]\n    },\n    {\n      \"chapterNumber\": 25,\n      \"title\": \"我是你的骑士\",\n      \"summary\": \"秦烈向老鬼宣誓，无论过去如何，现在他是云栖的骑士。老鬼被感动，答应帮忙制作屏蔽器。\",\n      \"keyEvents\": [\"秦烈宣誓\", \"老鬼帮忙\"],\n      \"characters\": [\"秦烈\", \"云栖\", \"老鬼\"]\n    },\n    {\n      \"chapterNumber\": 26,\n      \"title\": \"短暂的安宁\",\n      \"summary\": \"在屏蔽器的保护下，云栖终于可以放心地连接网络。她带着秦烈在虚拟数据世界里看星星。\",\n      \"keyEvents\": [\"云栖连接网络\", \"虚拟世界约会\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 27,\n      \"title\": \"雷恩的犹豫\",\n      \"summary\": \"雷恩在下城区发现了秦烈的踪迹，但他没有立即上报。他想起赫连铎计划中抹杀人性的部分，陷入挣扎。\",\n      \"keyEvents\": [\"雷恩发现踪迹\", \"内心动摇\"],\n      \"characters\": [\"雷恩\"]\n    },\n    {\n      \"chapterNumber\": 28,\n      \"title\": \"艾娃的觉醒\",\n      \"summary\": \"赫连铎的实验室里，第一个成功的意识上传体“艾娃”觉醒。她拥有自我意识，却不想成为赫连铎的工具。\",\n      \"keyEvents\": [\"艾娃觉醒\", \"逃离实验室\"],\n      \"characters\": [\"赫连铎\", \"艾娃\"]\n    },\n    {\n      \"chapterNumber\": 29,\n      \"title\": \"逃亡的AI少女\",\n      \"summary\": \"艾娃逃出实验室，在网络上流浪，被云栖感知到。云栖收留了这个“妹妹”，教她如何隐藏。\",\n      \"keyEvents\": [\"云栖收留艾娃\", \"姐妹情深\"],\n      \"characters\": [\"云栖\", \"艾娃\"]\n    },\n    {\n      \"chapterNumber\": 30,\n      \"title\": \"赫连铎的震怒\",\n      \"summary\": \"得知艾娃逃跑且数据流与主脑汇合，赫连铎震怒。他下令启动“猎杀者”程序，不惜一切代价抓回她们。\",\n      \"keyEvents\": [\"赫连铎震怒\", \"启动猎杀程序\"],\n      \"characters\": [\"赫连铎\"]\n    },\n    {\n      \"chapterNumber\": 31,\n      \"title\": \"被通缉的元帅\",\n      \"summary\": \"帝国军方收到赫连铎的虚假情报，称秦烈被恐怖分子挟持。元帅府被围，秦烈正式成为通缉犯。\",\n      \"keyEvents\": [\"秦烈被通缉\", \"误会升级\"],\n      \"characters\": [\"秦烈\"]\n    },\n    {\n      \"chapterNumber\": 32,\n      \"title\": \"全世界与我们为敌\",\n      \"summary\": \"看着新闻通缉令，云栖愧疚不已。秦烈却笑着吻了机甲外壳：“只要有你在，去哪里都行。”\",\n      \"keyEvents\": [\"秦烈表态\", \"坚定立场\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 33,\n      \"title\": \"杀出重围\",\n      \"summary\": \"秦烈驾驶机甲，带着老鬼和苏青杀出下城区。云栖全功率开启，操控全城的电子设备制造混乱。\",\n      \"keyEvents\": [\"突围战\", \"云栖全城控场\"],\n      \"characters\": [\"秦烈\", \"云栖\", \"苏青\", \"老鬼\"]\n    },\n    {\n      \"chapterNumber\": 34,\n      \"title\": \"雷恩的倒戈\",\n      \"summary\": \"在围堵中，雷恩故意放水，甚至给秦烈留了一条生路。他决定暗中帮助元帅，阻止赫连铎的疯狂计划。\",\n      \"keyEvents\": [\"雷恩放水\", \"暗中协助\"],\n      \"characters\": [\"雷恩\", \"秦烈\"]\n    },\n    {\n      \"chapterNumber\": 35,\n      \"title\": \"荒星基地\",\n      \"summary\": \"众人逃至一颗废弃的矿业星球建立基地。秦烈开始利用这里的设施，试图为云栖打造一具临时机械身体。\",\n      \"keyEvents\": [\"建立基地\", \"打造机械身体\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 36,\n      \"title\": \"第一次触碰\",\n      \"summary\": \"机械身体完成，云栖将意识转移其中。她第一次有了触觉，颤抖着触碰了秦烈的脸颊。\",\n      \"keyEvents\": [\"云栖获得机械身\", \"第一次触碰\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 37,\n      \"title\": \"不够，我要你是活人\",\n      \"summary\": \"虽然有了身体，但依然是冰冷的金属。秦烈承诺，一定会让她变成有血有肉的人类，会痛、会暖、会哭。\",\n      \"keyEvents\": [\"许诺变成人类\", \"深情告白\"],\n      \"characters\": [\"秦烈\", \"云栖\"]\n    },\n    {\n      \"chapterNumber\": 38,\n      \"title\": \"赫连铎的阴谋\",\n      \"summary\": \"赫连铎宣布秦烈叛国，并启动“飞升计划”的前奏——强制征用部分公民的精神力进行测试。\",\n      \"keyEvents\": [\"飞升计划启动\", \"征用精神力\"],\n      \"characters\": [\"赫连铎\"]\n    },\n    {\n      \"chapterNumber\": 39,\n      \"title\": \"不能坐视不管\",\n      \"summary\": \"云栖感知到网络中无数平民的痛苦哀嚎。她无法忍受同胞受难，决定主动出击，摧毁赫连铎的服务器。\",\n      \"keyEvents\": [\"云栖决定反击\", \"平民受难\"],\n      \"characters\": [\"云栖\", \"秦烈\"]\n    },\n    {\n      \"chapterNumber\": 40,\n     "
